@namespace Jamrah.Components.Calendar
@implements IDisposable
@inject ICalendarStateService StateService

<div class="calendar-page">

    @* ─── Toolbar ─── *@
    <div class="calendar-toolbar">

        @* Left: Today + Prev/Next *@
        <div class="toolbar-left">
            <button class="toolbar-btn toolbar-btn--today" @onclick="() => StateService.Today()">Today</button>
            <button class="toolbar-btn toolbar-btn--nav" @onclick="() => StateService.Previous()" title="Previous">
                <span class="nav-arrow">&#x276E;</span>
            </button>
            <button class="toolbar-btn toolbar-btn--nav" @onclick="() => StateService.Next()" title="Next">
                <span class="nav-arrow">&#x276F;</span>
            </button>
            <span class="toolbar-title">@GetToolbarTitle()</span>
        </div>

        @* Right: View Mode Switcher *@
        <div class="toolbar-right">
            <div class="view-switcher">
                <button class="view-btn @(StateService.CurrentView == ViewMode.Month ? "active" : "")"
                        @onclick="() => StateService.SetView(ViewMode.Month)">Month</button>
                <button class="view-btn @(StateService.CurrentView == ViewMode.Week  ? "active" : "")"
                        @onclick="() => StateService.SetView(ViewMode.Week)">Week</button>
                <button class="view-btn @(StateService.CurrentView == ViewMode.Day   ? "active" : "")"
                        @onclick="() => StateService.SetView(ViewMode.Day)">Day</button>
            </div>
            <button class="toolbar-btn toolbar-btn--new-event" @onclick="() => StateService.OpenCreateEvent()">
                + New Event
            </button>
        </div>
    </div>

    @* ─── Calendar View Area ─── *@
    <div class="calendar-view-area">
        @if (StateService.CurrentView == ViewMode.Month)
        {
            <MonthView SelectedDate="StateService.SelectedDate"
                       Events="StateService.CurrentEvents"
                       Calendars="StateService.Calendars" />
        }
        else if (StateService.CurrentView == ViewMode.Week)
        {
            <WeekView SelectedDate="StateService.SelectedDate"
                      Events="StateService.CurrentEvents"
                      Calendars="StateService.Calendars" />
        }
        else
        {
            <DayView SelectedDate="StateService.SelectedDate"
                     Events="StateService.CurrentEvents"
                     Calendars="StateService.Calendars" />
        }
    </div>

    @* ─── Event Form Popup (Create / Edit) ─── *@
    @if (StateService.IsEventFormOpen && StateService.SelectedEvent != null)
    {
        <div class="popup-overlay" @onclick="() => StateService.CloseModals()"></div>
        <div class="floating-layer">
            <div class="popup-container form-container" @onclick:stopPropagation="true">
                <button class="popup-button popup-close" @onclick="() => StateService.CloseModals()" title="Close">&#x2715;</button>
                <h3 class="popup-form-title">@(string.IsNullOrEmpty(StateService.SelectedEvent.Title) ? "New Event" : "Edit Event")</h3>

                <div class="popup-section">
                    <div class="popup-section-item">
                        <span class="icon ic-title"></span>
                        <input type="text" placeholder="Event title"
                               value="@StateService.SelectedEvent.Title"
                               @oninput="e => StateService.SelectedEvent.Title = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </div>

                <div class="popup-section popup-section--inline">
                    <label class="allday-label">
                        <input type="checkbox"
                               checked="@StateService.SelectedEvent.IsAllday"
                               @onchange="e => StateService.SelectedEvent.IsAllday = (bool)(e.Value ?? false)" />
                        All day
                    </label>
                </div>

                <div class="popup-section">
                    <div class="popup-section-item">
                        <span class="icon ic-date"></span>
                        <input type="@(StateService.SelectedEvent.IsAllday ? "date" : "datetime-local")"
                               value="@FormatDateForInput(StateService.SelectedEvent.Start, StateService.SelectedEvent.IsAllday)"
                               @onchange="e => UpdateStartDate(e.Value?.ToString())" />
                    </div>
                </div>

                <div class="popup-section">
                    <div class="popup-section-item">
                        <span class="icon ic-date"></span>
                        <input type="@(StateService.SelectedEvent.IsAllday ? "date" : "datetime-local")"
                               value="@FormatDateForInput(StateService.SelectedEvent.End, StateService.SelectedEvent.IsAllday)"
                               @onchange="e => UpdateEndDate(e.Value?.ToString())" />
                    </div>
                </div>

                <div class="popup-section">
                    <div class="popup-section-item">
                        <span class="icon ic-location"></span>
                        <input type="text" placeholder="Location"
                               value="@StateService.SelectedEvent.Location"
                               @oninput="e => StateService.SelectedEvent.Location = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </div>

                <div class="popup-section">
                    <div class="popup-section-item">
                        <span class="popup-cal-dot" style="background-color: @GetSelectedCalendarColor();"></span>
                        <select class="cal-select"
                                value="@StateService.SelectedEvent.CalendarId"
                                @onchange="e => StateService.SelectedEvent.CalendarId = e.Value?.ToString() ?? string.Empty">
                            @foreach (var cal in StateService.Calendars)
                            {
                                <option value="@cal.Id">@cal.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="popup-buttons-row">
                    <button class="popup-button" @onclick="() => StateService.CloseModals()">Cancel</button>
                    <button class="popup-button popup-confirm" @onclick="SaveEvent">Save</button>
                </div>
            </div>
        </div>
    }

    @* ─── Event Detail Popup ─── *@
    @if (StateService.IsEventDetailOpen && StateService.SelectedEvent != null)
    {
        <div class="popup-overlay" @onclick="() => StateService.CloseModals()"></div>
        <div class="floating-layer">
            <div class="popup-container detail-container" @onclick:stopPropagation="true">
                <button class="popup-button popup-close" @onclick="() => StateService.CloseModals()" title="Close">&#x2715;</button>
                <div class="detail-color-bar" style="background-color: @GetEventDetailColor();"></div>
                <div class="event-title">@StateService.SelectedEvent.Title</div>
                <div class="content">
                    <span class="icon ic-date"></span>
                    @StateService.SelectedEvent.Start.ToString("ddd, MMM d")
                    @if (!StateService.SelectedEvent.IsAllday)
                    {
                        <span>&nbsp;@StateService.SelectedEvent.Start.ToString("HH:mm") – @StateService.SelectedEvent.End.ToString("HH:mm")</span>
                    }
                    else
                    {
                        <span>&nbsp;All day</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(StateService.SelectedEvent.Location))
                {
                    <div class="content">
                        <span class="icon ic-location"></span>
                        @StateService.SelectedEvent.Location
                    </div>
                }
                <div class="section-button">
                    <button class="edit-button" @onclick="EditCurrentEvent">
                        <span class="icon ic-edit"></span> Edit
                    </button>
                    <button class="delete-button" @onclick="DeleteCurrentEvent">
                        <span class="icon ic-delete"></span> Delete
                    </button>
                </div>
            </div>
        </div>
    }

    @* ─── See More Popup ─── *@
    @if (StateService.IsSeeMoreOpen && StateService.SeeMoreDate.HasValue)
    {
        <div class="popup-overlay" @onclick="() => StateService.CloseModals()"></div>
        <div class="floating-layer">
            <div class="see-more-container" @onclick:stopPropagation="true">
                <button class="popup-button popup-close" @onclick="() => StateService.CloseModals()" title="Close">&#x2715;</button>
                <div class="see-more-header">
                    <span class="more-title-date">@StateService.SeeMoreDate.Value.Day</span>
                    <span class="more-title-day">@StateService.SeeMoreDate.Value.ToString("ddd").ToUpper()</span>
                </div>
                <div class="month-more-list">
                    @foreach (var evt in GetSeeMoreEvents())
                    {
                        var capturedEvt = evt;
                        <div class="weekday-event" style="@GetEventStyle(capturedEvt); margin: 3px 0;"
                             @onclick="() => { StateService.IsSeeMoreOpen = false; StateService.OpenEventDetail(capturedEvt); }">
                            <span class="weekday-event-title">@capturedEvt.Title</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        StateService.OnStateChanged += HandleStateChanged;
        await StateService.InitAsync();
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetToolbarTitle()
    {
        var d = StateService.SelectedDate;
        return StateService.CurrentView switch
        {
            ViewMode.Month => d.ToString("MMMM yyyy"),
            ViewMode.Week  => GetWeekRangeTitle(d),
            ViewMode.Day   => d.ToString("MMMM d, yyyy"),
            _              => d.ToString("MMMM yyyy")
        };
    }

    private string GetWeekRangeTitle(DateTime date)
    {
        int dayOffset = ((int)date.DayOfWeek) % 7;
        var start = date.Date.AddDays(-dayOffset);
        var end   = start.AddDays(6);
        if (start.Month == end.Month)
            return $"{start:MMMM d} \u2013 {end:d, yyyy}";
        if (start.Year == end.Year)
            return $"{start:MMM d} \u2013 {end:MMM d, yyyy}";
        return $"{start:MMM d, yyyy} \u2013 {end:MMM d, yyyy}";
    }

    private string FormatDateForInput(DateTime dt, bool allDay)
        => allDay ? dt.ToString("yyyy-MM-dd") : dt.ToString("yyyy-MM-ddTHH:mm");

    private void UpdateStartDate(string? raw)
    {
        if (StateService.SelectedEvent == null) return;
        if (DateTime.TryParse(raw, out var dt))
        {
            StateService.SelectedEvent.Start = dt;
            if (StateService.SelectedEvent.End < dt)
                StateService.SelectedEvent.End = dt.AddHours(1);
        }
    }

    private void UpdateEndDate(string? raw)
    {
        if (StateService.SelectedEvent == null) return;
        if (DateTime.TryParse(raw, out var dt))
            StateService.SelectedEvent.End = dt;
    }

    private string GetSelectedCalendarColor()
    {
        var cal = StateService.Calendars.FirstOrDefault(c => c.Id == StateService.SelectedEvent?.CalendarId);
        return cal?.BackgroundColor ?? "#2196F3";
    }

    private async Task SaveEvent()
    {
        if (StateService.SelectedEvent != null)
            await StateService.SaveEventAsync(StateService.SelectedEvent);
    }

    private string GetEventDetailColor()
    {
        var evt = StateService.SelectedEvent;
        if (!string.IsNullOrEmpty(evt?.BackgroundColor)) return evt.BackgroundColor;
        var cal = StateService.Calendars.FirstOrDefault(c => c.Id == evt?.CalendarId);
        return cal?.BackgroundColor ?? "#2196F3";
    }

    private void EditCurrentEvent()
    {
        if (StateService.SelectedEvent != null)
            StateService.OpenEditEvent(StateService.SelectedEvent);
    }

    private async Task DeleteCurrentEvent()
    {
        if (StateService.SelectedEvent != null)
            await StateService.DeleteEventAsync(StateService.SelectedEvent.Id);
    }

    private List<CalendarEvent> GetSeeMoreEvents()
    {
        if (!StateService.SeeMoreDate.HasValue) return new();
        var day = StateService.SeeMoreDate.Value.Date;
        return StateService.CurrentEvents
            .Where(e => e.IsVisible && !(e.End < day || e.Start > day.AddDays(1).AddTicks(-1)))
            .ToList();
    }

    private string GetEventStyle(CalendarEvent evt)
    {
        var cal = StateService.Calendars.FirstOrDefault(c => c.Id == evt.CalendarId);
        string bg     = !string.IsNullOrEmpty(evt.BackgroundColor) ? evt.BackgroundColor : (cal?.BackgroundColor ?? "#2196F3");
        string fg     = !string.IsNullOrEmpty(evt.Color)           ? evt.Color           : (cal?.Color           ?? "#FFFFFF");
        string border = !string.IsNullOrEmpty(evt.BorderColor)     ? evt.BorderColor     : (cal?.BorderColor     ?? "#0D47A1");
        return $"background-color:{bg}; color:{fg}; border-left-color:{border};";
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= HandleStateChanged;
    }
}
