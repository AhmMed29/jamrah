@namespace Jamrah.Components.Pomodoro
@implements IDisposable
@inject Jamrah.Services.PrayerTimesService PrayerService

<div class="app-container" dir="rtl">

    <div class="left-panel">
        <div class="timer-box" @onclick="OnTimerBoxClick">
            <div class="timer-value">@FormatTime(_timer.Remaining)</div>
            <div class="timer-label">Work</div>
        </div>

        <div class="durations">
            @foreach (var m in Durations)
            {
                <button class="dur-btn @(_activeMinutes == m ? "active" : null)" @onclick="() => PromptOrStart(m)">@m</button>
            }
        </div>

        <div class="actions">
            <button class="action-btn" title="Reset" @onclick="ResetTimer">
                <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
            </button>
            <button class="action-btn" title="@(_timer.IsRunning ? "Pause" : "Start")" @onclick="ToggleTimer">
                @if (_timer.IsRunning)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="4" height="16"></rect><rect x="15" y="4" width="4" height="16"></rect></svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                }
            </button>
            <button class="action-btn" title="Complete" @onclick="CompleteCurrentSession">
                <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
        </div>

        <div class="timer-info">
            <div class="info-row"><span>وقت البداية</span><span>@StartTimeText</span></div>
            <div class="info-row"><span>وقت النهاية</span><span>@FinalTimeText</span></div>
            <div class="info-row"><span>المدة</span><span>@DurationText</span></div>
        </div>

        <div class="prayer-section">

            <div class="prayer-countdown">
                <div class="prayer-countdown-label">@_nextPrayerName</div>
                <div class="prayer-countdown-timer">@FormatCountdown(_timeToNextPrayer)</div>
            </div>

            <div class="prayer-title">مواقيت الصلاة</div>
            <table class="prayer-table">
                <thead>
                <tr><th>الصلاة</th><th>الأذان</th></tr>
                </thead>
                <tbody>
                @if (_todayPrayers != null)
                {
                    <tr class="@(_nextPrayerName == "الفجر"  ? "next-prayer" : "")"><td>الفجر</td><td>@To12H(_todayPrayers.Fajr)</td></tr>
                    <tr class="@(_nextPrayerName == "الشروق" ? "next-prayer" : "")"><td>الشروق</td><td>@To12H(_todayPrayers.Sunrise)</td></tr>
                    <tr class="@(_nextPrayerName == "الظهر"  ? "next-prayer" : "")"><td>الظهر</td><td>@To12H(_todayPrayers.Dhuhr)</td></tr>
                    <tr class="@(_nextPrayerName == "العصر"  ? "next-prayer" : "")"><td>العصر</td><td>@To12H(_todayPrayers.Asr)</td></tr>
                    <tr class="@(_nextPrayerName == "المغرب" ? "next-prayer" : "")"><td>المغرب</td><td>@To12H(_todayPrayers.Maghrib)</td></tr>
                    <tr class="@(_nextPrayerName == "العشاء" ? "next-prayer" : "")"><td>العشاء</td><td>@To12H(_todayPrayers.Isha)</td></tr>
                }
                else
                {
                    <tr><td colspan="2" style="text-align:center;">جاري التحميل...</td></tr>
                }
                </tbody>
            </table>

            <button class="dur-btn" style="width:100%; margin-top:8px;" @onclick="OpenLocationModal">
                تغيير المنطقة
            </button>

        </div>
    </div>

    <div class="right-panel">
        <div class="view-modes">
            @foreach (var v in ViewModes)
            {
                <button class="view-btn @(_viewMode == v.Value ? "active" : null)" @onclick="() => SetView(v.Value)">@v.Label</button>
            }
        </div>
        @foreach (var g in _toggles)
        {
            <ToggleGroup @key="g.Id" Group="g" OnSessionClick="OpenSessionDetails" />
        }
    </div>

</div>

<div class="modal-overlay" style="display: @(_modalOpen ? "flex" : "none");">

    @if (_modalMode == ModalMode.Create)
    {
        <div class="modal-group">
            <div class="modal-box tags-modal-box">
                <div class="modal-header"><span class="modal-title">التاجات</span></div>
                <div class="input-group"><input type="text" class="minimal-input" @bind="_tagSearch" placeholder="بحث..." /></div>
                <div class="input-group">
                    <div style="display:flex; gap:8px; align-items:center;">
                        <input type="text" class="minimal-input" @bind="_newTagName" placeholder="إضافة تاج" style="flex:1;" />
                        <input type="color" class="color-input" @bind="_newTagColor" />
                        <button class="modal-btn primary" @onclick="AddTag" style="padding:8px;">+</button>
                    </div>
                </div>
                <div class="tags-list">
                    @foreach (var t in FilteredTags)
                    {
                        <div class="tag-item" style="background:@t.Color; color:@TagTextColor(t);" @onclick="() => SelectTagForEdit(t)">
                            @t.Name
                            <span class="tag-delete" @onclick="() => DeleteTag(t)" @onclick:stopPropagation="true">X</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-box">
                <div class="modal-header">
                    <span class="modal-title">جلسة جديدة @if (_selectedTag != null) { <span class="tag-badge" style="background:@_selectedTag.Color; color:@TagTextColor(_selectedTag);">@_selectedTag.Name</span> }</span>
                    <button class="close-btn" @onclick="CloseModal">X</button>
                </div>
                <div class="input-group"><label class="input-label">اسم الجلسة</label><input type="text" class="minimal-input" @bind="_sessionName" placeholder="untitled" /></div>
                <div class="input-group"><label class="input-label">ملاحظات</label><textarea class="minimal-textarea" @bind="_sessionNote" placeholder="اكتب ملاحظاتك هنا..."></textarea></div>
                <div class="input-group"><label class="input-label">المدة</label><input type="number" class="minimal-input" @bind="_sessionDuration" /></div>
                <div class="modal-actions"><button class="modal-btn" @onclick="CloseModal">إلغاء</button><button class="modal-btn primary" @onclick="StartSessionFromCreate">بدء</button></div>
            </div>
        </div>
    }

    @if (_modalMode == ModalMode.Details)
    {
        <div class="modal-group">
            @if (_editing)
            {
                <div class="modal-box tags-modal-box">
                    <div class="modal-header"><span class="modal-title">التاجات</span></div>
                    <div class="input-group"><input type="text" class="minimal-input" @bind="_tagSearch" placeholder="بحث..." /></div>
                    <div class="input-group">
                        <div style="display:flex; gap:8px; align-items:center;">
                            <input type="text" class="minimal-input" @bind="_newTagName" placeholder="إضافة تاج" style="flex:1;" />
                            <input type="color" class="color-input" @bind="_newTagColor" />
                            <button class="modal-btn primary" @onclick="AddTag" style="padding:8px;">+</button>
                        </div>
                    </div>
                    <div class="tags-list">
                        @foreach (var t in FilteredTags)
                        {
                            <div class="tag-item" style="background:@t.Color; color:@TagTextColor(t);" @onclick="() => SelectTagForEdit(t)">
                                @t.Name
                                <span class="tag-delete" @onclick="() => DeleteTag(t)" @onclick:stopPropagation="true">X</span>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="modal-box">
                <div class="modal-header">
                    <span class="modal-title">تفاصيل الجلسة @if (CurrentDetailTag != null) { <span class="tag-badge" style="background:@CurrentDetailTag.Color; color:@TagTextColor(CurrentDetailTag);">@CurrentDetailTag.Name</span> }</span>
                    <button class="close-btn" @onclick="CloseModal">X</button>
                </div>
                <div class="input-group"><label class="input-label">اسم الجلسة</label><input type="text" class="minimal-input" @bind="_editName" disabled="@(!_editing)" /></div>
                <div class="input-group"><label class="input-label">ملاحظات</label><textarea class="minimal-textarea" @bind="_editNote" disabled="@(!_editing)"></textarea></div>
                <div class="input-group">
                    <label class="input-label">@(IsDetailCurrent ? "المدة" : "المدة المقضية")</label>
                    <span class="detail-static">@(IsDetailCurrent ? CurrentElapsedText : FormatTime(TimeSpan.FromSeconds(_detailSession!.ElapsedSeconds))) @(IsDetailCurrent ? $"من {_detailSession.PlannedMinutes} دقيقة" : "")</span>
                </div>
                @if (!IsDetailCurrent && _editing)
                {
                    <div class="input-group"><label class="input-label">المدة (دقيقة)</label><input type="number" class="minimal-input" @bind="_editDurationMinutes" /></div>
                }
                <div class="modal-actions">
                    <button class="modal-btn" @onclick="ToggleEdit">تعديل</button>
                    <button class="modal-btn" @onclick="DeleteCurrentDetails">حذف</button>
                    <button class="modal-btn primary" @onclick="SaveDetails">حفظ</button>
                </div>
            </div>
        </div>
    }

    @if (_modalMode == ModalMode.Prompt)
    {
        <div class="modal-group">
            <div class="modal-box">
                <div class="modal-header">
                    <span class="modal-title">جلسة شغالة</span>
                    <button class="close-btn" @onclick="CloseModal">X</button>
                </div>
                <div class="input-group"><span class="detail-static">في جلسة شغالة حالياً — ماذا تريد أن تفعل بها؟</span></div>
                <div class="modal-actions">
                    <button class="modal-btn" @onclick="CancelCurrentAndStart">الغاء الجلسة الحالية (سيتم حذفها)</button>
                    <button class="modal-btn primary" @onclick="SaveCurrentAndStart">حفظ الجلسة وبدأ جلسة جديدة مدتها: @_pendingMinutes دقيقة</button>
                </div>
            </div>
        </div>
    }

    
</div>
    @if (_locationModalOpen)
    {
        <div class="modal-overlay" style="display:flex; pointer-events:auto;">
            <div class="modal-group">
                <div class="modal-box" style="width:300px;">
                    <div class="modal-header">
                        <span class="modal-title">تغيير المنطقة</span>
                        <button class="close-btn" @onclick="() => _locationModalOpen = false">X</button>
                    </div>
                    <div class="input-group">
                        <label class="input-label">خط العرض (Latitude)</label>
                        <input type="number" class="minimal-input" step="0.0001"
                               @bind="_latInput" placeholder="30.0444" />
                    </div>
                    <div class="input-group">
                        <label class="input-label">خط الطول (Longitude)</label>
                        <input type="number" class="minimal-input" step="0.0001"
                               @bind="_lonInput" placeholder="31.2357" />
                    </div>
                    <div style="font-size:11px; color:#555; margin-top:-8px;">
                        ابحث عن إحداثياتك على Google Maps
                    </div>
                    <div class="modal-actions">
                        <button class="modal-btn" @onclick="() => _locationModalOpen = false">إلغاء</button>
                        <button class="modal-btn primary" @onclick="SaveLocation">حفظ</button>
                    </div>
                </div>
            </div>
        </div>
    }

<style>
    :root { --black: #000000; --white: #FFFFFF; --gray: #EEEEEE; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Courier New', Courier, monospace; }
    body { background-color: var(--white); color: var(--black); height: 100vh; overflow: hidden; font-size: 14px; }

    .app-container { display: flex; height: 100vh; }

    .prayer-countdown {
        text-align: center;
        border: 1px solid var(--black);
        padding: 12px;
        margin-bottom: 16px;
    }
    .prayer-countdown-label {
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .prayer-countdown-timer {
        font-size: 32px;
        letter-spacing: -1px;
        font-weight: normal;
    }
    .prayer-table tr.next-prayer td {
        background: var(--black);
        color: var(--white);
    }
    .sidebar-btn:hover { background: var(--black); color: var(--white); }
    .sidebar-btn.active { background: var(--black); color: var(--white); }

    .left-panel { flex: 1.5; border-left: 1px solid var(--black); display: flex; flex-direction: column; padding: 40px; gap: 24px; overflow-y: auto; }

    .timer-box { border: 1px solid var(--black); padding: 20px 40px; text-align: center; cursor: pointer; }
    .timer-box:hover { background: var(--black); color: var(--white); }
    .timer-value { font-size: 64px; font-weight: normal; letter-spacing: -2px; line-height: 1; }
    .timer-label { font-size: 12px; margin-top: 8px; text-transform: uppercase; }

    .durations { display: flex; gap: 8px; justify-content: center; }
    .dur-btn { border: 1px solid var(--black); padding: 4px 12px; cursor: pointer; background: none; font-family: inherit; font-size: 14px; }
    .dur-btn:hover { background: var(--black); color: var(--white); }
    .dur-btn.active { background: var(--black); color: var(--white); }

    .actions { display: flex; gap: 16px; justify-content: center; }
    .action-btn { background: none; border: 1px solid var(--black); width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 8px; }
    .action-btn:hover { background: var(--black); }
    .action-btn svg { stroke: var(--black); fill: none; }
    .action-btn:hover svg { stroke: var(--white); }

    .timer-info { width: 100%; display: flex; flex-direction: column; gap: 8px; font-size: 16px; border-top: 1px solid var(--black); padding-top: 16px; font-weight: bold; }
    .info-row { display: flex; justify-content: space-between; padding: 4px 0; cursor: pointer; }
    .info-row:hover { background: var(--gray); }

    .prayer-section { border-top: 1px solid var(--black); padding-top: 24px; margin-top: 24px; }
    .prayer-title { font-size: 14px; font-weight: bold; margin-bottom: 12px; cursor: pointer; }
    .prayer-table { width: 100%; border-collapse: collapse; text-align: right; }
    .prayer-table th, .prayer-table td { padding: 8px 12px; border: 1px solid var(--black); cursor: pointer; }
    .prayer-table th { font-weight: normal; background: var(--white); text-transform: uppercase; font-size: 12px; }
    .prayer-table tr:hover td { background: var(--black); color: var(--white); }

    .right-panel { flex: 2; overflow-y: auto; display: flex; flex-direction: column; }
    .right-panel::-webkit-scrollbar { width: 4px; }
    .right-panel::-webkit-scrollbar-thumb { background: var(--black); }

    .view-modes { display: flex; border-bottom: 1px solid var(--black); position: relative; }
    .view-btn { flex: 1; text-align: center; padding: 12px; cursor: pointer; border-left: 1px solid var(--black); background: none; font-family: inherit; }
    .view-btn:last-child { border-left: none; }
    .view-btn:hover { background: var(--black); color: var(--white); }
    .view-btn.active { background: var(--black); color: var(--white); }

    .toggle-group { border-bottom: 1px solid var(--black); }
    .toggle-header { padding: 12px 16px; border-bottom: 1px solid var(--black); cursor: pointer; font-weight: bold; display: flex; justify-content: space-between; align-items: center; background: var(--white); user-select: none; }
    .toggle-header:hover { background: var(--black); color: var(--white); }
    .toggle-icon { font-size: 16px; line-height: 1; margin-right: 8px; }

    .session-item { padding: 10px 16px; border-bottom: 1px solid var(--gray); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
    .session-item:hover { background: var(--black); color: var(--white); }

    .time-stamp { color: #555; font-size: 12px; }
    .session-item:hover .time-stamp { color: var(--white); }

    .tag-badge { border: 1px solid var(--black); padding: 2px 6px; font-size: 10px; display: inline-flex; align-items: center; margin-left: 5px; }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: transparent; z-index: 100; display: none; justify-content: center; align-items: center; pointer-events: none; }
    .modal-group { pointer-events: auto; display: flex; gap: 0; box-shadow: 10px 10px 0px rgba(0,0,0,0.1); }
    .modal-box { border: 2px solid var(--black); background: var(--white); color: var(--black); padding: 32px; width: 350px; display: flex; flex-direction: column; gap: 20px; position: relative; }
    .tags-modal-box { width: 250px; border-right: none; }

    .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--black); padding-bottom: 12px; }
    .modal-title { font-weight: bold; text-transform: uppercase; display: flex; align-items: center; gap: 8px; font-size: 14px; }
    .close-btn { background: none; border: 1px solid var(--black); color: var(--black); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-family: inherit; font-size: 12px; }
    .close-btn:hover { background: var(--black); color: var(--white); }

    .input-group { display: flex; flex-direction: column; gap: 6px; }
    .input-label { font-size: 12px; text-transform: uppercase; }
    .minimal-input, .minimal-textarea { border: 1px solid var(--black); padding: 8px; font-family: inherit; background: none; color: var(--black); outline: none; font-size: 14px; width: 100%; }
    .minimal-textarea { resize: vertical; min-height: 100px; }
    .minimal-input:focus, .minimal-textarea:focus { border-color: var(--gray); background: var(--gray); }
    .minimal-input::placeholder, .minimal-textarea::placeholder { color: #999; }

    .modal-actions { display: flex; justify-content: space-between; margin-top: 12px; }
    .modal-btn { border: 1px solid var(--black); padding: 8px 16px; cursor: pointer; background: none; color: var(--black); font-family: inherit; text-transform: uppercase; font-size: 12px; }
    .modal-btn:hover { background: var(--black); color: var(--white); }
    .modal-btn.primary { background: var(--black); color: var(--white); }
    .modal-btn.primary:hover { background: var(--white); color: var(--black); }

    .tags-list { display: flex; flex-wrap: wrap; gap: 6px; max-height: 200px; overflow-y: auto; border: 1px solid var(--gray); padding: 8px; }
    .tag-item { border: 1px solid var(--black); padding: 4px 8px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 12px; }
    .tag-item:hover { opacity: 0.7; }
    .tag-delete { cursor: pointer; border-left: 1px solid var(--black); padding-left: 4px; margin-left: 4px; }
    .tag-delete:hover { color: red; }
    .color-input { width: 30px; height: 30px; border: 1px solid var(--black); cursor: pointer; padding: 0; background: none; }

    .detail-static { border: 1px solid var(--black); padding: 8px; font-size: 14px; display: block; }
    .minimal-input:disabled, .minimal-textarea:disabled { opacity: 0.6; cursor: default; }
</style>

@code {
    private enum ModalMode { None, Create, Details, Prompt }

    private readonly PomodoroTimer _timer = new(TimeSpan.FromMinutes(25));
    private PomodoroRepository _repo = null!;
    private int _activeMinutes = 25;
    private DateTime? _startedAt;
    private string _viewMode = "daily";
    private List<SessionGroup> _toggles = new();
    private readonly List<Session> _sessions = new();
    private readonly List<Tag> _tags = new();
    private Session? _currentSession;
    private int _tickCount;

    private ModalMode _modalMode = ModalMode.None;
    private bool _modalOpen => _modalMode != ModalMode.None;

    private Session? _detailSession;
    private bool _editing;
    private string _editName = "";
    private string _editNote = "";
    private int _editDurationMinutes;
    private Tag? _editTag;

    private int _pendingMinutes;

    private Tag? _selectedTag;
    private string _sessionName = "";
    private string _sessionNote = "";
    private int _sessionDuration = 25;
    private string _tagSearch = "";
    private string _newTagName = "";
    private string _newTagColor = "#000000";

    private PrayerTimeEntry? _todayPrayers;
    private string _nextPrayerName = "";
    private TimeSpan _timeToNextPrayer = TimeSpan.Zero;
    private System.Threading.Timer? _prayerTimer;

    private bool _locationModalOpen;
    private string _latInput = "";
    private string _lonInput = "";
    
    private static readonly int[] Durations = { 25, 50, 5, 10 };
    private static readonly (string Label, string Value)[] ViewModes =
    {
        ("يومي", "daily"), ("اسبوعي", "weekly"), ("شهري", "monthly"), ("سنوي", "yearly"),
    };
    private static readonly string[] ArabicDays = { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };

    private string StartTimeText => _startedAt?.ToString("hh:mm:ss tt", new System.Globalization.CultureInfo("ar-SA")) ?? "00:00:00";
    private string FinalTimeText => _startedAt?.AddMinutes(_activeMinutes).ToString("hh:mm:ss tt", new System.Globalization.CultureInfo("ar-SA")) ?? "00:00:00";
    private string DurationText => TimeSpan.FromMinutes(_activeMinutes).ToString(@"hh\:mm\:ss");
    private IEnumerable<Tag> FilteredTags => _tags.Where(t => t.Name.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase));

    private bool IsDetailCurrent => _detailSession != null && _detailSession == _currentSession;
    private Tag? CurrentDetailTag => _editing ? _editTag : _detailSession?.Tag;
    private int CurrentElapsedSeconds()
    {
        var planned = _activeMinutes * 60;
        var rem = (int)Math.Round(_timer.Remaining.TotalSeconds);
        return Math.Clamp(planned - rem, 0, planned);
    }
    private string CurrentElapsedText => FormatTime(TimeSpan.FromSeconds(CurrentElapsedSeconds()));

    private static string To12H(string time24)
    {
        if (!TimeSpan.TryParse(time24, out var t)) return time24;
        var suffix = t.Hours < 12 ? "ص" : "م";
        var h = t.Hours % 12;
        if (h == 0) h = 12;
        return $"{h}:{t.Minutes:D2} {suffix}";
    }
    
    protected override async Task OnInitializedAsync()
    {
        _timer.Tick += OnTimerEvent;
        _timer.Completed += OnTimerEvent;
        _repo = new PomodoroRepository();
        await PrayerService.InitAsync();
        _todayPrayers = await PrayerService.GetTodayAsync();
        UpdateNextPrayer();
        _prayerTimer = new System.Threading.Timer(_ =>
                InvokeAsync(() => { UpdateNextPrayer(); StateHasChanged(); }),
            null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        await LoadFromDbAsync();
        RebuildToggles();
    }

    private void UpdateNextPrayer()
    {
        if (_todayPrayers == null) return;
        var now = DateTime.Now;

        var prayers = new[]
        {
            ("الفجر",    _todayPrayers.Fajr),
            ("الشروق",   _todayPrayers.Sunrise),
            ("الظهر",    _todayPrayers.Dhuhr),
            ("العصر",    _todayPrayers.Asr),
            ("المغرب",   _todayPrayers.Maghrib),
            ("العشاء",   _todayPrayers.Isha),
        };

        foreach (var (name, timeStr) in prayers)
        {
            if (TimeSpan.TryParse(timeStr, out var t))
            {
                var prayerDt = now.Date.Add(t);
                if (prayerDt > now)
                {
                    _nextPrayerName    = name;
                    _timeToNextPrayer  = prayerDt - now;
                    return;
                }
            }
        }
        // بعد العشاء → الفجر الجاي
        if (TimeSpan.TryParse(_todayPrayers.Fajr, out var fajr))
        {
            _nextPrayerName   = "الفجر";
            _timeToNextPrayer = now.Date.AddDays(1).Add(fajr) - now;
        }
    }

    private void OpenLocationModal()
    {
        _latInput = PrayerService.Location.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _lonInput = PrayerService.Location.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _locationModalOpen = true;
    }
    
    private static string FormatCountdown(TimeSpan t)
        => $"{(int)t.TotalHours:D2}:{t.Minutes:D2}:{t.Seconds:D2}";

    private async Task SaveLocation()
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
    
        if (double.TryParse(_latInput, System.Globalization.NumberStyles.Any, culture, out var lat) &&
            double.TryParse(_lonInput, System.Globalization.NumberStyles.Any, culture, out var lon))
        {
            await PrayerService.SetLocationAsync(lat, lon);
            _todayPrayers = await PrayerService.GetTodayAsync();
            UpdateNextPrayer();
            _locationModalOpen = false;
        }
    }

    private async Task LoadFromDbAsync()
    {
        _sessions.AddRange(await _repo.GetSessionsAsync());
        _tags.AddRange(await _repo.GetTagsAsync());
        if (_tags.Count == 0)
        {
            var defaults = new[]
            {
                new Tag { Name = "برمجة", Color = "#000000" },
                new Tag { Name = "تصميم", Color = "#3B82F6" },
                new Tag { Name = "كتابة", Color = "#EF4444" },
            };
            foreach (var t in defaults)
            {
                await _repo.SaveTagAsync(t);
                _tags.Add(t);
            }
        }
        foreach (var s in _sessions)
            s.Tag = _tags.FirstOrDefault(t => t.Id == s.TagId);
    }

    private void OnTimerEvent()
    {
        _tickCount++;
        InvokeAsync(StateHasChanged);
        if (_timer.IsCompleted && _currentSession != null)
        {
            var s = _currentSession;
            _currentSession = null;
            _startedAt = null;
            s.ElapsedSeconds = s.PlannedMinutes * 60;
            s.Completed = true;
            _ = _repo.SaveSessionAsync(s);
        }
        else if (_currentSession != null && _tickCount % 10 == 0)
        {
            _currentSession.ElapsedSeconds = CurrentElapsedSeconds();
            _ = _repo.SaveSessionAsync(_currentSession);
        }
    }

    private static string FormatTime(TimeSpan t) => $"{(int)t.TotalMinutes:D2}:{t.Seconds:D2}";

    private async Task ToggleTimer()
    {
        if (_timer.IsRunning)
        {
            _timer.Pause();
            if (_currentSession != null)
            {
                _currentSession.ElapsedSeconds = CurrentElapsedSeconds();
                await _repo.SaveSessionAsync(_currentSession);
            }
        }
        else
        {
            _timer.Start();
            if (_currentSession == null)
            {
                _startedAt = DateTime.Now;
                var s = NewSession("untitled", "", _activeMinutes, null);
                _sessions.Insert(0, s);
                _currentSession = s;
                await _repo.SaveSessionAsync(s);
                RebuildToggles();
            }
        }
    }

    private async Task ResetTimer()
    {
        if (_currentSession != null)
        {
            _currentSession.ElapsedSeconds = CurrentElapsedSeconds();
            await _repo.SaveSessionAsync(_currentSession);
            _currentSession = null;
        }
        _timer.Reset();
        _startedAt = null;
    }

    private async Task CompleteCurrentSession()
    {
        if (_currentSession == null) return;
        _currentSession.ElapsedSeconds = CurrentElapsedSeconds();
        _currentSession.Completed = true;
        await _repo.SaveSessionAsync(_currentSession);
        _currentSession = null;
        _timer.Reset();
        _startedAt = null;
        _modalMode = ModalMode.None;
        RebuildToggles();
    }

    private void PromptOrStart(int minutes)
    {
        if (_currentSession != null)
        {
            _pendingMinutes = minutes;
            _modalMode = ModalMode.Prompt;
        }
        else
        {
            _activeMinutes = minutes;
            _timer.SetDuration(TimeSpan.FromMinutes(minutes));
        }
    }

    private async Task CancelCurrentAndStart()
    {
        if (_currentSession != null)
        {
            _sessions.Remove(_currentSession);
            await _repo.DeleteSessionAsync(_currentSession.Id);
            _currentSession = null;
        }
        _timer.Reset();
        _startedAt = null;
        _modalMode = ModalMode.None;
        await DirectStartAsync(_pendingMinutes);
    }

    private async Task SaveCurrentAndStart()
    {
        if (_currentSession != null)
        {
            _currentSession.ElapsedSeconds = CurrentElapsedSeconds();
            _currentSession.Completed = true;
            await _repo.SaveSessionAsync(_currentSession);
            _currentSession = null;
        }
        _timer.Reset();
        _startedAt = null;
        _modalMode = ModalMode.None;
        await DirectStartAsync(_pendingMinutes);
    }

    private async Task DirectStartAsync(int minutes)
    {
        _activeMinutes = minutes;
        _timer.SetDuration(TimeSpan.FromMinutes(minutes));
        _timer.Start();
        _startedAt = DateTime.Now;
        var s = NewSession("untitled", "", minutes, null);
        _sessions.Insert(0, s);
        _currentSession = s;
        await _repo.SaveSessionAsync(s);
        RebuildToggles();
    }

    private void OnTimerBoxClick()
    {
        if (_currentSession != null) OpenSessionDetails(_currentSession);
        else OpenCreateModal();
    }

    private void OpenCreateModal()
    {
        _sessionName = "";
        _sessionNote = "";
        _sessionDuration = 25;
        _selectedTag = null;
        _modalMode = ModalMode.Create;
    }

    private void OpenSessionDetails(Session s)
    {
        _detailSession = s;
        _editing = false;
        _editName = s.Title;
        _editNote = s.Note;
        _editDurationMinutes = s.ElapsedSeconds / 60;
        _editTag = s.Tag;
        _modalMode = ModalMode.Details;
    }

    private void CloseModal()
    {
        _modalMode = ModalMode.None;
        _detailSession = null;
        _editing = false;
        _selectedTag = null;
    }

    private void ToggleEdit()
    {
        _editing = !_editing;
        if (!_editing && _detailSession != null)
        {
            _editName = _detailSession.Title;
            _editNote = _detailSession.Note;
            _editDurationMinutes = _detailSession.ElapsedSeconds / 60;
            _editTag = _detailSession.Tag;
        }
    }

    private async Task DeleteCurrentDetails()
    {
        if (_detailSession == null) return;
        _sessions.Remove(_detailSession);
        await _repo.DeleteSessionAsync(_detailSession.Id);
        if (_currentSession == _detailSession)
        {
            _currentSession = null;
            _timer.Reset();
            _startedAt = null;
        }
        _modalMode = ModalMode.None;
        RebuildToggles();
    }

    private async Task SaveDetails()
    {
        if (_detailSession == null) return;
        _detailSession.Title = string.IsNullOrWhiteSpace(_editName) ? "untitled" : _editName.Trim();
        _detailSession.Note = _editNote;
        if (_detailSession == _currentSession)
        {
            ApplyTag(_detailSession, _editTag);
            await _repo.SaveSessionAsync(_detailSession);
            _modalMode = ModalMode.None;
            RebuildToggles(); 
        }
        else
        {
            if (_editing)
            {
                _detailSession.ElapsedSeconds = Math.Max(0, _editDurationMinutes) * 60;
                ApplyTag(_detailSession, _editTag);
            }
            await _repo.SaveSessionAsync(_detailSession);
            _modalMode = ModalMode.None;
            RebuildToggles();
        }
    }

    private async Task StartSessionFromCreate()
    {
        var dur = _sessionDuration > 0 ? _sessionDuration : 25;
        _activeMinutes = dur;
        _timer.SetDuration(TimeSpan.FromMinutes(dur));
        _timer.Start();
        _startedAt = DateTime.Now;
        var s = NewSession(string.IsNullOrWhiteSpace(_sessionName) ? "untitled" : _sessionName.Trim(), _sessionNote, dur, _selectedTag);
        _sessions.Insert(0, s);
        _currentSession = s;
        await _repo.SaveSessionAsync(s);
        _selectedTag = null;
        _modalMode = ModalMode.None;
        RebuildToggles();
    }

    private Session NewSession(string title, string note, int minutes, Tag? tag)
    {
        var now = DateTime.Now;
        var s = new Session
        {
            Id = $"s-{now.Ticks}",
            Date = $"{now.Year}-{now.Month}-{now.Day}",
            Title = title,
            Time = now.ToString("HH:mm"),
            Note = note,
            PlannedMinutes = minutes,
            ElapsedSeconds = 0,
            Completed = false,
            Tag = tag,
        };
        ApplyTag(s, tag);
        return s;
    }

    private static void ApplyTag(Session s, Tag? tag)
    {
        s.Tag = tag;
        s.TagId = tag?.Id;
        s.TagName = tag?.Name ?? "";
        s.TagColor = tag?.Color ?? "#000000";
    }

    private void SelectTagForEdit(Tag t)
    {
        if (_modalMode == ModalMode.Create) _selectedTag = t;
        else _editTag = t;
    }

    private async Task DeleteTag(Tag t)
    {
        _tags.Remove(t);
        if (_selectedTag == t) _selectedTag = null;
        if (_editTag == t) _editTag = null;
        await _repo.DeleteTagAsync(t);
    }

    private async Task AddTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        var t = new Tag { Name = _newTagName.Trim(), Color = _newTagColor };
        await _repo.SaveTagAsync(t);
        _tags.Add(t);
        _newTagName = "";
    }

    private static string TagTextColor(Tag t) => t.Color == "#000000" ? "white" : "black";

    private void SetView(string mode)
    {
        _viewMode = mode;
        RebuildToggles();
    }

    private void RebuildToggles()
    {
        var openIds = new HashSet<string>();
        CollectOpenIds(_toggles, openIds);
        
        var ordered = _sessions
            .OrderByDescending(s => s.Date)
            .ThenByDescending(s => s.Time)
            .ToList();
        var now = DateTime.Now;

        switch (_viewMode)
        {
            case "weekly":
                _toggles = ordered.GroupBy(s => WeekNumber(ParseDate(s.Date)))
                    .OrderByDescending(g => g.Key)
                    .Select(g => GroupWithChildren($"W{g.Key}", $"الأسبوع {g.Key}", g.Count(),
                        g.GroupBy(s => s.Date).Select(d => Group($"{g.Key}-{d.Key}", FullDateLabel(d.Key), d.ToList())).ToList()))
                    .ToList();
                break;
            case "monthly":
                _toggles = BuildMonthsOfYear(now.Year, now.Month, ordered);
                break;
            case "yearly":
                _toggles = new List<SessionGroup>
                {
                    GroupWithChildren($"y-{now.Year}", $"{now.Year}",
                        ordered.Count(s => s.Date.StartsWith($"{now.Year}-")),
                        BuildMonthsOfYear(now.Year, now.Month, ordered)),
                };
                break;
            default:
                _toggles = ordered.GroupBy(s => s.Date)
                    .Select(g => Group($"tg-{g.Key}", FullDateLabel(g.Key), g.ToList()))
                    .ToList();
                break;
        }
        
        RestoreOpenState(_toggles, openIds);
    }
    
    private static void CollectOpenIds(List<SessionGroup> groups, HashSet<string> ids)
    {
        foreach (var g in groups)
        {
            if (g.Open) ids.Add(g.Id);
            if (g.Children != null) CollectOpenIds(g.Children, ids);
        }
    }
    private static void RestoreOpenState(List<SessionGroup> groups, HashSet<string> ids)
    {
        foreach (var g in groups)
        {
            if (ids.Contains(g.Id)) g.Open = true;
            if (g.Children != null) RestoreOpenState(g.Children, ids);
        }
    }

    private static List<SessionGroup> BuildMonthsOfYear(int year, int currentMonth, List<Session> ordered)
    {
        var byMonth = ordered
            .Where(s => s.Date.StartsWith($"{year}-"))
            .GroupBy(s => s.Date[..s.Date.LastIndexOf('-')])
            .ToDictionary(g => g.Key, g => g.ToList());
        var months = new List<SessionGroup>();
        for (var m = 1; m <= currentMonth; m++)
        {
            var key = $"{year}-{m}";
            var monthSessions = byMonth.TryGetValue(key, out var list) ? list : new List<Session>();
            var dayLimit = m == currentMonth ? DateTime.Now.Day : DateTime.DaysInMonth(year, m);
            var children = new List<SessionGroup>();
            for (var d = 1; d <= dayLimit; d++)
            {
                var dateStr = $"{year}-{m}-{d}";
                var daySessions = monthSessions.Where(s => s.Date == dateStr).ToList();
                children.Add(Group($"d-{dateStr}", FullDateLabel(dateStr), daySessions));
            }
            months.Add(GroupWithChildren($"m-{key}", MonthLabel(key), monthSessions.Count, children));
        }
        return months;
    }

    private static SessionGroup Group(string id, string label, List<Session> sessions) =>
        new() { Id = id, Label = label, Count = sessions.Count, Sessions = sessions };

    private static SessionGroup GroupWithChildren(string id, string label, int count, List<SessionGroup> children) =>
        new() { Id = id, Label = label, Count = count, Children = children };

    private static string FullDateLabel(string d)
    {
        var date = ParseDate(d);
        return $"{ArabicDays[(int)date.DayOfWeek]} {date.Day}/{date.Month}/{date.Year}";
    }

    private static string MonthLabel(string m)
    {
        var p = m.Split('-');
        return $"شهر {p[1]}";
    }

    private static DateTime ParseDate(string d) =>
        DateTime.ParseExact(d, "yyyy-M-d", System.Globalization.CultureInfo.InvariantCulture);

    private static int WeekNumber(DateTime d)
    {
        var day = (int)d.DayOfWeek == 0 ? 7 : (int)d.DayOfWeek;
        var shifted = d.Date.AddDays(4 - day);
        var yearStart = new DateTime(shifted.Year, 1, 1);
        return (int)Math.Ceiling(((shifted - yearStart).TotalDays + 1) / 7);
    }

    public void Dispose()
    {
        _timer.Tick -= OnTimerEvent;
        _timer.Completed -= OnTimerEvent;
        _timer.Dispose();
        _prayerTimer?.Dispose();
    }
