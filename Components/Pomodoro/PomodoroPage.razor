@namespace Jamrah.Components.Pomodoro
@implements IDisposable

<div class="pomodoro-page">
    <div class="pomodoro-container">
        <div class="pomodoro-time" @onclick="Toggle">@FormatTime(_timer.Remaining)</div>
        <div class="pomodoro-controls">
            <button class="pomodoro-btn" @onclick="Toggle">@(_timer.IsRunning ? "Pause" : "Start")</button>
            <button class="pomodoro-btn pomodoro-btn--secondary" @onclick="Reset">Reset</button>
        </div>
    </div>
</div>

<style>
    .pomodoro-page { 
        display: flex;
        justify-content: flex-end; 
        align-items: flex-start; 
        padding: 40px 80px;      
        
        width: 100%; 
        height: 100vh;           
        box-sizing: border-box; 
        
        background-color: #ffffff; 
        font-family: var(--tui-calendar-font-family); 
        color: var(--tui-calendar-text); 
    }

    .pomodoro-container {
        display: flex;
        flex-direction: column;
        align-items: center; 
        gap: 20px;      
    }

    .pomodoro-time { 
        font-size: 140px; 
        font-weight: 300; 
        letter-spacing: 4px; 
        cursor: pointer; 
        user-select: none; 
        line-height: 1; 
    }

    .pomodoro-controls { 
        display: flex; 
        gap: 20px; 
        justify-content: center;
        flex-wrap: wrap; 
    }

    .pomodoro-btn { 
        min-width: 80px; 
        padding: 12px 24px; 
        font-size: 18px; 
        border: none; 
        border-radius: 8px; 
        cursor: pointer; 
        color: #ffffff; 
        background-color: #2196F3; 
    }
    
    .pomodoro-btn--secondary { 
        background-color: #78909C; 
    }
    
    .pomodoro-btn:hover { 
        opacity: 0.9; 
    }
</style>

@code {
    private readonly PomodoroTimer _timer = new(TimeSpan.FromMinutes(25));

    private string FormatTime(TimeSpan t) => $"{(int)t.TotalMinutes:D2}:{t.Seconds:D2}";

    protected override void OnInitialized()
    {
        _timer.Tick += OnTimerEvent;
        _timer.Completed += OnTimerEvent;
    }

    private void OnTimerEvent() => InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        if (_timer.IsRunning) _timer.Pause();
        else _timer.Start();
        StateHasChanged();
    }

    private void Reset()
    {
        _timer.Reset();
        StateHasChanged();
    }

    public void Dispose()
    {
        _timer.Tick -= OnTimerEvent;
        _timer.Completed -= OnTimerEvent;
        _timer.Dispose();
    }
}