@namespace Jamrah.Components.Tasks
@implements IDisposable
@inject Jamrah.Services.ITaskStateService TaskService
@using Jamrah.Models

<div class="tasks-page" dir="rtl" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp">

    <div class="main-content">
        @if (_isDragging && _draggedTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            <div class="kanban-task ghost-task" style="left: @(_mouseX)px; top: @(_mouseY)px;">
                <div class="task-header">
                    <input type="checkbox" checked="@_draggedTask.IsDone" disabled />
                    <span class="task-title">@_draggedTask.Title</span>
                </div>
            </div>
        }

        <div class="board-header">
            <span class="board-title">المهام</span>
            <div class="header-toggles">
                <button class="toggle-btn" @onclick="ToggleSortMode">@GetSortModeLabel()</button>
                <button class="toggle-btn" @onclick="ToggleViewMode">عرض: @GetViewModeLabel()</button>
            </div>
            <button class="add-col-btn" @onclick="AddNewColumn" style="visibility: @(_currentView == ViewMode.Kanban ? "visible" : "hidden")">+ إضافة عمود</button>
        </div>

        @if (_currentView == ViewMode.Kanban)
        {
            <div class="board-container">
                @foreach (var col in TaskService.Columns)
                {
                    var capturedCol = col;
                    <div class="kanban-column" @onmouseenter="() => HandleColEnter(capturedCol.Id)">
                        <div class="col-header">
                            @if (_editingColId == capturedCol.Id)
                            {
                                <input class="col-edit-input" value="@_editColTitle"
                                       @oninput="e => _editColTitle = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => HandleColEditKeyDown(e, capturedCol)"
                                       @onblur="() => SaveColEdit(capturedCol)" autofocus />
                            }
                            else
                            {
                                <span class="col-title" @onclick="() => StartEditingCol(capturedCol)">@capturedCol.Title</span>
                                <button class="col-delete-btn" @onclick="() => DeleteColumn(capturedCol.Id)">×</button>
                            }
                        </div>

                        <div class="col-body">
                            @foreach (var task in GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == capturedCol.Id)))
                            {
                                var capturedTask = task;
                                <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                     @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                    <div class="task-header">
                                        <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                        <span class="task-title">@capturedTask.Title</span>
                                    </div>
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            }
                        </div>

                        <div class="col-footer">
                            <button class="task-add-btn" @onclick="() => OpenAddTaskModal(capturedCol.Id)">+ إضافة مهمة</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_currentView == ViewMode.Eisenhower)
        {
            <div class="eisenhower-container">
                <div class="matrix-quadrant q1" @onmouseenter="() => HandleQuadEnter(1)">
                    <div class="quad-header" style="background: rgba(239,68,68,0.1); color: #EF4444; border-bottom-color: #EF4444;">ضروري ومهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 1)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q2" @onmouseenter="() => HandleQuadEnter(2)">
                    <div class="quad-header" style="background: rgba(59,130,246,0.1); color: #3B82F6; border-bottom-color: #3B82F6;">مهم وغير ضروري</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 2)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q3" @onmouseenter="() => HandleQuadEnter(3)">
                    <div class="quad-header" style="background: rgba(245,158,11,0.1); color: #F59E0B; border-bottom-color: #F59E0B;">ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 3)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q4" @onmouseenter="() => HandleQuadEnter(4)">
                    <div class="quad-header" style="background: rgba(107,114,128,0.1); color: #6B7280; border-bottom-color: #6B7280;">غير ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 4)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_currentView == ViewMode.All)
        {
            <div class="split-view-container">
                <div class="split-side todo-side">
                    <div class="split-header">المهام العادية (TO-DO)</div>
                    <div class="list-add-section">
                        <button class="list-add-btn-full" @onclick="() => OpenAddTaskModal(null)">إضافة مهمة جديدة...</button>
                    </div>
                    <div class="list-items">
                        @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks).Where(t => !t.IsRecurring && t.ScheduledDate == null))
                        {
                            <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <div class="task-meta">
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="split-side scheduled-side">
                    <div class="split-header">المهام المجدولة والمتكررة</div>
                    <div class="list-items">
                        @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks).Where(t => t.IsRecurring || t.ScheduledDate != null))
                        {
                            <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <div class="task-meta">
                                    @if(capturedTask.IsRecurring) { <span class="task-badge recurring-badge">متكررة</span> }
                                    @if(capturedTask.ScheduledDate.HasValue) { <span class="task-date">@capturedTask.ScheduledDate.Value.ToString("yyyy-MM-dd")</span> }
                                    @if(capturedTask.ScheduledTime.HasValue) { <span class="task-time">@capturedTask.ScheduledTime.Value.ToString(@"hh\:mm")</span> }
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else // Done, Pending
        {
            <div class="list-container">
                <div class="list-add-section">
                    <button class="list-add-btn-full" @onclick="() => OpenAddTaskModal(null)">إضافة مهمة جديدة...</button>
                </div>
                <div class="list-items">
                    @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks))
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <div class="task-header">
                                <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                <span class="task-title">@capturedTask.Title</span>
                            </div>
                            <div class="task-meta">
                                @if(capturedTask.DueDate.HasValue) { <span class="task-date">@capturedTask.DueDate.Value.ToString("yyyy-MM-dd")</span> }
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Folders Sidebar -->
    <div class="folders-sidebar">
        <div class="sidebar-header">المجلدات</div>
        <div class="folder-list">
            <div class="folder-item @(_activeFolderId == "" ? "active" : "")" @onclick='() => SetActiveFolder("")'>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                <span class="folder-name">الكل</span>
            </div>
            @foreach (var folder in TaskService.Folders)
            {
                <div class="folder-item @(_activeFolderId == folder.Id ? "active" : "")" @onclick="() => SetActiveFolder(folder.Id)">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="@folder.Color" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span class="folder-name">@folder.Name</span>
                    @if (folder.Id != "default-general")
                    {
                        <span class="folder-del" @onclick="() => DeleteFolder(folder.Id)" @onclick:stopPropagation="true">×</span>
                    }
                </div>
            }
        </div>
        <div class="add-folder-section">
            @if (_isAddingFolder)
            {
                <input class="folder-input" @bind="_newFolderName" placeholder="الاسم" />
                <input type="color" class="folder-color" @bind="_newFolderColor" />
                <div class="folder-actions">
                    <button class="btn primary" @onclick="SaveNewFolder">حفظ</button>
                    <button class="btn" @onclick="() => _isAddingFolder = false">إلغاء</button>
                </div>
            }
            else
            {
                <button class="add-folder-btn" @onclick="() => _isAddingFolder = true">+ إضافة مجلد</button>
            }
        </div>
    </div>
</div>

@if (_isAddTaskModalOpen)
{
    <div class="modal-overlay" style="display:flex; pointer-events:auto;">
        <div class="modal-box" style="width: 450px;">
            <div class="modal-header">
                <span class="modal-title">مهمة جديدة</span>
                <button class="close-btn" @onclick="CloseAddTaskModal">X</button>
            </div>
            
            <div class="input-group">
                <label>اسم المهمة</label>
                <input class="minimal-input" @bind="_newTask.Title" placeholder="اكتب اسم المهمة..." autofocus />
            </div>

            <div class="input-group">
                <label>الأولوية</label>
                <select class="minimal-input" @bind="_newTask.Priority">
                    <option value="high">عالية</option>
                    <option value="medium">متوسطة</option>
                    <option value="low">منخفضة</option>
                </select>
            </div>

            <div class="input-group">
                <label>مصفوفة أيزنهاور</label>
                <select class="minimal-input" @bind="_newTask.EisenhowerQuadrant">
                    <option value="1">ضروري ومهم</option>
                    <option value="2">مهم وغير ضروري</option>
                    <option value="3">ضروري وغير مهم</option>
                    <option value="4">غير ضروري وغير مهم</option>
                </select>
            </div>

            <div class="input-group" style="flex-direction:row; gap:12px; align-items:center;">
                <input type="checkbox" @bind="_newTask.IsRecurring" style="width: 18px; height: 18px;" />
                <label style="margin:0; font-size:14px;">مهمة متكررة؟</label>
            </div>

            @if (_newTask.IsRecurring)
            {
                <div class="input-group">
                    <label>أيام التكرار</label>
                    <div class="days-row">
                        @foreach(var day in new[] { (0,"ح"),(1,"ن"),(2,"ث"),(3,"ر"),(4,"خ"),(5,"ج"),(6,"س") })
                        {
                            var isChecked = _newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Contains(day.Item1.ToString());
                            <button class="day-btn @(isChecked ? "active" : "")" @onclick="() => ToggleRecurrenceDay(day.Item1.ToString())">@day.Item2</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="input-group" style="flex-direction:row; gap:12px;">
                    <div style="flex:1;">
                        <label>التاريخ (اختياري)</label>
                        <input type="date" class="minimal-input" @bind="_newTask.ScheduledDate" />
                    </div>
                    <div style="flex:1;">
                        <label>الوقت (اختياري)</label>
                        <input type="time" class="minimal-input" value="@ScheduledTimeString" @onchange="OnTimeChanged" />
                    </div>
                </div>
            }

            <div class="modal-actions" style="margin-top:20px;">
                <button class="modal-btn" @onclick="CloseAddTaskModal">إلغاء</button>
                <button class="modal-btn primary" @onclick="SaveExpandedTask">إضافة المهمة</button>
            </div>
        </div>
    </div>
}

<style>
    :root { --black: #000000; --white: #FFFFFF; --gray: #EEEEEE; --dark-gray: #CCCCCC; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Courier New', Courier, monospace; }
    .tasks-page { height: 100vh; display: flex; flex-direction: row; background-color: var(--white); color: var(--black); position: relative; overflow: hidden; }
    
    .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    .board-header { padding: 20px 40px; border-bottom: 1px solid var(--black); display: flex; justify-content: space-between; align-items: center; }
    .board-title { font-size: 24px; font-weight: bold; text-transform: uppercase; }
    .add-col-btn { border: 1px solid var(--black); background: var(--white); color: var(--black); padding: 8px 16px; cursor: pointer; font-size: 14px; min-width: 120px; }
    .add-col-btn:hover { background: var(--black); color: var(--white); }
    
    .header-toggles { display: flex; gap: 12px; }
    .toggle-btn { border: 1px solid var(--black); background: var(--white); color: var(--black); padding: 8px 16px; cursor: pointer; font-size: 14px; min-width: 170px; text-align: center; }
    .toggle-btn:hover { background: var(--black); color: var(--white); }

    .board-container { flex: 1; display: flex; gap: 20px; padding: 20px 40px; overflow-x: auto; align-items: flex-start; }
    .board-container::-webkit-scrollbar { height: 8px; }
    .board-container::-webkit-scrollbar-thumb { background: var(--black); }

    .kanban-column { min-width: 300px; width: 300px; border: 1px solid var(--black); display: flex; flex-direction: column; max-height: 100%; background: var(--white); }
    
    .col-header { padding: 12px; border-bottom: 1px solid var(--black); display: flex; justify-content: space-between; align-items: center; background: var(--gray); }
    .col-title { font-weight: bold; cursor: pointer; flex: 1; }
    .col-title:hover { text-decoration: underline; }
    .col-delete-btn { background: none; border: none; cursor: pointer; font-size: 18px; line-height: 1; color: var(--black); margin-right: 8px; padding: 0 4px; }
    .col-delete-btn:hover { color: red; }
    .col-edit-input { flex: 1; border: 1px solid var(--black); padding: 4px; font-family: inherit; font-size: 14px; outline: none; }
    
    .col-body { padding: 12px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex: 1; min-height: 100px; }
    .col-body::-webkit-scrollbar { width: 4px; }
    .col-body::-webkit-scrollbar-thumb { background: var(--black); }

    .kanban-task { border: 1px solid var(--black); padding: 12px; display: flex; justify-content: space-between; align-items: flex-start; cursor: grab; background: var(--white); transition: opacity 0.2s; user-select: none; -webkit-user-select: none; }
    .kanban-task:active { cursor: grabbing; border-style: dashed; }
    .kanban-task.done { opacity: 0.5; }
    .kanban-task.done .task-title { text-decoration: line-through; }
    .kanban-task.dragging-original { opacity: 0.3; }

    .ghost-task { position: fixed; pointer-events: none; z-index: 9999; width: 280px; box-shadow: 5px 5px 15px rgba(0,0,0,0.2); transform: rotate(3deg); opacity: 0.95; }
    
    .task-header { display: flex; gap: 8px; align-items: flex-start; flex: 1; }
    .task-title { word-break: break-word; font-size: 14px; margin-top: -2px; }
    .task-delete-btn { background: none; border: none; cursor: pointer; font-size: 16px; color: var(--dark-gray); margin-right: 8px; }
    .task-delete-btn:hover { color: red; }
    
    .col-footer { padding: 12px; border-top: 1px solid var(--black); }
    .task-add-btn { width: 100%; border: none; background: none; text-align: right; cursor: pointer; font-size: 14px; color: #555; }
    .task-add-btn:hover { color: var(--black); text-decoration: underline; }

    /* List View Styles */
    .list-container { flex: 1; padding: 20px 40px; overflow-y: auto; display: flex; flex-direction: column; align-items: center; }
    .list-add-section { width: 100%; margin-bottom: 20px; }
    .list-add-btn-full { width: 100%; border: 1px dashed var(--black); padding: 12px; font-family: inherit; font-size: 14px; background: var(--white); cursor: pointer; text-align: right; color: #555; }
    .list-add-btn-full:hover { background: var(--gray); color: var(--black); }
    .list-items { width: 100%; display: flex; flex-direction: column; gap: 12px; }
    .list-task { cursor: default; align-items: center; }
    .list-task:active { cursor: default; border-style: solid; }
    .task-meta { display: flex; gap: 16px; align-items: center; }
    .task-date, .task-time { font-size: 12px; color: var(--dark-gray); }
    .task-badge { font-size: 10px; padding: 2px 6px; border: 1px solid var(--black); background: var(--gray); }
    .empty-list { text-align: center; color: var(--dark-gray); padding: 20px; font-size: 14px; }

    /* Eisenhower View */
    .eisenhower-container { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 20px; padding: 20px 40px; overflow-y: auto; }
    .matrix-quadrant { border: 2px solid var(--black); display: flex; flex-direction: column; background: var(--white); }
    .q1 { border-color: #EF4444; } .q2 { border-color: #3B82F6; } .q3 { border-color: #F59E0B; } .q4 { border-color: #6B7280; }
    .quad-header { padding: 12px; font-weight: bold; border-bottom: 2px solid var(--black); background: var(--gray); text-align: center; }
    .quad-body { padding: 12px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex: 1; min-height: 100px; }

    /* Split View */
    .split-view-container { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 20px 40px; overflow-y: auto; }
    .split-side { display: flex; flex-direction: column; gap: 12px; }
    .split-header { font-weight: bold; font-size: 18px; border-bottom: 1px solid var(--black); padding-bottom: 8px; text-transform: uppercase; }

    /* Folders Sidebar */
    .folders-sidebar { width: 70px; border-left: 1px solid var(--black); display: flex; flex-direction: column; background: var(--gray); transition: width 0.3s ease; overflow: hidden; white-space: nowrap; }
    .folders-sidebar:hover { width: 250px; }
    .sidebar-header { padding: 20px; font-weight: bold; border-bottom: 1px solid var(--black); font-size: 18px; opacity: 0; transition: opacity 0.3s; }
    .folders-sidebar:hover .sidebar-header { opacity: 1; }
    .folder-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
    .folder-item { padding: 16px; display: flex; align-items: center; gap: 16px; cursor: pointer; border-bottom: 1px solid var(--dark-gray); }
    .folder-item:hover { background: var(--dark-gray); }
    .folder-item.active { background: var(--black); color: var(--white); }
    .folder-name { opacity: 0; transition: opacity 0.3s; flex: 1; font-size: 14px; }
    .folders-sidebar:hover .folder-name { opacity: 1; }
    .folder-del { color: #888; padding: 0 8px; font-size: 18px; cursor: pointer; display: none; }
    .folders-sidebar:hover .folder-del { display: block; }
    .folder-del:hover { color: red; }
    
    .add-folder-section { padding: 16px; border-top: 1px solid var(--black); display: flex; flex-direction: column; gap: 8px; opacity: 0; transition: opacity 0.3s; }
    .folders-sidebar:hover .add-folder-section { opacity: 1; }
    .add-folder-btn { border: 1px dashed var(--black); background: none; padding: 8px; cursor: pointer; width: 100%; font-family: inherit; }
    .add-folder-btn:hover { background: var(--black); color: var(--white); }
    .folder-input { border: 1px solid var(--black); padding: 6px; width: 100%; outline: none; font-family: inherit; }
    .folder-color { width: 100%; height: 30px; border: 1px solid var(--black); cursor: pointer; padding: 0; }
