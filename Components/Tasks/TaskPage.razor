@code {
    private enum ViewMode { Kanban, Eisenhower, All, Done, Pending }
    private enum SortMode { Newest, Oldest, ByDate, ByPriority }

    private ViewMode _currentView = ViewMode.All;
    private SortMode _currentSort = SortMode.Newest;

    private string _editingColId = "";
    private string _editColTitle = "";

    private string _activeFolderId = ""; // folders removed, show all
    private bool _isRightSidebarCollapsed = true;
    private void ToggleRightSidebar() => _isRightSidebarCollapsed = !_isRightSidebarCollapsed;

    private bool _isAddTaskModalOpen = false;
    private string _targetColId = "";
    private AppTask _newTask = new AppTask();

    private string ScheduledTimeString => _newTask.ScheduledTime?.ToString(@"hh\:mm") ?? "";

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            _newTask.ScheduledTime = ts;
        else
            _newTask.ScheduledTime = null;
    }

    // --- Day Navigation ---
    private DateTime _selectedDate = DateTime.Today;
    private bool _morningCollapsed = false;
    private bool _todoCollapsed = false;
    private bool _eveningCollapsed = false;

    // --- Inline Add ---
    private bool _isInlineAddOpen = false;
    private ElementReference _inlineTitleRef;

    private void OpenInlineAdd()
    {
        _targetColId = TaskService.Columns.OrderBy(c => c.Order).FirstOrDefault()?.Id ?? "";
        _newTask = new AppTask
        {
            ColumnId = _targetColId,
            FolderId = string.IsNullOrEmpty(_activeFolderId) ? "default-general" : _activeFolderId,
            Priority = "low",
            EisenhowerQuadrant = 1,
            IsRecurring = false,
            RecurrenceDays = ""
        };
        _isInlineAddOpen = true;
    }

    private void CloseInlineAdd()
    {
        _isInlineAddOpen = false;
    }

    private async Task SaveInlineTask()
    {
        if (!string.IsNullOrWhiteSpace(_newTask.Title))
            await TaskService.AddTaskAsync(_newTask);
        _isInlineAddOpen = false;
    }

    private async Task HandleInlineKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SaveInlineTask();
        else if (e.Key == "Escape")
            CloseInlineAdd();
    }

    // --- Context Menu ---
    private string _openContextMenuTaskId = "";
    private void ToggleContextMenu(string taskId)
    {
        _openContextMenuTaskId = _openContextMenuTaskId == taskId ? "" : taskId;
    }
    private void CloseContextMenu() => _openContextMenuTaskId = "";

    // --- Edit Modal ---
    private bool _isEditModalOpen = false;
    private AppTask _editingTask = new();
    private string EditScheduledTimeString => _editingTask.ScheduledTime?.ToString(@"hh\:mm") ?? "";

    private void OnEditTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            _editingTask.ScheduledTime = ts;
        else
            _editingTask.ScheduledTime = null;
    }

    private void SetDailyRecurrenceEdit() => _editingTask.RecurrenceDays = "0,1,2,3,4,5,6";

    private void ToggleRecurrenceDayEdit(string day)
    {
        var days = _editingTask.RecurrenceDays?.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
        if (days.Contains(day)) days.Remove(day);
        else days.Add(day);
        _editingTask.RecurrenceDays = string.Join(",", days);
    }

    private void OpenEditModal(AppTask task)
    {
        _openContextMenuTaskId = "";
        _editingTask = new AppTask
        {
            Id = task.Id, Title = task.Title, Notes = task.Notes,
            Priority = task.Priority, EisenhowerQuadrant = task.EisenhowerQuadrant,
            IsRecurring = task.IsRecurring, RecurrenceDays = task.RecurrenceDays,
            ScheduledDate = task.ScheduledDate, ScheduledTime = task.ScheduledTime,
            IsDone = task.IsDone, ColumnId = task.ColumnId, FolderId = task.FolderId,
            CreatedAt = task.CreatedAt, UpdatedAt = task.UpdatedAt
        };
        _isEditModalOpen = true;
    }

    private void CloseEditModal() => _isEditModalOpen = false;

    private async Task SaveEditTask()
    {
        if (!string.IsNullOrWhiteSpace(_editingTask.Title))
            await TaskService.UpdateTaskAsync(_editingTask);
        _isEditModalOpen = false;
    }

    // --- Task Filtering for Day View ---
    private bool IsRecurringOnDate(AppTask t, DateTime date)
    {
        if (!t.IsRecurring) return false;
        var days = t.RecurrenceDays?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
        return days.Length == 0 || days.Contains(((int)date.DayOfWeek).ToString());
    }

    private List<AppTask> GetMorningTasksForDate(DateTime date)
    {
        var noon = TimeSpan.FromHours(12);
        return TaskService.Tasks.Where(t =>
        {
            if (!t.ScheduledTime.HasValue || t.ScheduledTime.Value >= noon) return false;
            if (t.IsRecurring) return IsRecurringOnDate(t, date);
            return t.ScheduledDate.HasValue && t.ScheduledDate.Value.Date == date.Date;
        }).OrderBy(t => t.ScheduledTime).ToList();
    }

    private List<AppTask> GetTodoTasksForDate(DateTime date)
    {
        return TaskService.Tasks.Where(t =>
        {
            // مهمة متكررة بدون وقت محدد → تظهر في أيام التكرار
            if (t.IsRecurring && !t.ScheduledTime.HasValue) return IsRecurringOnDate(t, date);
            // مهمة عادية بدون تاريخ مجدول → تظهر فقط في يوم إنشائها
            if (!t.IsRecurring && !t.ScheduledDate.HasValue && !t.ScheduledTime.HasValue)
                return t.CreatedAt.ToLocalTime().Date == date.Date;
            return false;
        }).ToList();
    }

    private List<AppTask> GetEveningTasksForDate(DateTime date)
    {
        var noon = TimeSpan.FromHours(12);
        return TaskService.Tasks.Where(t =>
        {
            if (t.IsRecurring)
            {
                if (!t.ScheduledTime.HasValue) return false;
                return t.ScheduledTime.Value >= noon && IsRecurringOnDate(t, date);
            }
            if (!t.ScheduledDate.HasValue) return false;
            if (t.ScheduledDate.Value.Date != date.Date) return false;
            return !t.ScheduledTime.HasValue || t.ScheduledTime.Value >= noon;
        }).OrderBy(t => t.ScheduledTime ?? TimeSpan.MaxValue).ToList();
    }

    private string GetDayLabel()
    {
        if (_selectedDate.Date == DateTime.Today) return "اليوم";
        if (_selectedDate.Date == DateTime.Today.AddDays(-1)) return "الأمس";
        if (_selectedDate.Date == DateTime.Today.AddDays(1)) return "الغد";
        string[] arabicDays = { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
        return arabicDays[(int)_selectedDate.DayOfWeek] + "، " + _selectedDate.ToString("dd/MM");
    }

    private async Task CarryForwardTask(AppTask task)
    {
        await TaskService.CarryForwardTaskAsync(task);
        _selectedDate = DateTime.Today;
    }

    // --- Custom Drag & Drop State ---
    private AppTask? _potentialDragTask;
    private AppTask? _draggedTask;
    private bool _isDragging;
    private double _mouseX;
    private double _mouseY;
    private string _hoveredColId = "";
    private int _hoveredQuad = 0;

    protected override async Task OnInitializedAsync()
    {
        TaskService.OnStateChanged += HandleStateChanged;
        await TaskService.InitAsync();
        
        // Ensure active folder points to a valid ID or empty.
        if (TaskService.Folders.Count > 0 && !TaskService.Folders.Any(f => f.Id == _activeFolderId))
        {
            _activeFolderId = TaskService.Folders.First().Id;
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TaskService.OnStateChanged -= HandleStateChanged;
    }

    // --- View and Sort Toggles ---
    private void ToggleViewMode()
    {
        _currentView = _currentView switch
        {
            ViewMode.Kanban => ViewMode.Eisenhower,
            ViewMode.Eisenhower => ViewMode.All,
            ViewMode.All => ViewMode.Done,
            ViewMode.Done => ViewMode.Pending,
            ViewMode.Pending => ViewMode.Kanban,
            _ => ViewMode.Kanban
        };
    }

    private string GetViewModeLabel()
    {
        return _currentView switch
        {
            ViewMode.Kanban => "Kanban",
            ViewMode.Eisenhower => "مصفوفة أيزنهاور",
            ViewMode.All => "الكل",
            ViewMode.Done => "المكتملة",
            ViewMode.Pending => "قيد التنفيذ",
            _ => "Kanban"
        };
    }

    private void ToggleSortMode()
    {
        _currentSort = _currentSort switch
        {
            SortMode.Newest => SortMode.Oldest,
            SortMode.Oldest => SortMode.ByDate,
            SortMode.ByDate => SortMode.ByPriority,
            SortMode.ByPriority => SortMode.Newest,
            _ => SortMode.Newest
        };
    }

    private string GetSortModeLabel()
    {
        return _currentSort switch
        {
            SortMode.Newest => "ترتيب: الأحدث",
            SortMode.Oldest => "ترتيب: الأقدم",
            SortMode.ByDate => "ترتيب: حسب التاريخ",
            SortMode.ByPriority => "ترتيب: حسب الأولوية",
            _ => "ترتيب: الأحدث"
        };
    }

    private IEnumerable<AppTask> GetFilteredAndSortedTasks(IEnumerable<AppTask> input)
    {
        var filtered = input;

        if (!string.IsNullOrEmpty(_activeFolderId))
        {
            filtered = filtered.Where(t => t.FolderId == _activeFolderId);
        }
        
        if (_currentView == ViewMode.Done)
        {
            filtered = filtered.Where(t => t.IsDone);
        }
        else if (_currentView == ViewMode.Pending)
        {
            filtered = filtered.Where(t => !t.IsDone);
        }

        return _currentSort switch
        {
            SortMode.Newest => filtered.OrderByDescending(t => t.CreatedAt),
            SortMode.Oldest => filtered.OrderBy(t => t.CreatedAt),
            SortMode.ByDate => filtered.OrderBy(t => !t.ScheduledDate.HasValue).ThenBy(t => t.ScheduledDate),
            SortMode.ByPriority => filtered.OrderBy(t => GetPriorityValue(t.Priority)),
            _ => filtered.OrderByDescending(t => t.CreatedAt)
        };
    }

    private IEnumerable<AppTask> GetFilteredTasks(string colId)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == colId));
    }

    private IEnumerable<AppTask> GetFilteredTasksEisenhower(int quadrant)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.EisenhowerQuadrant == quadrant));
    }

    private int GetPriorityValue(string priority)
    {
        return (priority?.ToLower()) switch
        {
            "high" => 1,
            "medium" => 2,
            "low" => 3,
            _ => 3
        };
    }

