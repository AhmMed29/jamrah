@code {
    private enum ViewMode { Kanban, Eisenhower, All, Done, Pending }
    private enum SortMode { Newest, Oldest, ByDate, ByPriority }

    private ViewMode _currentView = ViewMode.Kanban;
    private SortMode _currentSort = SortMode.Newest;

    private string _editingColId = "";
    private string _editColTitle = "";

    private string _activeFolderId = "default-general";
    
    private bool _isAddingFolder = false;
    private string _newFolderName = "";
    private string _newFolderColor = "#3B82F6";

    private bool _isAddTaskModalOpen = false;
    private string _targetColId = "";
    private AppTask _newTask = new AppTask();

    private string ScheduledTimeString => _newTask.ScheduledTime?.ToString(@"hh\:mm") ?? "";

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            _newTask.ScheduledTime = ts;
        else
            _newTask.ScheduledTime = null;
    }

    // --- Custom Drag & Drop State ---
    private AppTask? _potentialDragTask;
    private AppTask? _draggedTask;
    private bool _isDragging;
    private double _mouseX;
    private double _mouseY;
    private string _hoveredColId = "";
    private int _hoveredQuad = 0;

    protected override async Task OnInitializedAsync()
    {
        TaskService.OnStateChanged += HandleStateChanged;
        await TaskService.InitAsync();
        
        // Ensure active folder points to a valid ID or empty.
        if (TaskService.Folders.Count > 0 && !TaskService.Folders.Any(f => f.Id == _activeFolderId))
        {
            _activeFolderId = TaskService.Folders.First().Id;
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TaskService.OnStateChanged -= HandleStateChanged;
    }

    // --- Folders ---
    private void SetActiveFolder(string id)
    {
        _activeFolderId = id;
    }

    private async Task SaveNewFolder()
    {
        if (!string.IsNullOrWhiteSpace(_newFolderName))
        {
            await TaskService.AddFolderAsync(_newFolderName.Trim(), _newFolderColor);
            _isAddingFolder = false;
            _newFolderName = "";
        }
    }

    private async Task DeleteFolder(string id)
    {
        await TaskService.DeleteFolderAsync(id);
        if (_activeFolderId == id) _activeFolderId = "default-general";
    }

    // --- View and Sort Toggles ---
    private void ToggleViewMode()
    {
        _currentView = _currentView switch
        {
            ViewMode.Kanban => ViewMode.Eisenhower,
            ViewMode.Eisenhower => ViewMode.All,
            ViewMode.All => ViewMode.Done,
            ViewMode.Done => ViewMode.Pending,
            ViewMode.Pending => ViewMode.Kanban,
            _ => ViewMode.Kanban
        };
    }

    private string GetViewModeLabel()
    {
        return _currentView switch
        {
            ViewMode.Kanban => "Kanban",
            ViewMode.Eisenhower => "مصفوفة أيزنهاور",
            ViewMode.All => "الكل",
            ViewMode.Done => "المكتملة",
            ViewMode.Pending => "قيد التنفيذ",
            _ => "Kanban"
        };
    }

    private void ToggleSortMode()
    {
        _currentSort = _currentSort switch
        {
            SortMode.Newest => SortMode.Oldest,
            SortMode.Oldest => SortMode.ByDate,
            SortMode.ByDate => SortMode.ByPriority,
            SortMode.ByPriority => SortMode.Newest,
            _ => SortMode.Newest
        };
    }

    private string GetSortModeLabel()
    {
        return _currentSort switch
        {
            SortMode.Newest => "ترتيب: الأحدث",
            SortMode.Oldest => "ترتيب: الأقدم",
            SortMode.ByDate => "ترتيب: حسب التاريخ",
            SortMode.ByPriority => "ترتيب: حسب الأولوية",
            _ => "ترتيب: الأحدث"
        };
    }

    private IEnumerable<AppTask> GetFilteredAndSortedTasks(IEnumerable<AppTask> input)
    {
        var filtered = input;

        if (!string.IsNullOrEmpty(_activeFolderId))
        {
            filtered = filtered.Where(t => t.FolderId == _activeFolderId);
        }
        
        if (_currentView == ViewMode.Done)
        {
            filtered = filtered.Where(t => t.IsDone);
        }
        else if (_currentView == ViewMode.Pending)
        {
            filtered = filtered.Where(t => !t.IsDone);
        }

        return _currentSort switch
        {
            SortMode.Newest => filtered.OrderByDescending(t => t.CreatedAt),
            SortMode.Oldest => filtered.OrderBy(t => t.CreatedAt),
            SortMode.ByDate => filtered.OrderBy(t => !t.ScheduledDate.HasValue).ThenBy(t => t.ScheduledDate),
            SortMode.ByPriority => filtered.OrderBy(t => GetPriorityValue(t.Priority)),
            _ => filtered.OrderByDescending(t => t.CreatedAt)
        };
    }

    private IEnumerable<AppTask> GetFilteredTasks(string colId)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == colId));
    }

    private IEnumerable<AppTask> GetFilteredTasksEisenhower(int quadrant)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.EisenhowerQuadrant == quadrant));
    }

    private int GetPriorityValue(string priority)
    {
        return (priority?.ToLower()) switch
        {
            "high" => 1,
            "medium" => 2,
            "low" => 3,
            _ => 3
        };
    }

    // --- Column Actions ---
    private async Task AddNewColumn()
    {
        await TaskService.AddColumnAsync("عمود جديد");
    }

    private void StartEditingCol(KanbanColumn col)
    {
        _editingColId = col.Id;
        _editColTitle = col.Title;
    }

    private async Task SaveColEdit(KanbanColumn col)
    {
        if (string.IsNullOrWhiteSpace(_editColTitle))
        {
            _editColTitle = "بدون اسم";
        }
        await TaskService.RenameColumnAsync(col.Id, _editColTitle.Trim());
        _editingColId = "";
    }

    private async Task HandleColEditKeyDown(KeyboardEventArgs e, KanbanColumn col)
    {
        if (e.Key == "Enter")
        {
            await SaveColEdit(col);
        }
        else if (e.Key == "Escape")
        {
            _editingColId = "";
        }
    }

    private async Task DeleteColumn(string id)
    {
        await TaskService.DeleteColumnAsync(id);
    }

    // --- Task Actions ---
    private void OpenAddTaskModal(string? colId)
    {
        _targetColId = colId ?? (TaskService.Columns.OrderBy(c => c.Order).FirstOrDefault()?.Id ?? "");
        _newTask = new AppTask
        {
            ColumnId = _targetColId,
            FolderId = string.IsNullOrEmpty(_activeFolderId) ? "default-general" : _activeFolderId,
            Priority = "low",
            EisenhowerQuadrant = 1,
            IsRecurring = false,
            RecurrenceDays = ""
        };
        _isAddTaskModalOpen = true;
    }

    private void CloseAddTaskModal()
    {
        _isAddTaskModalOpen = false;
    }

    private void ToggleRecurrenceDay(string day)
    {
        var days = _newTask.RecurrenceDays?.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new List<string>();
        if (days.Contains(day)) days.Remove(day);
        else days.Add(day);
        _newTask.RecurrenceDays = string.Join(",", days);
    }

    private async Task SaveExpandedTask()
    {
        if (!string.IsNullOrWhiteSpace(_newTask.Title))
        {
            await TaskService.AddTaskAsync(_newTask);
        }
        _isAddTaskModalOpen = false;
    }

    private async Task ToggleTask(AppTask task)
    {
        await TaskService.ToggleTaskAsync(task);
    }

    private async Task DeleteTask(string id)
    {
        await TaskService.DeleteTaskAsync(id);
    }

    // --- Custom Drag and Drop ---
    private void HandleMouseDown(MouseEventArgs e, AppTask task)
    {
        if (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower)
        {
            _potentialDragTask = task;
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (_potentialDragTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            if (!_isDragging)
            {
                _draggedTask = _potentialDragTask;
                _isDragging = true;
            }
            _mouseX = e.ClientX - 140; 
            _mouseY = e.ClientY - 20;
        }
    }

    private void HandleColEnter(string colId)
    {
        _hoveredColId = colId;
    }

    private void HandleQuadEnter(int quad)
    {
        _hoveredQuad = quad;
    }

    private async Task HandleMouseUp(MouseEventArgs e)
    {
        if (_isDragging && _draggedTask != null)
        {
            if (_currentView == ViewMode.Kanban && !string.IsNullOrEmpty(_hoveredColId) && _draggedTask.ColumnId != _hoveredColId)
            {
                await TaskService.MoveTaskAsync(_draggedTask.Id, _hoveredColId);
            }
            else if (_currentView == ViewMode.Eisenhower && _hoveredQuad > 0 && _draggedTask.EisenhowerQuadrant != _hoveredQuad)
            {
                _draggedTask.EisenhowerQuadrant = _hoveredQuad;
                await TaskService.ToggleTaskAsync(_draggedTask); // SaveTask essentially, toggletask is wrong, let's update it in the code actually wait.
                // ToggleTask toggles IsDone. I'll just change the property and call _repository directly. Wait, the AddTaskAsync can be used to update it since it uses SaveTaskAsync!
                await TaskService.AddTaskAsync(_draggedTask); 
            }
        }
        
        _potentialDragTask = null;
        _draggedTask = null;
        _isDragging = false;
        _hoveredColId = "";
        _hoveredQuad = 0;
    }
}
