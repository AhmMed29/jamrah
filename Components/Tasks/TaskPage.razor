    private async Task SaveColEdit(KanbanColumn col)
    {
        if (string.IsNullOrWhiteSpace(_editColTitle))
        {
            _editColTitle = "بدون اسم";
        }
        await TaskService.RenameColumnAsync(col.Id, _editColTitle.Trim());
        _editingColId = "";
    }

    private async Task HandleColEditKeyDown(KeyboardEventArgs e, KanbanColumn col)
    {
        if (e.Key == "Enter")
        {
            await SaveColEdit(col);
        }
        else if (e.Key == "Escape")
        {
            _editingColId = "";
        }
    }

