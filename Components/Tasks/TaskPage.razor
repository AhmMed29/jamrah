    }

    // --- Task Actions ---
    private void OpenAddTaskModal(string? colId)
    {
        _targetColId = colId ?? (TaskService.Columns.OrderBy(c => c.Order).FirstOrDefault()?.Id ?? "");
        _newTask = new AppTask
        {
            ColumnId = _targetColId,
            FolderId = string.IsNullOrEmpty(_activeFolderId) ? "default-general" : _activeFolderId,
            Priority = "low",
            EisenhowerQuadrant = 1,
            IsRecurring = false,
            RecurrenceDays = ""
        };
        _isAddTaskModalOpen = true;
    }

    private void CloseAddTaskModal()
    {
        _isAddTaskModalOpen = false;
    }

    private void SetDailyRecurrence()
    {
        _newTask.RecurrenceDays = "0,1,2,3,4,5,6";
    }

    private void ToggleRecurrenceDay(string day)
    {
        var days = _newTask.RecurrenceDays?.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new List<string>();
        if (days.Contains(day)) days.Remove(day);
        else days.Add(day);
        _newTask.RecurrenceDays = string.Join(",", days);
    }

    private async Task SaveExpandedTask()
    {
        if (!string.IsNullOrWhiteSpace(_newTask.Title))
        {
            await TaskService.AddTaskAsync(_newTask);
        }
        _isAddTaskModalOpen = false;
    }

    private async Task ToggleTask(AppTask task)
    {
        await TaskService.ToggleTaskAsync(task);
    }

    private async Task DeleteTask(string id)
    {
        await TaskService.DeleteTaskAsync(id);
    }

    // --- Custom Drag and Drop ---
    private void HandleMouseDown(MouseEventArgs e, AppTask task)
    {
        if (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower)
        {
            _potentialDragTask = task;
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (_potentialDragTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            if (!_isDragging)
            {
                _draggedTask = _potentialDragTask;
                _isDragging = true;
            }
            _mouseX = e.ClientX - 140; 
            _mouseY = e.ClientY - 20;
        }
    }

    private void HandleColEnter(string colId)
    {
        _hoveredColId = colId;
    }

    private void HandleQuadEnter(int quad)
    {
        _hoveredQuad = quad;
    }

    private async Task HandleMouseUp(MouseEventArgs e)
    {
        if (_isDragging && _draggedTask != null)
        {
            if (_currentView == ViewMode.Kanban && !string.IsNullOrEmpty(_hoveredColId) && _draggedTask.ColumnId != _hoveredColId)
            {
                await TaskService.MoveTaskAsync(_draggedTask.Id, _hoveredColId);
            }
            else if (_currentView == ViewMode.Eisenhower && _hoveredQuad > 0 && _draggedTask.EisenhowerQuadrant != _hoveredQuad)
            {
                _draggedTask.EisenhowerQuadrant = _hoveredQuad;
                await TaskService.AddTaskAsync(_draggedTask);
            }
        }
        
        _potentialDragTask = null;
        _draggedTask = null;
        _isDragging = false;
        _hoveredColId = "";
        _hoveredQuad = 0;
    }
}
