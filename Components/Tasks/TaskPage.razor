@namespace Jamrah.Components.Tasks
@implements IDisposable
@inject Jamrah.Services.ITaskStateService TaskService
@using Jamrah.Models

<div class="tasks-page" dir="rtl" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp" @onclick="CloseContextMenu">

    <!-- Right Collapsible Sidebar -->
    <div class="task-right-sidebar @( _isRightSidebarCollapsed ? "collapsed" : "")">
        <div class="right-header"><span>لوحة جانبية</span></div>
        <div style="padding:12px; font-size:11px; color:var(--muted);">مساحة جانبية قابلة للطي — استخدم زر ☰ لإظهار/إخفاء</div>
    </div>

    <div class="main-content">
        @if (_isDragging && _draggedTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            <div class="kanban-task ghost-task" style="left: @(_mouseX)px; top: @(_mouseY)px;">
                <div class="task-header">
                    <input type="checkbox" checked="@_draggedTask.IsDone" disabled />
                    <span class="task-title">@_draggedTask.Title</span>
                </div>
            </div>
        }

        <div class="board-header">
            <button class="toggle-btn sidebar-toggle-btn" @onclick="ToggleRightSidebar"
                    title="@(_isRightSidebarCollapsed ? "فتح السايدبار" : "طي السايدبار")"
                    style="width:32px; padding:0;">@(_isRightSidebarCollapsed ? "☰" : "‹")</button>
            <span class="board-title">المهام</span>
            <div style="flex:1"></div>
            <div class="header-toggles">
                <button class="toggle-btn" @onclick="ToggleSortMode">@GetSortModeLabel()</button>
                <button class="toggle-btn" @onclick="ToggleViewMode">عرض: @GetViewModeLabel()</button>
            </div>
            <button class="add-col-btn" @onclick="AddNewColumn" style="visibility: @(_currentView == ViewMode.Kanban ? "visible" : "hidden")">+ إضافة عمود</button>
        </div>

        @if (_currentView == ViewMode.Kanban)
        {
            <div class="board-container">
                @foreach (var col in TaskService.Columns)
                {
                    var capturedCol = col;
                    <div class="kanban-column" @onmouseenter="() => HandleColEnter(capturedCol.Id)">
                        <div class="col-header">
                            @if (_editingColId == capturedCol.Id)
                            {
                                <input class="col-edit-input" value="@_editColTitle"
                                       @oninput="e => _editColTitle = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => HandleColEditKeyDown(e, capturedCol)"
                                       @onblur="() => SaveColEdit(capturedCol)" autofocus />
                            }
                            else
                            {
                                <span class="col-title" @onclick="() => StartEditingCol(capturedCol)">@capturedCol.Title</span>
                                <button class="col-delete-btn" @onclick="() => DeleteColumn(capturedCol.Id)">×</button>
                            }
                        </div>

                        <div class="col-body">
                            @foreach (var task in GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == capturedCol.Id)))
                            {
                                var capturedTask = task;
                                <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                     @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                    <div class="task-header">
                                        <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                        <span class="task-title">@capturedTask.Title</span>
                                    </div>
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            }
                        </div>

                        <div class="col-footer">
                            <button class="task-add-btn" @onclick="() => OpenAddTaskModal(capturedCol.Id)">+ إضافة مهمة</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_currentView == ViewMode.Eisenhower)
        {
            <div class="eisenhower-container">
                <div class="matrix-quadrant q1" @onmouseenter="() => HandleQuadEnter(1)">
                    <div class="quad-header" style="background: rgba(239,68,68,0.1); color: #EF4444; border-bottom-color: #EF4444;">ضروري ومهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 1)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q2" @onmouseenter="() => HandleQuadEnter(2)">
                    <div class="quad-header" style="background: rgba(59,130,246,0.1); color: #3B82F6; border-bottom-color: #3B82F6;">مهم وغير ضروري</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 2)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q3" @onmouseenter="() => HandleQuadEnter(3)">
                    <div class="quad-header" style="background: rgba(245,158,11,0.1); color: #F59E0B; border-bottom-color: #F59E0B;">ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 3)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q4" @onmouseenter="() => HandleQuadEnter(4)">
                    <div class="quad-header" style="background: rgba(107,114,128,0.1); color: #6B7280; border-bottom-color: #6B7280;">غير ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 4)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_currentView == ViewMode.All)
        {
            var morningTasks = GetMorningTasksForDate(_selectedDate);
            var todoTasks    = GetTodoTasksForDate(_selectedDate);
            var eveningTasks = GetEveningTasksForDate(_selectedDate);
            bool isPastDay   = _selectedDate.Date < DateTime.Today;

            <div class="list-container">

                <!-- Day Navigation Bar -->
                <div class="day-nav-bar">
                    <button class="day-nav-btn" @onclick="() => _selectedDate = _selectedDate.AddDays(-1)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                    <span class="day-nav-label @(_selectedDate.Date == DateTime.Today ? "today-label" : "")">@GetDayLabel()</span>
                    <button class="day-nav-btn" @onclick="() => _selectedDate = _selectedDate.AddDays(1)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                </div>

                <div class="list-add-section">
                    @if (!_isInlineAddOpen)
                    {
                        <button class="list-add-btn-full" @onclick="OpenInlineAdd">+ إضافة مهمة جديدة...</button>
                    }
                    else
                    {
                        <div class="inline-add-form">
                            <input class="minimal-input inline-title-input"
                                   value="@_newTask.Title"
                                   @oninput="e => _newTask.Title = e.Value?.ToString() ?? string.Empty"
                                   @onkeydown="HandleInlineKeyDown"
                                   placeholder="اسم المهمة..."
                                   @ref="_inlineTitleRef" />
                            <div class="inline-row">
                                <div class="inline-field">
                                    <label class="inline-label">الأولوية</label>
                                    <select class="minimal-input" @bind="_newTask.Priority">
                                        <option value="high">عالية</option>
                                        <option value="medium">متوسطة</option>
                                        <option value="low">منخفضة</option>
                                    </select>
                                </div>
                                <div class="inline-field">
                                    <label class="inline-label">أيزنهاور</label>
                                    <select class="minimal-input" @bind="_newTask.EisenhowerQuadrant">
                                        <option value="1">ضروري ومهم</option>
                                        <option value="2">مهم وغير ضروري</option>
                                        <option value="3">ضروري وغير مهم</option>
                                        <option value="4">غير ضروري وغير مهم</option>
                                    </select>
                                </div>
                            </div>
                            <div class="inline-row" style="align-items:center; gap:8px;">
                                <input type="checkbox" @bind="_newTask.IsRecurring" style="width:16px; height:16px;" />
                                <span style="font-size:12px; color:var(--muted);">متكررة؟</span>
                            </div>
                            @if (_newTask.IsRecurring)
                            {
                                <div class="days-row">
                                    <button class="day-btn @((_newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Split(',', StringSplitOptions.RemoveEmptyEntries).Length >= 7) ? "active" : "")" @onclick="SetDailyRecurrence">كل يوم</button>
                                    @foreach(var day in new[] { (0,"ح"),(1,"ن"),(2,"ث"),(3,"ر"),(4,"خ"),(5,"ج"),(6,"س") })
                                    {
                                        var isChecked2 = _newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Contains(day.Item1.ToString());
                                        <button class="day-btn @(isChecked2 ? "active" : "")" @onclick="() => ToggleRecurrenceDay(day.Item1.ToString())">@day.Item2</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="inline-row">
                                    <div class="inline-field">
                                        <label class="inline-label">التاريخ (اختياري)</label>
                                        <input type="date" class="minimal-input" @bind="_newTask.ScheduledDate" />
                                    </div>
                                    <div class="inline-field">
                                        <label class="inline-label">الوقت (اختياري)</label>
                                        <input type="time" class="minimal-input" value="@ScheduledTimeString" @onchange="OnTimeChanged" />
                                    </div>
                                </div>
                            }
                            <textarea class="minimal-input" rows="2" style="resize:vertical;"
                                      @bind="_newTask.Notes" placeholder="ملاحظات (اختياري)..."></textarea>
                            <div class="inline-actions">
                                <button class="modal-btn" @onclick="CloseInlineAdd">إلغاء</button>
                                <button class="modal-btn primary" @onclick="SaveInlineTask">إضافة ↵</button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Morning Section -->
                <div class="section-header @(_morningCollapsed ? "" : "open")" @onclick="() => _morningCollapsed = !_morningCollapsed">
                    <span class="section-arrow">@(_morningCollapsed ? "›" : "⌄")</span>
                    <span>مهام الصباح</span>
                    <span class="section-count">@morningTasks.Count</span>
                </div>
                @if (!_morningCollapsed)
                {
                    @foreach (var capturedTask in morningTasks)
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                            <span class="task-title">@capturedTask.Title</span>
                            @if (capturedTask.ScheduledTime.HasValue)
                            {
                                <span class="task-time-badge">@capturedTask.ScheduledTime.Value.ToString(@"hh\:mm")</span>
                            }
                            @if (capturedTask.IsRecurring) { <span class="task-recur-badge">متكررة</span> }
                            @if (!string.IsNullOrWhiteSpace(capturedTask.Notes)) { <span class="task-note-icon" title="@capturedTask.Notes">📝</span> }
                            @if (isPastDay)
                            {
                                <button class="carry-btn" title="تقديم لليوم" @onclick:stopPropagation="true" @onclick="() => CarryForwardTask(capturedTask)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </button>
                            }
                            <div class="task-menu-wrap" @onclick:stopPropagation="true">
                                <button class="task-menu-btn" @onclick="() => ToggleContextMenu(capturedTask.Id)">•••</button>
                                @if (_openContextMenuTaskId == capturedTask.Id)
                                {
                                    <div class="task-context-menu">
                                        <button @onclick="() => OpenEditModal(capturedTask)">تعديل</button>
                                        <button class="danger" @onclick="() => DeleteTask(capturedTask.Id)">حذف</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (morningTasks.Count == 0) { <div class="list-empty-hint">لا توجد مهام صباحية</div> }
                }

                <!-- TODO Section -->
                <div class="section-header @(_todoCollapsed ? "" : "open")" @onclick="() => _todoCollapsed = !_todoCollapsed">
                    <span class="section-arrow">@(_todoCollapsed ? "›" : "⌄")</span>
                    <span>مطلوب إنجازها</span>
                    <span class="section-count">@todoTasks.Count</span>
                </div>
                @if (!_todoCollapsed)
                {
                    @foreach (var capturedTask in todoTasks)
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                            <span class="task-title">@capturedTask.Title</span>
                            @if (capturedTask.IsRecurring) { <span class="task-recur-badge">متكررة</span> }
                            @if (!string.IsNullOrWhiteSpace(capturedTask.Notes)) { <span class="task-note-icon" title="@capturedTask.Notes">📝</span> }
                            @if (isPastDay)
                            {
                                <button class="carry-btn" title="تقديم لليوم" @onclick:stopPropagation="true" @onclick="() => CarryForwardTask(capturedTask)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </button>
                            }
                            <div class="task-menu-wrap" @onclick:stopPropagation="true">
                                <button class="task-menu-btn" @onclick="() => ToggleContextMenu(capturedTask.Id)">•••</button>
                                @if (_openContextMenuTaskId == capturedTask.Id)
                                {
                                    <div class="task-context-menu">
                                        <button @onclick="() => OpenEditModal(capturedTask)">تعديل</button>
                                        <button class="danger" @onclick="() => DeleteTask(capturedTask.Id)">حذف</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (todoTasks.Count == 0) { <div class="list-empty-hint">لا توجد مهام</div> }
                }

                <!-- Evening Section -->
                <div class="section-header @(_eveningCollapsed ? "" : "open")" @onclick="() => _eveningCollapsed = !_eveningCollapsed">
                    <span class="section-arrow">@(_eveningCollapsed ? "›" : "⌄")</span>
                    <span>مهام المساء</span>
                    <span class="section-count">@eveningTasks.Count</span>
                </div>
                @if (!_eveningCollapsed)
                {
                    @foreach (var capturedTask in eveningTasks)
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                            <span class="task-title">@capturedTask.Title</span>
                            @if (capturedTask.ScheduledTime.HasValue)
                            {
                                <span class="task-time-badge">@capturedTask.ScheduledTime.Value.ToString(@"hh\:mm")</span>
                            }
                            @if (capturedTask.ScheduledDate.HasValue)
                            {
                                <span class="task-date-badge">@capturedTask.ScheduledDate.Value.ToString("MM/dd")</span>
                            }
                            @if (capturedTask.IsRecurring) { <span class="task-recur-badge">متكررة</span> }
                            @if (!string.IsNullOrWhiteSpace(capturedTask.Notes)) { <span class="task-note-icon" title="@capturedTask.Notes">📝</span> }
                            @if (isPastDay)
                            {
                                <button class="carry-btn" title="تقديم لليوم" @onclick:stopPropagation="true" @onclick="() => CarryForwardTask(capturedTask)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </button>
                            }
                            <div class="task-menu-wrap" @onclick:stopPropagation="true">
                                <button class="task-menu-btn" @onclick="() => ToggleContextMenu(capturedTask.Id)">•••</button>
                                @if (_openContextMenuTaskId == capturedTask.Id)
                                {
                                    <div class="task-context-menu">
                                        <button @onclick="() => OpenEditModal(capturedTask)">تعديل</button>
                                        <button class="danger" @onclick="() => DeleteTask(capturedTask.Id)">حذف</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (eveningTasks.Count == 0) { <div class="list-empty-hint">لا توجد مهام مسائية</div> }
                }

            </div>
        }
        else // Done, Pending
        {
            <div class="list-container">
                <div class="list-add-section">
                    <button class="list-add-btn-full" @onclick="() => OpenAddTaskModal(null)">+ إضافة مهمة جديدة...</button>
                </div>
                <div class="list-items">
                    @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks))
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                            <span class="task-title">@capturedTask.Title</span>
                            <div class="task-menu-wrap" @onclick:stopPropagation="true">
                                <button class="task-menu-btn" @onclick="() => ToggleContextMenu(capturedTask.Id)">•••</button>
                                @if (_openContextMenuTaskId == capturedTask.Id)
                                {
                                    <div class="task-context-menu">
                                        <button @onclick="() => OpenEditModal(capturedTask)">تعديل</button>
                                        <button class="danger" @onclick="() => DeleteTask(capturedTask.Id)">حذف</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (_isAddTaskModalOpen)
{
    <div class="modal-overlay" style="display:flex; pointer-events:auto;">
        <div class="modal-box" style="width: 450px;">
            <div class="modal-header">
                <span class="modal-title">مهمة جديدة</span>
                <button class="close-btn" @onclick="CloseAddTaskModal">X</button>
            </div>
            
            <div class="input-group">
                <label>اسم المهمة</label>
                <input class="minimal-input" @bind="_newTask.Title" placeholder="اكتب اسم المهمة..." autofocus />
            </div>

            <div class="input-group">
                <label>الأولوية</label>
                <select class="minimal-input" @bind="_newTask.Priority">
                    <option value="high">عالية</option>
                    <option value="medium">متوسطة</option>
                    <option value="low">منخفضة</option>
                </select>
            </div>

            <div class="input-group">
                <label>مصفوفة أيزنهاور</label>
                <select class="minimal-input" @bind="_newTask.EisenhowerQuadrant">
                    <option value="1">ضروري ومهم</option>
                    <option value="2">مهم وغير ضروري</option>
                    <option value="3">ضروري وغير مهم</option>
                    <option value="4">غير ضروري وغير مهم</option>
                </select>
            </div>

            <div class="input-group" style="flex-direction:row; gap:12px; align-items:center;">
                <input type="checkbox" @bind="_newTask.IsRecurring" style="width: 18px; height: 18px;" />
                <label style="margin:0; font-size:14px;">مهمة متكررة؟</label>
            </div>

            @if (_newTask.IsRecurring)
            {
                <div class="input-group">
                    <label>أيام التكرار</label>
                    <div class="days-row">
                        <button class="day-btn @((_newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Split(',', StringSplitOptions.RemoveEmptyEntries).Length >= 7) ? "active" : "")" @onclick="SetDailyRecurrence">كل يوم</button>
                        @foreach(var day in new[] { (0,"ح"),(1,"ن"),(2,"ث"),(3,"ر"),(4,"خ"),(5,"ج"),(6,"س") })
                        {
                            var isChecked = _newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Contains(day.Item1.ToString());
                            <button class="day-btn @(isChecked ? "active" : "")" @onclick="() => ToggleRecurrenceDay(day.Item1.ToString())">@day.Item2</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="input-group">
                    <label>التاريخ (اختياري)</label>
                    <input type="date" class="minimal-input" @bind="_newTask.ScheduledDate" />
                </div>
            }

            <div class="input-group">
                <label>الوقت (اختياري)</label>
                <input type="time" class="minimal-input" value="@ScheduledTimeString" @onchange="OnTimeChanged" />
            </div>

            <div class="input-group">
                <label>ملاحظات (اختياري)</label>
                <textarea class="minimal-input" rows="2" style="resize:vertical;" @bind="_newTask.Notes" placeholder="أي ملاحظات..."></textarea>
            </div>

            <div class="modal-actions" style="margin-top:12px;">
                <button class="modal-btn" @onclick="CloseAddTaskModal">إلغاء</button>
                <button class="modal-btn primary" @onclick="SaveExpandedTask">إضافة المهمة</button>
            </div>
        </div>
    </div>
}

