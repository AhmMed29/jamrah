    }

    // --- Custom Drag and Drop ---
    private void HandleMouseDown(MouseEventArgs e, AppTask task)
    {
        if (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower)
        {
            _potentialDragTask = task;
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (_potentialDragTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            if (!_isDragging)
            {
                _draggedTask = _potentialDragTask;
                _isDragging = true;
            }
            _mouseX = e.ClientX - 140; 
            _mouseY = e.ClientY - 20;
        }
    }

    private void HandleColEnter(string colId)
    {
        _hoveredColId = colId;
    }

    private void HandleQuadEnter(int quad)
    {
        _hoveredQuad = quad;
    }

    private async Task HandleMouseUp(MouseEventArgs e)
    {
        if (_isDragging && _draggedTask != null)
        {
            if (_currentView == ViewMode.Kanban && !string.IsNullOrEmpty(_hoveredColId) && _draggedTask.ColumnId != _hoveredColId)
            {
                await TaskService.MoveTaskAsync(_draggedTask.Id, _hoveredColId);
            }
            else if (_currentView == ViewMode.Eisenhower && _hoveredQuad > 0 && _draggedTask.EisenhowerQuadrant != _hoveredQuad)
            {
                _draggedTask.EisenhowerQuadrant = _hoveredQuad;
                await TaskService.AddTaskAsync(_draggedTask);
            }
        }
        
        _potentialDragTask = null;
        _draggedTask = null;
        _isDragging = false;
        _hoveredColId = "";
        _hoveredQuad = 0;
    }
}
