@namespace Jamrah.Components.Tasks
@implements IDisposable
@inject Jamrah.Services.ITaskStateService TaskService
@using Jamrah.Models

<div class="tasks-page" dir="rtl" @onmousemove="HandleMouseMove" @onmouseup="HandleMouseUp" @onmouseleave="HandleMouseUp">

    <!-- Right Collapsible Sidebar -->
    <div class="task-right-sidebar @( _isRightSidebarCollapsed ? "collapsed" : "")">
        <div class="right-header"><span>لوحة جانبية</span><button class="toggle-btn" style="width:24px; height:24px; padding:0;" @onclick="ToggleRightSidebar">‹</button></div>
        <div style="padding:12px; font-size:11px; color:var(--muted);">مساحة جانبية قابلة للطي — استخدم زر ☰ لإظهار/إخفاء</div>
    </div>

    <div class="main-content">
        @if (_isDragging && _draggedTask != null && (_currentView == ViewMode.Kanban || _currentView == ViewMode.Eisenhower))
        {
            <div class="kanban-task ghost-task" style="left: @(_mouseX)px; top: @(_mouseY)px;">
                <div class="task-header">
                    <input type="checkbox" checked="@_draggedTask.IsDone" disabled />
                    <span class="task-title">@_draggedTask.Title</span>
                </div>
            </div>
        }

        <div class="board-header">
            <button class="toggle-btn" @onclick="ToggleRightSidebar" title="طي السايدبار" style="width:32px; padding:0;">☰</button>
            <span class="board-title">المهام</span>
            <div style="flex:1"></div>
            <div class="header-toggles">
                <button class="toggle-btn" @onclick="ToggleSortMode">@GetSortModeLabel()</button>
                <button class="toggle-btn" @onclick="ToggleViewMode">عرض: @GetViewModeLabel()</button>
            </div>
            <button class="add-col-btn" @onclick="AddNewColumn" style="visibility: @(_currentView == ViewMode.Kanban ? "visible" : "hidden")">+ إضافة عمود</button>
        </div>

        @if (_currentView == ViewMode.Kanban)
        {
            <div class="board-container">
                @foreach (var col in TaskService.Columns)
                {
                    var capturedCol = col;
                    <div class="kanban-column" @onmouseenter="() => HandleColEnter(capturedCol.Id)">
                        <div class="col-header">
                            @if (_editingColId == capturedCol.Id)
                            {
                                <input class="col-edit-input" value="@_editColTitle"
                                       @oninput="e => _editColTitle = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => HandleColEditKeyDown(e, capturedCol)"
                                       @onblur="() => SaveColEdit(capturedCol)" autofocus />
                            }
                            else
                            {
                                <span class="col-title" @onclick="() => StartEditingCol(capturedCol)">@capturedCol.Title</span>
                                <button class="col-delete-btn" @onclick="() => DeleteColumn(capturedCol.Id)">×</button>
                            }
                        </div>

                        <div class="col-body">
                            @foreach (var task in GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == capturedCol.Id)))
                            {
                                var capturedTask = task;
                                <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                     @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                    <div class="task-header">
                                        <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                        <span class="task-title">@capturedTask.Title</span>
                                    </div>
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            }
                        </div>

                        <div class="col-footer">
                            <button class="task-add-btn" @onclick="() => OpenAddTaskModal(capturedCol.Id)">+ إضافة مهمة</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_currentView == ViewMode.Eisenhower)
        {
            <div class="eisenhower-container">
                <div class="matrix-quadrant q1" @onmouseenter="() => HandleQuadEnter(1)">
                    <div class="quad-header" style="background: rgba(239,68,68,0.1); color: #EF4444; border-bottom-color: #EF4444;">ضروري ومهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 1)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q2" @onmouseenter="() => HandleQuadEnter(2)">
                    <div class="quad-header" style="background: rgba(59,130,246,0.1); color: #3B82F6; border-bottom-color: #3B82F6;">مهم وغير ضروري</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 2)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q3" @onmouseenter="() => HandleQuadEnter(3)">
                    <div class="quad-header" style="background: rgba(245,158,11,0.1); color: #F59E0B; border-bottom-color: #F59E0B;">ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 3)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="matrix-quadrant q4" @onmouseenter="() => HandleQuadEnter(4)">
                    <div class="quad-header" style="background: rgba(107,114,128,0.1); color: #6B7280; border-bottom-color: #6B7280;">غير ضروري وغير مهم</div>
                    <div class="quad-body">
                        @foreach(var t in GetFilteredAndSortedTasks(TaskService.Tasks.Where(x => x.EisenhowerQuadrant == 4)))
                        {
                            var capturedTask = t;
                            <div @key="capturedTask.Id" class="kanban-task @(capturedTask.IsDone ? "done" : "") @(_draggedTask == capturedTask ? "dragging-original" : "")"
                                 @onmousedown="e => HandleMouseDown(e, capturedTask)">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_currentView == ViewMode.All)
        {
            <div class="split-view-container">
                <div class="split-side todo-side">
                    <div class="split-header">المهام العادية (TO-DO)</div>
                    <div class="list-add-section">
                        <button class="list-add-btn-full" @onclick="() => OpenAddTaskModal(null)">إضافة مهمة جديدة...</button>
                    </div>
                    <div class="list-items">
                        @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks).Where(t => !t.IsRecurring && t.ScheduledDate == null))
                        {
                            <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <div class="task-meta">
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="split-side scheduled-side">
                    <div class="split-header">المهام المجدولة والمتكررة</div>
                    <div class="list-items">
                        @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks).Where(t => t.IsRecurring || t.ScheduledDate != null))
                        {
                            <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                                <div class="task-header">
                                    <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                    <span class="task-title">@capturedTask.Title</span>
                                </div>
                                <div class="task-meta">
                                    @if(capturedTask.IsRecurring) { <span class="task-badge recurring-badge">متكررة</span> }
                                    @if(capturedTask.ScheduledDate.HasValue) { <span class="task-date">@capturedTask.ScheduledDate.Value.ToString("yyyy-MM-dd")</span> }
                                    @if(capturedTask.ScheduledTime.HasValue) { <span class="task-time">@capturedTask.ScheduledTime.Value.ToString(@"hh\:mm")</span> }
                                    <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else // Done, Pending
        {
            <div class="list-container">
                <div class="list-add-section">
                    <button class="list-add-btn-full" @onclick="() => OpenAddTaskModal(null)">إضافة مهمة جديدة...</button>
                </div>
                <div class="list-items">
                    @foreach (var capturedTask in GetFilteredAndSortedTasks(TaskService.Tasks))
                    {
                        <div @key="capturedTask.Id" class="kanban-task list-task @(capturedTask.IsDone ? "done" : "")">
                            <div class="task-header">
                                <input type="checkbox" checked="@capturedTask.IsDone" @onchange="() => ToggleTask(capturedTask)" />
                                <span class="task-title">@capturedTask.Title</span>
                            </div>
                            <div class="task-meta">
                                @if(capturedTask.DueDate.HasValue) { <span class="task-date">@capturedTask.DueDate.Value.ToString("yyyy-MM-dd")</span> }
                                <button class="task-delete-btn" @onclick="() => DeleteTask(capturedTask.Id)">×</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (_isAddTaskModalOpen)
{
    <div class="modal-overlay" style="display:flex; pointer-events:auto;">
        <div class="modal-box" style="width: 450px;">
            <div class="modal-header">
                <span class="modal-title">مهمة جديدة</span>
                <button class="close-btn" @onclick="CloseAddTaskModal">X</button>
            </div>
            
            <div class="input-group">
                <label>اسم المهمة</label>
                <input class="minimal-input" @bind="_newTask.Title" placeholder="اكتب اسم المهمة..." autofocus />
            </div>

            <div class="input-group">
                <label>الأولوية</label>
                <select class="minimal-input" @bind="_newTask.Priority">
                    <option value="high">عالية</option>
                    <option value="medium">متوسطة</option>
                    <option value="low">منخفضة</option>
                </select>
            </div>

            <div class="input-group">
                <label>مصفوفة أيزنهاور</label>
                <select class="minimal-input" @bind="_newTask.EisenhowerQuadrant">
                    <option value="1">ضروري ومهم</option>
                    <option value="2">مهم وغير ضروري</option>
                    <option value="3">ضروري وغير مهم</option>
                    <option value="4">غير ضروري وغير مهم</option>
                </select>
            </div>

            <div class="input-group" style="flex-direction:row; gap:12px; align-items:center;">
                <input type="checkbox" @bind="_newTask.IsRecurring" style="width: 18px; height: 18px;" />
                <label style="margin:0; font-size:14px;">مهمة متكررة؟</label>
            </div>

            @if (_newTask.IsRecurring)
            {
                <div class="input-group">
                    <label>أيام التكرار</label>
                    <div class="days-row">
                        <button class="day-btn" style="width: auto; padding: 0 10px; margin-left: 4px;" @onclick="SetDailyRecurrence">كل يوم</button>
                        @foreach(var day in new[] { (0,"ح"),(1,"ن"),(2,"ث"),(3,"ر"),(4,"خ"),(5,"ج"),(6,"س") })
                        {
                            var isChecked = _newTask.RecurrenceDays != null && _newTask.RecurrenceDays.Contains(day.Item1.ToString());
                            <button class="day-btn @(isChecked ? "active" : "")" @onclick="() => ToggleRecurrenceDay(day.Item1.ToString())">@day.Item2</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="input-group" style="flex-direction:row; gap:12px;">
                    <div style="flex:1;">
                        <label>التاريخ (اختياري)</label>
                        <input type="date" class="minimal-input" @bind="_newTask.ScheduledDate" />
                    </div>
                    <div style="flex:1;">
                        <label>الوقت (اختياري)</label>
                        <input type="time" class="minimal-input" value="@ScheduledTimeString" @onchange="OnTimeChanged" />
                    </div>
                </div>
            }

            <div class="modal-actions" style="margin-top:20px;">
                <button class="modal-btn" @onclick="CloseAddTaskModal">إلغاء</button>
                <button class="modal-btn primary" @onclick="SaveExpandedTask">إضافة المهمة</button>
            </div>
        </div>
    </div>
}

<style>
    *{ font-family:'Tajawal',sans-serif !important; }
    :root { --bg:#FAFAF9; --card:#FFFFFF; --card2:#F5F5F4; --border:#E7E5E4; --border2:#D6D3D1; --text:#1C1917; --muted:#78716C; --accent:#FF6B35; --green:#16A34A; --blue:#2563EB; --red:#DC2626; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    .tasks-page { height: 100vh; display: flex; flex-direction: row; background:var(--bg); color:var(--text); position:relative; overflow:hidden; gap:0; }
    .main-content { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
    .board-header { padding:10px 16px; display:flex; gap:8px; align-items:center; border-bottom:1px solid var(--border); background:var(--card); }
    .board-title { font-size:14px; font-weight:700; color:var(--text); flex:1; }
    .header-toggles { display:flex; gap:6px; }
    .toggle-btn { height:32px; padding:0 12px; border-radius:10px; border:1px solid var(--border); background:var(--card); color:var(--text); cursor:pointer; font-size:12px; }
    .toggle-btn:hover{ background:var(--card2); }
    .add-col-btn { height:32px; padding:0 12px; border-radius:10px; border:1px solid var(--border); background:var(--text); color:#fff; cursor:pointer; font-size:12px; font-weight:500; }
    .add-col-btn:hover{ opacity:.9; }
    .board-container { flex:1; display:flex; gap:12px; padding:12px; overflow-x:auto; align-items:flex-start; background:var(--bg); }
    .board-container::-webkit-scrollbar{ height:8px; } .board-container::-webkit-scrollbar-thumb{ background:var(--border2); border-radius:4px; }
    .kanban-column { min-width:272px; width:272px; background:var(--card2); border:1px solid var(--border); border-radius:14px; display:flex; flex-direction:column; max-height:100%; flex-shrink:0; }
    .col-header { padding:10px 12px; display:flex; align-items:center; gap:6px; }
    .col-title { font-weight:700; cursor:pointer; flex:1; font-size:12px; color:var(--text); }
    .col-delete-btn { background:none; border:none; cursor:pointer; font-size:14px; color:var(--muted); width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; }
    .col-delete-btn:hover{ background:var(--red); color:#fff; }
    .col-edit-input { flex:1; border:1px solid var(--border); background:var(--card); padding:6px 8px; border-radius:8px; outline:none; font-size:12px; }
    .col-body { margin:0 8px; padding:8px; background:var(--card); border:1px solid var(--border); border-radius:12px; flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:8px; min-height:80px; }
    .col-body::-webkit-scrollbar{ width:4px; } .col-body::-webkit-scrollbar-thumb{ background:var(--border2); }
    .col-body.drag-over{ border-color:var(--accent); background:#FFF7ED; }
    .kanban-task { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:10px; display:flex; flex-direction:column; gap:6px; cursor:grab; box-shadow:0 1px 2px rgba(0,0,0,.04); transition:all .15s; user-select:none; }
    .kanban-task:active{ cursor:grabbing; transform:rotate(1deg); } .kanban-task.done{ opacity:.6; } .kanban-task.done .task-title{ text-decoration:line-through; color:var(--muted); } .kanban-task.dragging-original{ opacity:.3; }
    .ghost-task{ position:fixed; pointer-events:none; z-index:9999; width:272px; box-shadow:0 8px 24px rgba(0,0,0,.12); transform:rotate(2deg); opacity:.95; }
    .task-header{ display:flex; gap:8px; align-items:flex-start; flex:1; } .task-title{ word-break:break-word; font-size:12px; font-weight:500; line-height:1.4; }
    .task-delete-btn{ background:none; border:none; cursor:pointer; font-size:14px; color:var(--muted); width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; opacity:0; }
    .kanban-task:hover .task-delete-btn{ opacity:1; } .task-delete-btn:hover{ background:var(--red); color:#fff; }
    .col-footer{ padding:8px; } .task-add-btn{ width:100%; height:30px; border:1px dashed var(--border2); border-radius:10px; background:var(--card); color:var(--muted); cursor:pointer; font-size:11px; }
    .task-add-btn:hover{ border-color:var(--text); color:var(--text); }
    .list-container{ flex:1; padding:16px; overflow-y:auto; display:flex; flex-direction:column; gap:12px; background:var(--bg); }
    .list-add-btn-full{ width:100%; border:1px dashed var(--border2); padding:10px; border-radius:10px; background:var(--card); cursor:pointer; text-align:center; color:var(--muted); font-size:12px; }
    .eisenhower-container{ flex:1; display:grid; grid-template-columns:1fr 1fr; grid-template-rows:1fr 1fr; gap:12px; padding:12px; overflow-y:auto; background:var(--bg); }
    .matrix-quadrant{ border:1px solid var(--border); border-radius:14px; display:flex; flex-direction:column; background:var(--card); overflow:hidden; }
    .quad-header{ padding:10px; font-weight:700; border-bottom:1px solid var(--border); text-align:center; font-size:11px; }
    .quad-body{ padding:8px; display:flex; flex-direction:column; gap:6px; overflow-y:auto; flex:1; min-height:80px; background:var(--bg); }
    .split-view-container{ flex:1; display:grid; grid-template-columns:1fr 1fr; gap:16px; padding:12px; overflow-y:auto; background:var(--bg); }
    .split-side{ display:flex; flex-direction:column; gap:8px; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:10px; }
    .task-right-sidebar{ width:260px; background:var(--card); border-left:1px solid var(--border); display:flex; flex-direction:column; flex-shrink:0; transition:width .25s ease, border-width .25s ease; overflow:hidden; }
    .task-right-sidebar.collapsed{ width:0; border-left-width:0; }
    .right-header{ padding:12px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); font-size:12px; font-weight:700; }
    .modal-overlay{ position:fixed; inset:0; background:rgba(28,25,23,.22); backdrop-filter:blur(4px); z-index:99; display:flex; align-items:center; justify-content:center; }
    .modal-box{ background:var(--card); border:1px solid var(--border); border-radius:16px; padding:16px; width:420px; display:flex; flex-direction:column; gap:10px; box-shadow:0 20px 40px rgba(0,0,0,.06); }
    .modal-header{ display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:10px; }
    .modal-title{ font-weight:700; font-size:13px; color:var(--text); }
    .close-btn{ width:28px; height:28px; border-radius:50%; border:1px solid var(--border); background:var(--card); display:flex; align-items:center; justify-content:center; cursor:pointer; }
    .input-group label{ font-size:11px; color:var(--muted); font-weight:700; }
    .minimal-input{ background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:8px 10px; outline:none; font-size:12px; }
    .modal-actions{ display:flex; gap:6px; justify-content:flex-end; margin-top:4px; }
    .modal-btn{ height:32px; padding:0 12px; border-radius:10px; border:1px solid var(--border); background:var(--card); cursor:pointer; font-size:12px; }
    .modal-btn.primary{ background:var(--text); color:#fff; border-color:var(--text); }
</style>

@code {
    private enum ViewMode { Kanban, Eisenhower, All, Done, Pending }
    private enum SortMode { Newest, Oldest, ByDate, ByPriority }

    private ViewMode _currentView = ViewMode.Kanban;
    private SortMode _currentSort = SortMode.Newest;

    private string _editingColId = "";
    private string _editColTitle = "";

    private string _activeFolderId = ""; // folders removed, show all
    private bool _isRightSidebarCollapsed = false;
    private void ToggleRightSidebar() => _isRightSidebarCollapsed = !_isRightSidebarCollapsed;

    private bool _isAddTaskModalOpen = false;
    private string _targetColId = "";
    private AppTask _newTask = new AppTask();

    private string ScheduledTimeString => _newTask.ScheduledTime?.ToString(@"hh\:mm") ?? "";

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            _newTask.ScheduledTime = ts;
        else
            _newTask.ScheduledTime = null;
    }

    // --- Custom Drag & Drop State ---
    private AppTask? _potentialDragTask;
    private AppTask? _draggedTask;
    private bool _isDragging;
    private double _mouseX;
    private double _mouseY;
    private string _hoveredColId = "";
    private int _hoveredQuad = 0;

    protected override async Task OnInitializedAsync()
    {
        TaskService.OnStateChanged += HandleStateChanged;
        await TaskService.InitAsync();
        
        // Ensure active folder points to a valid ID or empty.
        if (TaskService.Folders.Count > 0 && !TaskService.Folders.Any(f => f.Id == _activeFolderId))
        {
            _activeFolderId = TaskService.Folders.First().Id;
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TaskService.OnStateChanged -= HandleStateChanged;
    }

    // --- View and Sort Toggles ---
    private void ToggleViewMode()
    {
        _currentView = _currentView switch
        {
            ViewMode.Kanban => ViewMode.Eisenhower,
            ViewMode.Eisenhower => ViewMode.All,
            ViewMode.All => ViewMode.Done,
            ViewMode.Done => ViewMode.Pending,
            ViewMode.Pending => ViewMode.Kanban,
            _ => ViewMode.Kanban
        };
    }

    private string GetViewModeLabel()
    {
        return _currentView switch
        {
            ViewMode.Kanban => "Kanban",
            ViewMode.Eisenhower => "مصفوفة أيزنهاور",
            ViewMode.All => "الكل",
            ViewMode.Done => "المكتملة",
            ViewMode.Pending => "قيد التنفيذ",
            _ => "Kanban"
        };
    }

    private void ToggleSortMode()
    {
        _currentSort = _currentSort switch
        {
            SortMode.Newest => SortMode.Oldest,
            SortMode.Oldest => SortMode.ByDate,
            SortMode.ByDate => SortMode.ByPriority,
            SortMode.ByPriority => SortMode.Newest,
            _ => SortMode.Newest
        };
    }

    private string GetSortModeLabel()
    {
        return _currentSort switch
        {
            SortMode.Newest => "ترتيب: الأحدث",
            SortMode.Oldest => "ترتيب: الأقدم",
            SortMode.ByDate => "ترتيب: حسب التاريخ",
            SortMode.ByPriority => "ترتيب: حسب الأولوية",
            _ => "ترتيب: الأحدث"
        };
    }

    private IEnumerable<AppTask> GetFilteredAndSortedTasks(IEnumerable<AppTask> input)
    {
        var filtered = input;

        if (!string.IsNullOrEmpty(_activeFolderId))
        {
            filtered = filtered.Where(t => t.FolderId == _activeFolderId);
        }
        
        if (_currentView == ViewMode.Done)
        {
            filtered = filtered.Where(t => t.IsDone);
        }
        else if (_currentView == ViewMode.Pending)
        {
            filtered = filtered.Where(t => !t.IsDone);
        }

        return _currentSort switch
        {
            SortMode.Newest => filtered.OrderByDescending(t => t.CreatedAt),
            SortMode.Oldest => filtered.OrderBy(t => t.CreatedAt),
            SortMode.ByDate => filtered.OrderBy(t => !t.ScheduledDate.HasValue).ThenBy(t => t.ScheduledDate),
            SortMode.ByPriority => filtered.OrderBy(t => GetPriorityValue(t.Priority)),
            _ => filtered.OrderByDescending(t => t.CreatedAt)
        };
    }

    private IEnumerable<AppTask> GetFilteredTasks(string colId)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.ColumnId == colId));
    }

    private IEnumerable<AppTask> GetFilteredTasksEisenhower(int quadrant)
    {
        return GetFilteredAndSortedTasks(TaskService.Tasks.Where(t => t.EisenhowerQuadrant == quadrant));
    }

    private int GetPriorityValue(string priority)
    {
        return (priority?.ToLower()) switch
        {
            "high" => 1,
            "medium" => 2,
            "low" => 3,
            _ => 3
        };
    }

