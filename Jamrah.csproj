<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net9.0-windows10.0.19041.0;net9.0-android</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Jamrah</RootNamespace>
		<UseMaui>true</UseMaui>
		<UseMauiRazor>true</UseMauiRazor>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Jamrah</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.jamrah</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>4.3.0</ApplicationDisplayVersion>
		<ApplicationVersion>6</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<DefaultItemExcludes>$(DefaultItemExcludes);.worktrees\**;ClipAgent\**</DefaultItemExcludes>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#FAFAF9" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\appicon.svg" Color="#FAFAF9" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
		<PackageReference Include="Markdig" Version="0.37.0" />
	</ItemGroup>

	<Target Name="BuildClipAgent" BeforeTargets="BeforeBuild" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('windows')) And '$(DesignTimeBuild)' != 'true'">
		<Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\ClipAgent\ClipAgent.csproj&quot; -c $(Configuration) --nologo -v:q" />
	</Target>

	<!-- Dev-loop helper (revert: delete this Target): kill the running ClipAgent before copy,
	     otherwise the copy below fails with MSB3021/3027 file-lock errors on every build.
	     The agent auto-restarts on next app launch. ContinueOnError covers "not running". -->
	<Target Name="KillClipAgentBeforeCopy" BeforeTargets="CopyClipAgent" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('windows'))">
		<Exec Command="taskkill /F /IM ClipAgent.exe" ContinueOnError="true" />
	</Target>

	<Target Name="CopyClipAgent" AfterTargets="Build" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('windows'))">
		<ItemGroup>
			<ClipAgentBin Include="ClipAgent\bin\$(Configuration)\net9.0-windows10.0.19041.0\ClipAgent.exe;ClipAgent\bin\$(Configuration)\net9.0-windows10.0.19041.0\ClipAgent.runtimeconfig.json;ClipAgent\bin\$(Configuration)\net9.0-windows10.0.19041.0\*.dll" />
			<ClipAgentNative Include="ClipAgent\bin\$(Configuration)\net9.0-windows10.0.19041.0\runtimes\win-x64\native\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ClipAgentBin)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(ClipAgentNative)" DestinationFolder="$(OutputPath)runtimes\win-x64\native\" SkipUnchangedFiles="true" />
	</Target>

</Project>
