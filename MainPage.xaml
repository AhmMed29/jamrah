<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jamrah.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="ShellGrid" ColumnDefinitions="250, *">

        <!-- ① السايدبار الموحد (Global Minimal Sidebar) -->
        <Grid x:Name="SidebarGrid"
              Grid.Column="0"
              Background="#F7F6F3"
              ZIndex="10">

            <!-- خط فاصل على اليمين -->
            <BoxView HorizontalOptions="End"
                     WidthRequest="1"
                     VerticalOptions="Fill"
                     Background="#E9E6E0" />

            <VerticalStackLayout Padding="0,14,0,0"
                                 Spacing="1"
                                 VerticalOptions="Start">

                <!-- Brand -->
                <HorizontalStackLayout x:Name="BrandRow"
                                       Padding="16,4,12,12"
                                       Spacing="10"
                                       VerticalOptions="Center">
                    <Border WidthRequest="25"
                            HeightRequest="25"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 7"
                            Background="#181715"
                            VerticalOptions="Center">
                        <Label Text="J"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="BrandName"
                           Text="Jamrah"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#181715"
                           VerticalOptions="Center" />
                    <Border x:Name="CollapseBorder"
                            WidthRequest="26"
                            HeightRequest="26"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Background="Transparent"
                            HorizontalOptions="EndAndExpand"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSidebarCollapseTapped" />
                            <PointerGestureRecognizer PointerEntered="OnCollapseBtnEnter"
                                                      PointerExited="OnCollapseBtnExit" />
                        </Border.GestureRecognizers>
                        <Path x:Name="CollapseIcon"
                              Data="M15.41,7.41 L14,6 L8,12 L14,18 L15.41,16.59 L10.83,12 Z"
                              Fill="#A5A199"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="16"
                              WidthRequest="16" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Section -->
                <Label x:Name="MenuSectionLbl"
                       Text=""
                       FontSize="10.5"
                       FontAttributes="Bold"
                       TextColor="#A5A199"
                       Margin="17,4,0,5" />

                <!-- Tasks -->
                <Border x:Name="TasksBtnBorder"
                        Margin="8,1"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Background="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMyTasksTapped" />
                        <PointerGestureRecognizer PointerEntered="OnTasksBtnEnter"
                                                  PointerExited="OnTasksBtnExit" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout x:Name="TasksBtnRow" Spacing="9" VerticalOptions="Center">
                        <Path x:Name="TasksIcon"
                              Data="M3,13 L5,13 L5,11 L3,11 L3,13 Z M3,17 L5,17 L5,15 L3,15 L3,17 Z M3,9 L5,9 L5,7 L3,7 L3,9 Z M7,13 L21,13 L21,11 L7,11 L7,13 Z M7,17 L21,17 L21,15 L7,15 L7,17 Z M7,7 L7,9 L21,9 L21,7 L7,7 Z"
                              Fill="#59554E"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="20"
                              WidthRequest="20" />
                        <Label x:Name="TasksLbl"
                               Text="Tasks"
                               FontSize="13.5"
                               TextColor="#59554E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Pomodoro -->
                <Border x:Name="PomoBtnBorder"
                        Margin="8,1"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Background="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPomodoroTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPomoBtnEnter"
                                                  PointerExited="OnPomoBtnExit" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout x:Name="PomoBtnRow" Spacing="9" VerticalOptions="Center">
                        <Path x:Name="PomoIcon"
                              Data="M15,1 L9,1 L9,3 L15,3 L15,1 Z M11,14 L13,14 L13,8 L11,8 L11,14 Z M19.03,7.39 L20.45,5.97 C20.02,5.46 19.55,4.98 19.04,4.56 L17.62,5.98 C16.07,4.74 14.12,4 12,4 C7.03,4 3,8.03 3,13 C3,17.97 7.02,22 12,22 C16.98,22 21,17.97 21,13 C21,10.88 20.26,8.93 19.03,7.39 Z M12,20 C8.13,20 5,16.87 5,13 C5,9.13 8.13,6 12,6 C15.87,6 19,9.13 19,13 C19,16.87 15.87,20 12,20 Z"
                              Fill="#59554E"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="20"
                              WidthRequest="20" />
                        <Label x:Name="PomoLbl"
                               Text="Pomodoro"
                               FontSize="13.5"
                               TextColor="#59554E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Calendar -->
                <Border x:Name="CalBtnBorder"
                        Margin="8,1"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Background="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarMonthTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCalBtnEnter"
                                                  PointerExited="OnCalBtnExit" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout x:Name="CalBtnRow" Spacing="9" VerticalOptions="Center">
                        <Path x:Name="CalIcon"
                              Data="M20,3 L19,3 L19,1 L17,1 L17,3 L7,3 L7,1 L5,1 L5,3 L4,3 C2.9,3 2,3.9 2,5 L2,21 C2,22.1 2.9,23 4,23 L20,23 C21.1,23 22,22.1 22,21 L22,5 C22,3.9 21.1,3 20,3 Z M20,21 L4,21 L4,8 L20,8 L20,21 Z"
                              Fill="#59554E"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="20"
                              WidthRequest="20" />
                        <Label x:Name="CalLbl"
                               Text="Calendar"
                               FontSize="13.5"
                               TextColor="#59554E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Planning -->
                <Border x:Name="PlanningBtnBorder"
                        Margin="8,1"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Background="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlanningTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPlanningBtnEnter"
                                                  PointerExited="OnPlanningBtnExit" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout x:Name="PlanningBtnRow" Spacing="9" VerticalOptions="Center">
                        <Path x:Name="PlanningIcon"
                              Data="M14,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V8 L14,2 Z M14,2 V8 H20 M8,13 H16 M8,17 H16 M8,9 H10"
                              Fill="#59554E"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="20"
                              WidthRequest="20" />
                        <Label x:Name="PlanningLbl"
                               Text="Planning"
                               FontSize="13.5"
                               TextColor="#59554E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Bookmarks -->
                <Border x:Name="BmBtnBorder"
                        Margin="8,1"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Background="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookmarksTapped" />
                        <PointerGestureRecognizer PointerEntered="OnBmBtnEnter"
                                                  PointerExited="OnBmBtnExit" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout x:Name="BmBtnRow" Spacing="9" VerticalOptions="Center">
                        <Path x:Name="BmIcon"
                              Data="M17,3 L7,3 C5.9,3 5,3.9 5,5 L5,21 L12,16 L19,21 L19,5 C19,3.9 18.1,3 17,3 Z"
                              Fill="#59554E"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              HeightRequest="20"
                              WidthRequest="20" />
                        <Label x:Name="BmLbl"
                               Text="Bookmarks"
                               FontSize="13.5"
                               TextColor="#59554E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>

        <!-- ② المحتوى الرئيسي على اليمين -->
        <Grid x:Name="MainContent" Grid.Column="1">

        </Grid>

    </Grid>

</ContentPage>
