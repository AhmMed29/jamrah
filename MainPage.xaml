<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cal="clr-namespace:Jamrah.Components.Calendar;assembly=Jamrah"
             x:Class="Jamrah.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Main Content Area -->
        
        <!-- hello world page -->
        <Grid x:Name="MainContent">
            <!-- Default placeholder -->
            <Label x:Name="PlaceholderLabel"
                   Text="Hello World"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="#2196F3"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Sidebar -->
       
         <Grid x:Name="Sidebar"
      WidthRequest="60"
      HorizontalOptions="Start"
      VerticalOptions="Fill"
      Background="#FFFFFF"
      TranslationX="-60"
      ZIndex="10">
    <Grid.GestureRecognizers>
        <PointerGestureRecognizer PointerExited="OnSidebarPointerExited" />
    </Grid.GestureRecognizers>
    <Border StrokeThickness="1"
            Stroke="#000000"
            StrokeShape="Rectangle"
            HorizontalOptions="End"
            WidthRequest="1"
            VerticalOptions="Fill" />
    <VerticalStackLayout Padding="10,20,10,0" Spacing="20" VerticalOptions="Start">
        <!-- My Tasks -->
        <Border StrokeThickness="1" Stroke="#000000" StrokeShape="Rectangle"
                WidthRequest="40" HeightRequest="40">
            <Grid x:Name="MyTasksButton">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMyTasksTapped" />
                    <PointerGestureRecognizer PointerEntered="OnTasksBtnHoverEnter"
                                              PointerExited="OnTasksBtnHoverExit" />
                </Grid.GestureRecognizers>
                <Label x:Name="TasksBtnLabel"
                       Text="T"
                       FontSize="16"
                       FontAttributes="Bold"
                       FontFamily="Courier New"
                       TextColor="#000000"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
        <!-- Pomodoro -->
        <Border StrokeThickness="1" Stroke="#000000" StrokeShape="Rectangle"
                WidthRequest="40" HeightRequest="40">
            <Grid x:Name="PomodoroButton">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPomodoroTapped" />
                    <PointerGestureRecognizer PointerEntered="OnPomoBtnHoverEnter"
                                              PointerExited="OnPomoBtnHoverExit" />
                </Grid.GestureRecognizers>
                <Label x:Name="PomoBtnLabel"
                       Text="P"
                       FontSize="16"
                       FontAttributes="Bold"
                       FontFamily="Courier New"
                       TextColor="#000000"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
        <!-- Calendar -->
        <Border StrokeThickness="1" Stroke="#000000" StrokeShape="Rectangle"
                WidthRequest="40" HeightRequest="40">
            <Grid x:Name="CalendarButton">
                <!-- <Grid.GestureRecognizers> -->
                <!--     <TapGestureRecognizer Tapped="OnCalendarMonthTapped" /> -->
                <!--     <PointerGestureRecognizer PointerEntered="OnCalBtnHoverEnter" -->
                <!--                               PointerExited="OnCalBtnHoverExit" /> -->
                <!-- </Grid.GestureRecognizers> -->
                <Label x:Name="CalBtnLabel"
                       Text="C"
                       FontSize="16"
                       FontAttributes="Bold"
                       FontFamily="Courier New"
                       TextColor="#000000"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</Grid>
        
        
        <!-- Hover strip on screen edge -->
        <BoxView x:Name="HoverStrip"
                 WidthRequest="8"
                 HorizontalOptions="Start"
                 VerticalOptions="Fill"
                 Background="#01000000"
                 ZIndex="20">
            <BoxView.GestureRecognizers>
                <PointerGestureRecognizer PointerEntered="OnHoverStripPointerEntered" />
            </BoxView.GestureRecognizers>
        </BoxView>
        
    </Grid>

</ContentPage>