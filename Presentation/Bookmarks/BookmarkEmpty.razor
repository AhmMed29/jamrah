@inject Jamrah.Application.Services.LocalizationService L

@if (IsLibraryEmpty)
{
    <div class="empty"><h3>@L["bmk.emptyLib"]</h3><p>@L["bmk.emptyLibHint"]</p>
        <button class="btn pri" @onclick="() => OnAdd.InvokeAsync()">@((MarkupString)BookmarkIcons.Svg("plus", 14)) @L["bmk.addFirst"]</button></div>
}
else if (!string.IsNullOrEmpty(Search))
{
    <div class="empty"><h3>@L["bmk.noResults"]</h3><p>@L["bmk.noResultsHint"] “@Search”. @L["bmk.noResultsHint2"] <span class="mono">type:</span> <span class="mono">tag:</span></p>
        <button class="btn" @onclick="() => OnClearSearch.InvokeAsync()">@L["bmk.clearSearch"]</button></div>
}
else
{
    <div class="empty"><h3>@L["bmk.nothingHere"]</h3><p>@L["bmk.nothingHint"]</p>
        <button class="btn pri" @onclick="() => OnAdd.InvokeAsync()">@((MarkupString)BookmarkIcons.Svg("plus", 14)) @L["bmk.addItem"]</button></div>
}

@code {
    [Parameter] public bool IsLibraryEmpty { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback OnClearSearch { get; set; }
}
