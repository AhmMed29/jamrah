    private List<(string Type, int Count, int Max)> TypeStats()
    {
        var groups = Alive().GroupBy(i => i.Type).Select(g => (Type: g.Key, Count: g.Count())).OrderByDescending(x => x.Count).Take(10).ToList();
        var max = groups.Count > 0 ? groups[0].Count : 1;
        return groups.Select(x => (x.Type, x.Count, max)).ToList();
    }

