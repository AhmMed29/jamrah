    // Permanent delete removes managed library files from disk. Linked files outside the
    // library are left untouched; only their card is deleted.
    private async Task DeleteItemForeverAsync(BookmarkItem it)
    {
        var rel = ItemMeta.Get(it.MetadataJson, "localFile");
        if (!string.IsNullOrEmpty(rel))
        {
            var path = LocalFileActions.ManagedPathFor(rel);
            if (path != null)
            {
                try { await Task.Run(() => FileOps.DeletePermanently(path)); }
                catch (Exception ex) { System.Diagnostics.Debug.WriteLine("[BookmarkPage] permanent delete failed: " + ex.Message); }
            }
        }
        await State.DeleteItemAsync(it.Id, true);
        if (State.DetailId == it.Id) State.SetDetail(null);
        if (_previewId == it.Id) _previewId = null;
    }

    private async Task RunBackupAsync()
    {
        if (_backupRunning) return;
        _backupRunning = true;
        var snapshot = System.IO.Path.Combine(Jamrah.Infrastructure.AppPaths.Layout.BackupsDir, "jamrah_bookmarks.db3");
        try
        {
            var layout = Jamrah.Infrastructure.AppPaths.Layout;
            var snapshotResult = await Repo.CreateSnapshotAsync(snapshot);
            if (string.IsNullOrEmpty(snapshotResult) || !System.IO.File.Exists(snapshot))
            {
                ShowToast(L["bmk.backupFailed"]);
                return;
            }
            var zip = System.IO.Path.Combine(layout.BackupsDir, $"jamrah-backup-{DateTime.Now:yyyyMMdd-HHmmss}.zip");
            await Jamrah.Files.Core.BackupArchive.CreateAsync(layout.LibraryDir, snapshot, zip);
            ShowToast(L.Get("bmk.backupDone", zip));
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[backup] {ex}");
            ShowToast(L["bmk.backupFailed"]);
        }
        finally
        {
            try { System.IO.File.Delete(snapshot); } catch { }
            _backupRunning = false;
        }
    }

