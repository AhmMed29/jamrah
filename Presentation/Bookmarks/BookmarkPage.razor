    private List<BookmarkFolder> FolderChain(string fid)
    {
        var chain = new List<BookmarkFolder>();
        var fd = State.Folders.FirstOrDefault(x => x.Id == fid);
        var n = 0;
        while (fd != null && n++ < 50) { chain.Insert(0, fd); fd = State.Folders.FirstOrDefault(x => x.Id == fd.ParentId); }
        return chain;
    }

    // ADDITIVE (new): page ancestry chain (parent pages, oldest first).
    private List<LibraryPage> PageChain(string pid)
    {
        var chain = new List<LibraryPage>();
        var p = State.Pages.FirstOrDefault(x => x.Id == pid);
        var n = 0;
        while (p != null && n++ < 50) { chain.Insert(0, p); p = State.Pages.FirstOrDefault(x => x.Id == p.ParentPageId); }
        return chain;
    }

    private List<BookmarkItem> SortedRouteItems()
    {
        var items = BookmarkQuery.RouteItems(State);
        // v2 parity: htab (All/Favorites/Inbox) + dpill (date) session filters.
        if (State.Route.Ctx != "trash")
        {
            if (_locTab == "fav") items = items.Where(i => i.Favorite).ToList();
            else if (_locTab == "inbox") items = items.Where(IsInboxItem).ToList();
            var today = DateTime.Today;
            if (_dateF == "today") items = items.Where(i => i.CreatedAt.Date == today).ToList();
            else if (_dateF == "week") items = items.Where(i => i.CreatedAt >= today.AddDays(-7)).ToList();
            else if (_dateF == "month") items = items.Where(i => i.CreatedAt.Year == today.Year && i.CreatedAt.Month == today.Month).ToList();
        }
        // v2 parity: home kind cards (All/Video/Audio/Text) filter the "all" route.
        if (State.Route.Ctx == "all" && _kindF != "all")
            items = items.Where(i => KindOf(i) == _kindF).ToList();
        BookmarkQuery.ApplySort(items, _sort);
        return items;
    }

    private static bool IsInboxItem(BookmarkItem i) =>
        !i.Archived && BookmarkQuery.FoldersOf(i).Count == 0
        && BookmarkQuery.CollectionsOf(i).Count == 0 && BookmarkQuery.PagesOf(i).Count == 0;

    // v2 parity (gridHalves): split media cards from text cards.
    private static bool HasCardImg(BookmarkItem i)
    {
        try { return !string.IsNullOrEmpty(BookmarkCardData.From(i).Img); }
        catch { return false; }
    }
    private static string KindOf(BookmarkItem i) => i.Type switch
    {
        "video" or "movie" or "tvshow" or "anime" => "video",
        "audio" or "music" or "podcast" => "audio",
        "note" or "idea" => "text",
        _ => "all",
    };

    private (int All, int Video, int Audio, int Text) KindCounts()
    {
        var alive = Alive();
        return (alive.Count, alive.Count(i => KindOf(i) == "video"),
            alive.Count(i => KindOf(i) == "audio"), alive.Count(i => KindOf(i) == "text"));
    }

    // v2 parity (childCardsHtml): direct sub-folders of the current collection/folder.
    private List<BookmarkFolder> ChildFolders()
    {
        if (State.Route.Ctx == "collection" && State.Route.Id != "general")
            return State.Folders.Where(f => !f.IsArchived && f.CollectionId == State.Route.Id && string.IsNullOrEmpty(f.ParentId)).OrderBy(f => f.Name).ToList();
        if (State.Route.Ctx == "folder")
            return State.Folders.Where(f => !f.IsArchived && f.ParentId == State.Route.Id).OrderBy(f => f.Name).ToList();
        return new List<BookmarkFolder>();
    }

