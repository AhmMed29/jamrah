                                @foreach (var it in gridRest)
                                {
                                    var gid = it.Id;
                                    <BookmarkUniCard Item="it" IsSelected="_previewId == gid" OnOpen="OpenPreview" OnToggleFav="ToggleFav" FileCardStyle="_fileCardStyle" OnToast="ShowToast" OnContextMenu="e => OpenItemCtx(it.Id, e)" />
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
        </div>
        </div>
        @if (_previewId != null)
        {
            <BookmarkPreviewModal ItemId="@_previewId"
                                 OnClose="ClosePreview"
                                 OnEdit="id => { _previewId = null; OpenSaveModal(id); }"
                                 OnOpen="OpenPreview"
                                 OnNavigate="Navigate"
                                 OnChanged="() => StateHasChanged()"
                                 OnDelete="TrashPreviewItem" />
