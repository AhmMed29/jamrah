@namespace Jamrah.Presentation.Bookmarks
@using Jamrah.Application.Services
@using Jamrah.Core.Entities
@using Jamrah.Files.Core
@using Microsoft.JSInterop
@inject BookmarkStateService State
@inject LocalDropBridge DropBridge
@inject IJSRuntime JS
@inject Jamrah.Core.Interfaces.IClipAgentService ClipAgent
@inject IAppNavService Nav
@inject Jamrah.Application.Services.LocalizationService L
@inject Jamrah.Core.Interfaces.ISettingsRepository SettingsRepo
@inject Jamrah.Core.Interfaces.IBookmarkRepository Repo
@inject LocalFileService LocalFiles
@inject ShellIpcService ShellIpc
@implements IDisposable

<div class="bmk">
    <div class="bmk-frame">
        <BookmarkTopBar Search="@State.Search" OnSearch="OnSearch" OnClearSearch="() => OnSearch(string.Empty)"
                        OnAdd="() => OpenSaveModal()" OnImportFiles="OpenImport" />
        @* Centered preview modal (replaces the old right pane + drawer). *@
        <div class="bmk-app3">
        <div class="bmk-col">
        <main class="bmk-main">
            @if (!_ready)
            {
                <div class="page"><div class="empty"><h3>@L["bmk.loading"]</h3></div></div>
            }
            else if (State.Route.Ctx == "home")
            {
                <div class="page">
                    @* v2 parity (renderHomeFolders): folder-first home with kind cards *@
                    <div style="max-width:620px;margin:4px auto 18px;position:relative">
                        <span style="position:absolute;left:13px;top:11px;color:var(--ink3)">@((MarkupString)BookmarkIcons.Svg("search", 16))</span>
                        <input dir="auto" value="@State.Search" @oninput="e => State.SetSearch(e.Value?.ToString() ?? string.Empty)" placeholder="@L["bmk.searchFolders"]" spellcheck="false" style="width:100%;height:42px;border:1px solid var(--line2);border-radius:12px;background:var(--surface);padding:0 14px 0 38px;font-size:14px;outline:none" />
                    </div>
                    @{
                        var kcAll = KindCounts();
                        var hq = (State.Search ?? "").Trim().ToLowerInvariant();
                        bool HqMatch(string label) => string.IsNullOrEmpty(hq) || label.ToLowerInvariant().Contains(hq);
                        var homeFolders = State.Folders
                            .Where(f => !f.IsArchived && string.IsNullOrEmpty(f.ParentId) && (string.IsNullOrEmpty(hq) || f.Name.ToLowerInvariant().Contains(hq)))
                            .OrderBy(f => f.Name).ToList();
                        var homePins = HomePins();
                        var homeFavs = HomeFavs();
                    }
                    <div class="fgrid">
                        @if (HqMatch(L["bmk.tabAll"]))
                        {
                            <div class="card" @onclick='() => GoKind("all")' style="padding:20px;display:flex;align-items:center;gap:14px">
                                <span style="width:48px;height:48px;border-radius:13px;background:var(--bg);display:grid;place-items:center;color:var(--ink2)">@((MarkupString)BookmarkIcons.Svg("layers", 22))</span>
                                <span style="min-width:0"><b style="font-size:16px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@L["bmk.tabAll"]</b><span class="mono" style="font-size:12px;color:var(--ink3)">@kcAll.All items</span></span>
                            </div>
                        }
                        @if (HqMatch(L["bmk.kindVideo"]))
                        {
                            <div class="card" @onclick='() => GoKind("video")' style="padding:20px;display:flex;align-items:center;gap:14px">
                                <span style="width:48px;height:48px;border-radius:13px;background:var(--bg);display:grid;place-items:center;color:var(--ink2)">@((MarkupString)BookmarkIcons.Svg("play", 22))</span>
                                <span style="min-width:0"><b style="font-size:16px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@L["bmk.kindVideo"]</b><span class="mono" style="font-size:12px;color:var(--ink3)">@kcAll.Video items</span></span>
                            </div>
                        }
                        @if (HqMatch(L["bmk.kindAudio"]))
                        {
                            <div class="card" @onclick='() => GoKind("audio")' style="padding:20px;display:flex;align-items:center;gap:14px">
                                <span style="width:48px;height:48px;border-radius:13px;background:var(--bg);display:grid;place-items:center;color:var(--ink2)">@((MarkupString)BookmarkIcons.Svg("music", 22))</span>
                                <span style="min-width:0"><b style="font-size:16px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@L["bmk.kindAudio"]</b><span class="mono" style="font-size:12px;color:var(--ink3)">@kcAll.Audio items</span></span>
                            </div>
                        }
                        @if (HqMatch(L["bmk.kindText"]))
                        {
                            <div class="card" @onclick='() => GoKind("text")' style="padding:20px;display:flex;align-items:center;gap:14px">
                                <span style="width:48px;height:48px;border-radius:13px;background:var(--bg);display:grid;place-items:center;color:var(--ink2)">@((MarkupString)BookmarkIcons.Svg("note", 22))</span>
                                <span style="min-width:0"><b style="font-size:16px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@L["bmk.kindText"]</b><span class="mono" style="font-size:12px;color:var(--ink3)">@kcAll.Text items</span></span>
                            </div>
                        }
                        @foreach (var hfd in homeFolders)
                        {
                            var hfdId = hfd.Id;
                            var hpv = BookmarkQuery.FolderPreviewImages(hfdId, State, 4);
                            <div class="card @(_dropFolderId == hfdId ? "drop-hi" : "")" @onclick='() => Navigate(("folder", hfdId, null))' style="padding:20px;display:flex;align-items:center;gap:14px" title="@hfd.Name"
                                 draggable="true" @ondragstart='() => State.DragFolderId = hfdId' @ondragend='() => State.DragFolderId = null'
                                 @oncontextmenu:preventDefault="true" @oncontextmenu="e => OpenFolderCtx(hfdId, e)"
                                 @ondragover:preventDefault="true" @ondragover="() => OnFolderDragOver(hfdId)" @ondragleave="() => OnFolderDragLeave(hfdId)"
                                 @ondrop:preventDefault="true" @ondrop:stopPropagation="true" @ondrop="() => OnFolderDrop(hfdId)">
                                @if (hpv.Count > 0)
                                {
                                    <span class="fcoll">@foreach (var p in hpv) { <img src="@p" loading="lazy" alt="" /> }</span>
                                }
                                else
                                {
                                    @((MarkupString)BookmarkIcons.Svg("folder", 22))
                                }
                                <span style="min-width:0;flex:1"><b dir="auto" style="font-size:16px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@hfd.Name</b><span class="mono" style="font-size:12px;color:var(--ink3)">@BookmarkQuery.CountFolder(hfdId, State) items</span></span>
                                <span class="dots" @onclick:stopPropagation="true" @onclick="e => OpenFolderCtx(hfdId, e)">@((MarkupString)BookmarkIcons.Svg("dots", 14))</span>
                            </div>
                        }
                        <div class="card" @onclick="() => CreateFolderInline(null)" style="padding:20px;display:grid;place-items:center;color:var(--ink3);min-height:96px" title="@L["nav.newFolder"]">@((MarkupString)BookmarkIcons.Svg("plus", 22))</div>
                    </div>
                    @if (string.IsNullOrEmpty(hq) && homePins.Count > 0)
                    {
                        <section class="hsec" style="margin-top:24px">
                            <div class="hsec-h">
                                <span class="hsec-t">@L["nav.pinned"]</span>
                                <a class="hsec-a" @onclick='() => Navigate(("pinned", null, null))'>@L["bmk.viewAll"]</a>
                            </div>
                            <div class="hrow">
                                @foreach (var it in homePins)
                                {
                                    <BookmarkUniCard Item="it" OnOpen="OpenPreview" OnToggleFav="ToggleFav" FileCardStyle="_fileCardStyle" OnToast="ShowToast" OnContextMenu="e => OpenItemCtx(it.Id, e)" />
                                }
                            </div>
                        </section>
                    }
                    @if (string.IsNullOrEmpty(hq) && homeFavs.Count > 0)
                    {
                        <section class="hsec" style="margin-top:24px">
                            <div class="hsec-h">
                                <span class="hsec-t">@L["nav.favorites"]</span>
                                <a class="hsec-a" @onclick='() => Navigate(("favorites", null, null))'>@L["bmk.viewAll"]</a>
                            </div>
                            <div class="hrow">
                                @foreach (var it in homeFavs)
                                {
                                    <BookmarkUniCard Item="it" OnOpen="OpenPreview" OnToggleFav="ToggleFav" FileCardStyle="_fileCardStyle" OnToast="ShowToast" OnContextMenu="e => OpenItemCtx(it.Id, e)" />
                                }
                            </div>
                        </section>
                    }
                </div>
            }
            else if (State.Route.Ctx == "quran")
            {
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["bmk.quran"]</h1><span class="ph-sub">@L["bmk.khatmWird"]</span>
                        <button class="btn sm" style="margin-left:auto" @onclick="NewKhatm">@L["bmk.newKhatm"]</button></div>
                    @if (ActiveKhatm() == null)
                    {
                        <div class="empty"><h3>@L["bmk.noKhatm"]</h3><p>@L["bmk.noKhatmHint"]</p></div>
                    }
                    else
                    {
                        var qa = ActiveKhatm()!;
                        <div class="q-grid">
                            <div>
                                <div class="qcard">
                                    <div class="q-k">@L["bmk.currentPage"]</div>
                                    <div class="q-big">@qa.Page <span>/ 604</span></div>
                                    <div class="bar" style="margin-top:10px"><i style="width:@(qa.Page * 100 / 604)%"></i></div>
                                    <div class="q-meta">@L.Get("bmk.juz", ((qa.Page - 1) / 20 + 1)) · @Math.Round(qa.Page * 100.0 / 604)% @L["bmk.completePct"]</div>
                                    <div class="q-wir">
                                        <div class="fld"><label>@L["bmk.pagesRead"]</label><input type="number" min="1" max="604" value="@_wridInput" @oninput="e => _wridInput = e.Value?.ToString() ?? string.Empty" /></div>
                                        <button class="btn pri sm" @onclick="AddWrid">@L["bmk.logWird"]</button>
                                    </div>
                                    @if (TodayPages() > 0) { <div class="q-today" style="margin-top:10px">@L.Get("bmk.dailyWird", TodayPages()) ✓</div> }
                                    <div class="q-wirhint">@L["bmk.wirdHint"]</div>
                                </div>
                                <div class="qcard" style="margin-top:16px">
                                    <div class="q-k">@L["bmk.juz30"]</div>
                                    <div class="q-juz" style="margin-top:10px">
                                        @for (var j = 0; j < 30; j++)
                                        {
                                            var s = j * 20 + 1; var e2 = (j + 1) * 20;
                                            var done = qa.Page > e2; var cur = qa.Page >= s && qa.Page <= e2;
                                            <div class="qj @(done ? "done" : "") @(cur ? "cur" : "")"><b>@(j + 1)</b><span>@s-@e2</span></div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="qcard">
                                <div class="q-k">@L["bmk.readingLog"]</div>
                                @foreach (var l in State.QuranLogs.Where(x => x.KhatmId == qa.Id).OrderByDescending(x => x.At))
                                {
                                    var lid = l.Id;
                                    <div class="q-stat"><span>@l.At.ToString("MMM d", L.Culture) · <b class="mono">@l.FromPage → @l.ToPage</b></span>
                                        <button class="mini" @onclick="() => State.DeleteQuranLogAsync(lid)">@((MarkupString)BookmarkIcons.Svg("x", 12))</button></div>
                                }
                                @if (!State.QuranLogs.Any(x => x.KhatmId == qa.Id)) { <p style="color:var(--ink3);font-size:12.5px;margin-top:8px">@L["bmk.noEntries"]</p> }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (State.Route.Ctx == "clipboard")
            {
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["bmk.clipboard"]</h1><span class="ph-sub">@State.Clips.Count @L["bmk.savedClip"]</span></div>
                    @if (ClipAgent.IsSupported)
                    {
                        <div class="clipcard" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                            <button class="btn sm @(_capOn ? "pri" : "")" @onclick="ToggleCapture">@(_capOn ? L["bmk.capOn"] : L["bmk.capOff"])</button>
                            <button class="btn sm @(_autoOn ? "pri" : "")" @onclick="ToggleAutoStart">@(_autoOn ? "✓ " + L["bmk.startWin"] : L["bmk.startWin"])</button>
                            <span class="clip-m">@(_agentRunning ? L["bmk.agentOn"] : L["bmk.agentIdle"]) · @L["bmk.autosave"]</span>
                        </div>
                    }
                    <div class="clipcard">
                        <textarea dir="auto" value="@_clipInput" @oninput="e => _clipInput = e.Value?.ToString() ?? string.Empty" placeholder="@L["bmk.clipPh"]" style="width:100%;min-height:64px;border:0;outline:none;font-size:13px;background:none;resize:vertical"></textarea>
                        <div style="display:flex;justify-content:flex-end;margin-top:8px"><button class="btn pri sm" @onclick="AddClip">@L["bmk.saveClip"]</button></div>
                    </div>
                    @foreach (var c in State.Clips.OrderByDescending(x => x.Pinned).ThenByDescending(x => x.At))
                    {
                        var clip = c;
                        <div class="clipcard @(clip.Pinned ? "pin" : "")">
                            @if (clip.Kind == "image" && !string.IsNullOrEmpty(clip.FilePath))
                            {
                                var imgSrc = ClipImageSrc(clip);
                                @if (!string.IsNullOrEmpty(imgSrc))
                                {
                                    <img src="@imgSrc" style="max-width:100%;border-radius:8px;display:block;cursor:pointer" @onclick="() => OpenClipFile(clip)" alt="" />
                                }
                            }
                            else
                            {
                                <div class="clip-t" dir="auto">@clip.Text</div>
                            }
                            <div class="clip-f"><span class="clip-m">@BookmarkCardData.FmtAgo(clip.At, L.Lang)@(clip.Pinned ? " · " + L["bmk.pinnedClip"] : "")</span>
                                <span class="clip-acts">
                                    @if (clip.Kind == "image" && !string.IsNullOrEmpty(clip.FilePath))
                                    {
                                        <button class="btn sm" @onclick="() => OpenClipFile(clip)">@L["bmk.open"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn sm" @onclick="() => CopyClip(clip.Text)">@L["bmk.copy"]</button>
                                    }
                                    <button class="btn sm" @onclick="() => ToggleClipPin(clip)">@(clip.Pinned ? L["bmk.unpin"] : L["bmk.pin"])</button>
                                    <button class="btn sm dgr" @onclick="() => State.DeleteClipAsync(clip.Id)">@L["com.delete"]</button>
                                </span></div>
                        </div>
                    }
                    @if (State.Clips.Count == 0) { <div class="empty"><h3>@L["bmk.clipEmpty"]</h3><p>@L["bmk.clipEmptyHint"]</p></div> }
                </div>
            }
            else if (State.Route.Ctx == "tags")
            {
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["nav.tags"]</h1><span class="ph-sub">@State.Tags.Count @L["bmk.tagsSub"]</span></div>
                    @if (State.Tags.Count == 0) { <div class="empty"><h3>@L["bmk.noTags"]</h3><p>@L["bmk.noTagsHint"]</p></div> }
                    @foreach (var t in State.Tags.OrderByDescending(t => BookmarkQuery.TagCount(t.Name, State)))
                    {
                        var tag = t;
                        <div class="tagrow" @onclick='() => Navigate(("tag", null, tag.Name))'>
                            <span class="cdot" style="background:@(string.IsNullOrEmpty(tag.Color) ? "#c9c5bc" : tag.Color)"></span>
                            <b>#@tag.Name</b><span class="cnt">@BookmarkQuery.TagCount(tag.Name, State) @L["bmk.countItems"]</span>
                            <span class="acts" @onclick:stopPropagation="true">
                                <input type="color" value="@(string.IsNullOrEmpty(tag.Color) ? "#c9c5bc" : tag.Color)" @onchange="e => SaveTagColor(tag, e.Value?.ToString() ?? string.Empty)" style="width:30px;height:26px;border:1px solid var(--line);border-radius:6px;padding:1px;background:var(--surface)" title="Tag color" />
                            </span>
                        </div>
                    }
                </div>
            }
            else if (State.Route.Ctx == "templates")
            {
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["nav.templates"]</h1><span class="ph-sub">@L["bmk.tplSub"]</span></div>
                    <div class="hcol">
                        @foreach (var (id, name, cat) in GalleryTemplates)
                        {
                            <div class="tpl-tile">
                                <div class="tn">@name <span style="color:var(--ink3);font-weight:600">· @cat</span></div>
                                <div style="margin-top:10px;pointer-events:none">
                                    <div class="card" data-static="1">@((MarkupString)BookmarkTemplates.Render(SampleItem(), id, State.Tags))</div>
                                </div>
                                <div class="tf"><span class="mono" style="font-size:11px;color:var(--ink3)">@id</span></div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (State.Route.Ctx == "settings")
            {
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["bmk.settings"]</h1><span class="ph-sub">@L["bmk.backupTitle"]</span></div>
                    <div style="max-width:640px"><Jamrah.Presentation.Shared.LanguageSelector /></div>
                    <div class="qcard" style="max-width:640px;margin-top:16px">
                        <div class="q-k">@L["bmk.backupJson"]</div>
                        <div class="q-meta">@State.Items.Count(i => !i.Deleted) @L["bmk.countItems"] · @State.Folders.Count @L["bmk.countFolders"] · @State.Collections.Count @L["bmk.countCollections"]</div>
                        <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
                            <button class="btn pri sm" @onclick="ExportBackup">@((MarkupString)BookmarkIcons.Svg("download", 13)) @L["bmk.export"]</button>
                            <label class="btn sm" style="cursor:pointer">@((MarkupString)BookmarkIcons.Svg("upload", 13)) @L["bmk.import"]
                                <InputFile OnChange="ImportFile" accept=".json,application/json" style="display:none" />
                            </label>
                            <button class="btn sm" @onclick="RunBackupAsync" disabled="@_backupRunning">@L["bmk.backup"]</button>
                            @if (OperatingSystem.IsWindows())
                            {
                                <button class="btn sm" @onclick="OpenJamrahFolderAsync">@L["bmk.openJamrahFolder"]</button>
                            }
                        </div>
                        <p class="hint" style="margin-top:10px">@L["bmk.importWarn"]</p>
                    </div>
                    <div class="qcard" style="max-width:640px;margin-top:16px">
                        <div class="q-k">@L["bmk.searchOps"]</div>
                        <div class="q-meta"><span class="mono">type:book</span> · <span class="mono">tag:backend</span> · <span class="mono">author:joel</span> · <span class="mono">favorite:true</span> · <span class="mono">year:2024</span></div>
                    </div>
                    <div class="qcard" style="max-width:640px;margin-top:16px">
                        <div class="q-k">@L["bmk.zoomTitle"]</div>
                        <div class="q-meta"><kbd>Ctrl +</kbd> <kbd>Ctrl -</kbd> <kbd>Ctrl 0</kbd> · <kbd>Ctrl</kbd> + @L["bmk.zoomHint"]</div>
                    </div>
                    <div class="qcard" style="max-width:640px;margin-top:16px">
                        <div class="q-k">@(L.Lang == "ar" ? "شكل كروت الملفات" : "File cards style")</div>
                        <div class="q-meta">@(L.Lang == "ar" ? "البرامج دايمًا بأيقونتها الحقيقية." : "Programs always show their real icon.")</div>
                        <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
                            <button class="btn sm @(_fileCardStyle == "preview" ? "pri" : "")" @onclick='() => SetFileCardStyle("preview")'>@(L.Lang == "ar" ? "معاينة (أول صفحة)" : "Preview (first page)")</button>
                            <button class="btn sm @(_fileCardStyle == "icon" ? "pri" : "")" @onclick='() => SetFileCardStyle("icon")'>@(L.Lang == "ar" ? "أيقونة النوع" : "Type badge")</button>
                            <button class="btn sm @(_fileCardStyle == "sheet" ? "pri" : "")" @onclick='() => SetFileCardStyle("sheet")'>@(L.Lang == "ar" ? "ورقة باسم الملف" : "Name sheet")</button>
                        </div>
                    </div>
                    @* ADDITIVE: translator agent settings (no existing logic touched) *@
                    <div style="max-width:640px"><TranslatorSettings /></div>
                    <Jamrah.Presentation.Shared.UpdateSettings />
                </div>
            }
            else if (State.Route.Ctx == "passwords")
            {
                @* PLACEHOLDER: passwords vault design comes later (sidebar row only for now) *@
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title">@L["nav.passwords"]</h1><span class="ph-sub">@L["bmk.soon"]</span></div>
                    <div class="empty"><h3>@L["nav.passwords"]</h3><p>@L["bmk.soonHint"]</p></div>
                </div>
            }
            else
            {
                var items = SortedRouteItems();
                var isTrash = State.Route.Ctx == "trash";
                var col = State.Route.Ctx == "collection" ? State.Collections.FirstOrDefault(c => c.Id == State.Route.Id) : null;
                var recursiveCount = State.Route.Ctx == "folder"
                    ? BookmarkQuery.CountFolder(State.Route.Id ?? "", State)
                    : State.Route.Ctx == "page" ? BookmarkQuery.CountPage(State.Route.Id ?? "", State) : 0;
                var showRecursive = (State.Route.Ctx is "folder" or "page")
                    && string.IsNullOrWhiteSpace(State.Search)
                    && !State.Filters.HasActive
                    && _locTab == "all" && _dateF == "all";
                var headerCount = showRecursive ? recursiveCount : items.Count;
                var hasNestedContent = showRecursive && recursiveCount > 0;
                <div class="page">
                    <div class="ph-row"><h1 class="ph-title" dir="auto">@BookmarkQuery.TitleFor(State.Route, State, L.Lang)</h1>
                        <span class="ph-sub">@headerCount @L["bmk.countItems"]@(isTrash ? " · " + L["bmk.trashHint"] : "")</span>
                        @if (col != null && BookmarkQuery.ParseSmart(col.SmartJson) == null)
                        {
                            <span style="margin-left:auto" class="mono"></span>
                        }
                    </div>
                    @* ADDITIVE (new): archived collections/folders/pages with restore + permanent delete.
                       Item delete flows here too (folder/collection/page delete = archive). *@
                    @if (State.Route.Ctx == "archive")
                    {
                        @foreach (var ac in State.Collections.Where(c => c.IsArchived))
                        {
                            var acid = ac.Id;
                            <div class="tagrow">
                                @((MarkupString)BookmarkIcons.FdIcon(string.IsNullOrEmpty(ac.Icon) ? "layers" : ac.Icon, "layers"))
                                <b dir="auto">@ac.Name</b><span class="cnt">@L["bmk.collection"] · @L["bmk.archivedLbl"]</span>
                                <span class="acts" @onclick:stopPropagation="true" style="margin-left:auto;display:flex;gap:6px">
                                    <button class="btn sm" @onclick="() => State.RestoreCollectionAsync(acid)">@L["bmk.restore"]</button>
                                    <button class="btn sm dgr" @onclick="() => State.DeleteCollectionAsync(acid)">@L["bmk.deleteForever"]</button>
                                </span>
                            </div>
                        }
                        @foreach (var af in State.Folders.Where(f => f.IsArchived))
                        {
                            var afid = af.Id;
                            <div class="tagrow">
                                @((MarkupString)BookmarkIcons.FdIcon(string.IsNullOrEmpty(af.Icon) ? "folder" : af.Icon, "folder"))
                                <b dir="auto">@af.Name</b><span class="cnt">@L["bmk.folder"] · @L["bmk.archivedLbl"]</span>
                                <span class="acts" @onclick:stopPropagation="true" style="margin-left:auto;display:flex;gap:6px">
                                    <button class="btn sm" @onclick="() => State.RestoreFolderAsync(afid)">@L["bmk.restore"]</button>
                                    <button class="btn sm dgr" @onclick="() => State.DeleteFolderAsync(afid)">@L["bmk.deleteForever"]</button>
                                </span>
                            </div>
                        }
                        @foreach (var ap in State.Pages.Where(p => p.IsArchived))
                        {
                            var apid = ap.Id;
                            <div class="tagrow">
                                @((MarkupString)BookmarkIcons.FdIcon(string.IsNullOrEmpty(ap.Icon) ? "note" : ap.Icon, "note"))
                                <b dir="auto">@ap.Name</b><span class="cnt">@L["bmk.page"] · @L["bmk.archivedLbl"]</span>
                                <span class="acts" @onclick:stopPropagation="true" style="margin-left:auto;display:flex;gap:6px">
                                    <button class="btn sm" @onclick="() => State.RestorePageAsync(apid)">@L["bmk.restore"]</button>
