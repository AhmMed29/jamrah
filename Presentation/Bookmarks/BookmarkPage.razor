        }
    </div>
</div>

@code {
    private bool _ready;
    private string _view = "grid";
    private string _sort = "added";
    private string _fileCardStyle = "preview";
    private readonly System.Threading.SemaphoreSlim _shellImportLock = new(1, 1);
    private string? _dropFolderId;
    private static readonly string[] TimeSorts = new[] { "added", "updated", "opened" };
    private bool _showQuick;
    private string? _folderModalMode;
    private string? _folderEditId;
    private string? _colEditId;
    private string? _ctxFolderId;
    private string? _ctxItemId;
    private double _ctxX;
    private double _ctxY;
    private string? _saveEditId;
    private string? _saveFolderId;
    private string? _saveType;
    // ADDITIVE (new): page modal state.
    private string? _pageModalMode;
    private string? _pageEditId;
    private string? _pageColId;
    private string? _pageFolderId;
    private string? _pageParentId;
    private bool _importOpen;
    private IReadOnlyList<string>? _importDialogPaths;
    private string? _toast;
    private int _toastToken;
    private bool _backupRunning;
    // v2 parity: side preview selection (view3). Drawer (DetailId) stays for full details.
    private string? _previewId;
    private bool _confirmEmptyTrash;
    // v2 parity (think-capture): session-only list filters. Defaults = no filtering.
    private string _locTab = "all"; // all | fav | inbox
    private string _dateF = "all"; // all | today | week | month
    private string _kindF = "all"; // all | video | audio | text (home kind cards)
    private string _wridInput = string.Empty;
    private string _clipInput = string.Empty;

    private static readonly (string Id, string Name, string Cat)[] GalleryTemplates = new[]
    {
        ("minimal", "Minimal Card", "Minimal"), ("minimalImage", "Minimal Image", "Minimal"),
        ("linkcard", "Link", "Minimal"), ("post", "Post", "Minimal"), ("compact", "Compact Row", "Minimal"),
        ("poster", "Poster", "Media"), ("cinematic", "Cinematic", "Media"), ("hero", "Hero", "Media"),
        ("landscape", "Landscape", "Media"), ("photo", "Photo", "Media"), ("audio", "Audio", "Media"),
        ("thumbGrid", "Thumbnail Grid", "Media"), ("book", "Book Cover", "Reading"),
        ("reading", "Reading Progress", "Reading"), ("shelf", "Shelf", "Reading"),
        ("note", "Note", "General"), ("dev", "Developer", "Developer"), ("file", "File", "Files"),
        ("horizontal", "Horizontal", "General"), ("magazine", "Magazine", "General"),
        ("detailed", "Detailed", "General"), ("metadata", "Metadata", "General"),
    };

    protected override async Task OnInitializedAsync()
    {
        State.OnStateChanged += OnState;
        DropBridge.FilesDropped += OnFilesDroppedFromShell;
        ShellIpc.PathsReceived += OnShellPathsReceived;
        L.OnLanguageChanged += OnLang;
        await State.InitAsync();
        try
        {
            var fcs = await SettingsRepo.GetAsync("fileCardStyle");
            if (!string.IsNullOrEmpty(fcs)) _fileCardStyle = fcs;
        }
        catch { }
        await LoadVS();
        await LoadAgentState();
        Nav.CurrentChanged += OnVisibilityChanged;
        if (Nav.CurrentPage == "bookmarks")
            StartClipTimer();
        _ready = true;
        _ = BackfillFileIconsAsync();
        var pendingShellPaths = ShellIpc.DrainPending();
        if (pendingShellPaths.Count > 0)
            await ImportShellPathsAsync(pendingShellPaths);
    }

    private void OnState() => InvokeAsync(StateHasChanged);
    private void OnLang() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Nav.CurrentChanged -= OnVisibilityChanged;
        DropBridge.FilesDropped -= OnFilesDroppedFromShell;
        ShellIpc.PathsReceived -= OnShellPathsReceived;
        _shellImportLock.Dispose();
        try { _clipTimer?.Dispose(); } catch { }
        State.OnStateChanged -= OnState;
        L.OnLanguageChanged -= OnLang;
    }

    // ─── Clip refresh timer runs only while this page is visible ───

    private void OnVisibilityChanged(string page)
    {
        if (page == "bookmarks")
        {
            StartClipTimer();
            // UNIFIED: the bookmarks WebView is suspended while hidden on Windows
            // (MainPage SuspendViewAsync), so a route set from another page's sidebar
            // may not have re-rendered yet. Re-sync view state + re-render on return
            // so the first click target shows immediately without a second click.
            _ = InvokeAsync(async () =>
            {
                _confirmEmptyTrash = false;
                await LoadVS();
                StateHasChanged();
            });
        }
        else StopClipTimer();
    }

    private void StartClipTimer()
    {
        if (_clipTimer != null) return;
        _clipTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                if (State.Route.Ctx == "clipboard")
                {
                    await State.RefreshClipsAsync();
                    _agentRunning = ClipAgent.IsAgentRunning();
                }
            }
            catch { }
        }, null, 5000, 5000);
    }

    private void StopClipTimer()
    {
        _clipTimer?.Dispose();
        _clipTimer = null;
    }

    private bool _capOn = true;
    private bool _autoOn = true;
    private bool _agentRunning;
    private System.Threading.Timer? _clipTimer;

    private async Task LoadAgentState()
    {
        if (!ClipAgent.IsSupported) return;
        try
        {
            _capOn = await ClipAgent.IsCaptureEnabledAsync();
            _autoOn = await ClipAgent.IsAutoStartEnabledAsync();
            _agentRunning = ClipAgent.IsAgentRunning();
        }
        catch { }
    }

    private async Task ToggleCapture()
    {
        _capOn = !_capOn;
        await ClipAgent.SetCaptureEnabledAsync(_capOn);
        try { _agentRunning = ClipAgent.IsAgentRunning(); } catch { }
    }

    private async Task ToggleAutoStart()
    {
        _autoOn = !_autoOn;
        await ClipAgent.SetAutoStartEnabledAsync(_autoOn);
    }

    private Task OpenClipFile(BookmarkClip clip)
    {
        try
        {
            var path = System.IO.Path.Combine(ClipAgent.ClipsDir, clip.FilePath ?? string.Empty);
            if (System.IO.File.Exists(path))
                return Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(new Microsoft.Maui.ApplicationModel.OpenFileRequest { File = new Microsoft.Maui.Storage.ReadOnlyFile(path) });
        }
        catch { }
        return Task.CompletedTask;
    }

    // Windows: clips served by the WebView2 virtual host (jamrahclips.local).
    // Android: no virtual host mapping exists, so the bytes are inlined as a data URI.
    private readonly Dictionary<string, string> _clipImgCache = new();

    private string ClipImageSrc(BookmarkClip clip)
    {
        var file = clip.FilePath ?? string.Empty;
        if (string.IsNullOrEmpty(file)) return string.Empty;
        if (ClipAgent.IsSupported) return "http://jamrahclips.local/" + file;
        if (_clipImgCache.TryGetValue(file, out var cached)) return cached;
        try
        {
            var bytes = System.IO.File.ReadAllBytes(System.IO.Path.Combine(ClipAgent.ClipsDir, file));
            var ext = System.IO.Path.GetExtension(file).TrimStart('.').ToLowerInvariant();
            var mime = ext switch
            {
                "jpg" or "jpeg" => "image/jpeg",
                "gif" => "image/gif",
                "webp" => "image/webp",
                "bmp" => "image/bmp",
                _ => "image/png",
            };
            var src = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            _clipImgCache[file] = src;
            return src;
        }
        catch { return string.Empty; }
    }

    private string VKey => State.Route.Ctx + (State.Route.Id != null ? ":" + State.Route.Id : "") + (State.Route.Tag != null ? ":" + State.Route.Tag : "");

    private async Task LoadVS()
    {
        var vs = await State.GetViewStateAsync(VKey);
        _view = string.IsNullOrEmpty(vs.View) ? "grid" : vs.View;
        _sort = string.IsNullOrEmpty(vs.Sort) ? BookmarkQuery.DefaultSort(State.Route.Ctx) : vs.Sort;
        if (!TimeSorts.Contains(_sort)) _sort = "added";
    }

    public async Task Navigate((string Ctx, string? Id, string? Tag) nav)
    {
        State.SetRoute(nav.Ctx, nav.Id, nav.Tag);
        _confirmEmptyTrash = false;
        _previewId = null;
        _locTab = "all";
        _dateF = "all";
        _kindF = "all";
        await LoadVS();
        StateHasChanged();
    }

    // v2 parity: home kind cards filter the "all" route by media bucket.
    private async Task GoKind(string k)
    {
        await Navigate(("all", null, null));
        _kindF = k;
        StateHasChanged();
    }

    private async Task OnSearch(string s)
    {
        var searchable = new[] { "all", "favorites", "pinned", "recent", "folder", "collection", "page", "tag", "archive", "trash" };
        if (!string.IsNullOrEmpty(s) && !searchable.Contains(State.Route.Ctx))
        {
            State.SetRoute("all");
            await LoadVS();
        }
        State.SetSearch(s);
    }

    private async Task OpenItem(string id)
    {
        State.SetDetail(id);
        await State.TouchOpenedAsync(id);
    }

    // v2 parity (selectItem): card click opens the side preview, not the full drawer.
    private async Task OpenPreview(string id)
    {
        _previewId = id;
        await State.TouchOpenedAsync(id);
        StateHasChanged();
    }

    private void ClosePreview()
    {
        if (State.DetailId != null && State.DetailId == _previewId) State.SetDetail(null);
        _previewId = null;
    }

    private async Task TrashPreviewItem(string id)
    {
        await State.DeleteItemAsync(id, false);
        if (State.DetailId == id) State.SetDetail(null);
        _previewId = null;
    }

    private Task TogglePin(string id) => State.TogglePinAsync(id);

    private Task ToggleFav(string id) => State.ToggleFavoriteAsync(id);

    private async Task ChangeView(string v)
    {
        _view = v;
        await State.SetViewStateAsync(VKey, _view, _sort);
    }

    private async Task ChangeSort(string s)
    {
        _sort = s;
        await State.SetViewStateAsync(VKey, _view, _sort);
    }

    public void OpenFolderModal(string mode, string? folderId, string? colId)
    {
        _folderModalMode = mode;
        _folderEditId = folderId;
        _colEditId = colId;
        // FIX: this is called from the sidebar chain (AppSidebar → PageShell →
        // ShellBookmarksPage), which never re-renders this component — force it,
        // otherwise the modal stays invisible until the next navigation/refresh.
        StateHasChanged();
    }

    // ADDITIVE (new): opened by the sidebar + button / dots on pages.
    public void OpenPageModal(string mode, string? pageId, string? colId, string? folderId, string? parentPageId)
    {
        _pageModalMode = mode;
        _pageEditId = pageId;
        _pageColId = colId;
        _pageFolderId = folderId;
        _pageParentId = parentPageId;
        // FIX: same as above — sidebar-initiated, must trigger our own render.
        StateHasChanged();
    }

    private void OpenImport()
    {
        _importDialogPaths = null;
        _importOpen = true;
    }

    private void OnFilesDroppedFromShell(IReadOnlyList<string> paths)
    {
        if (Nav.CurrentPage != "bookmarks" || _showQuick) return; // BookmarkPage stays mounted (Keep-Alive); quick-capture zone owns drops while open
        _ = InvokeAsync(() =>
        {
            _importDialogPaths = paths;
            _importOpen = true;
            StateHasChanged();
        });
    }

    private async Task OnImportCompleted(string msg)
    {
        _importOpen = false;
        await State.RefreshDataAsync();
        ShowToast(msg);
    }

    private void OnShellPathsReceived(IReadOnlyList<string> paths)
    {
        _ = InvokeAsync(async () =>
        {
            try { await ImportShellPathsAsync(paths); }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine("[shell-import] " + ex.Message); }
        });
    }

    private async Task ImportShellPathsAsync(IReadOnlyList<string> paths)
    {
        await _shellImportLock.WaitAsync();
        try
        {
            var report = await LocalFiles.ImportAsync(paths, null, ImportMode.Copy, () => State.Folders);
            await State.RefreshDataAsync();
            if (report.Imported > 0 || report.FoldersCreated > 0)
            {
                var parts = new System.Collections.Generic.List<string>();
                if (report.Imported > 0)
                    parts.Add(T($"تم إضافة {report.Imported} عنصر للإنبوكس", $"Added {report.Imported} to Inbox"));
                if (report.FoldersCreated > 0)
                    parts.Add(T($"{report.FoldersCreated} فولدر", $"{report.FoldersCreated} folder(s)"));
                ShowToast(string.Join(" · ", parts));
            }
            else if (report.SkippedDuplicates > 0)
                ShowToast(T("الملفات موجودة بالفعل في جمرة", "Already in Jamrah"));
            else if (report.Errors.Count > 0)
                ShowToast(T("تعذر استيراد بعض الملفات", "Some files could not be imported"));
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("[shell-import] " + ex);
            ShowToast(T("تعذر استيراد الملفات", "Could not import the files"));
        }
        finally
        {
            _shellImportLock.Release();
        }
    }

