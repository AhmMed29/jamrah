@using Jamrah.Application.Services
@inject BookmarkStateService State
@inject LocalizationService L

<header class="bmk-top">
    <div class="qwrap">
        <span class="sic">@((MarkupString)BookmarkIcons.Svg("search", 15))</span>
        <input class="bmk-q" placeholder="@L["bmk.searchHint"]"
               value="@Search" @oninput="e => OnSearch.InvokeAsync(e.Value?.ToString() ?? string.Empty)" spellcheck="false" />
        @if (!string.IsNullOrEmpty(Search))
        {
            <button class="qclr" @onclick="() => OnClearSearch.InvokeAsync()" title="@L["bmk.clearAll"]">
                @((MarkupString)BookmarkIcons.Svg("x", 13))
            </button>
        }
    </div>
    <div class="top-r">
        <button class="btn pri" @onclick="() => OnAdd.InvokeAsync()">@((MarkupString)BookmarkIcons.Svg("plus", 14)) @L["bmk.addItem"]</button>
    </div>
</header>

@code {
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnClearSearch { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
}
