@namespace Jamrah.Presentation.Planning
@using Markdig
@using Microsoft.JSInterop
@inject Jamrah.Core.Interfaces.IPlanningRepository PlanningRepo
@inject IJSRuntime JS

<div class="planning-app" dir="rtl">
    <div class="planning-header">
        <div class="planning-title">التخطيط</div>
        <div class="planning-header-actions">
            <button class="planning-toggle" @onclick="()=> _isEdit = !_isEdit">
                @(_isEdit ? "👁 معاينة" : "✎ تعديل")
            </button>
            <button class="planning-save" @onclick="SaveAsync">
                @if(_saved){ <span>✓ تم الحفظ</span> } else { <span>💾 حفظ</span> }
            </button>
        </div>
    </div>

    <div class="planning-toolbar">
        <button class="tb-btn" @onclick='()=> InsertAsync("# ", "", "عنوان")' title="H1">H1</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("## ", "", "عنوان")' title="H2">H2</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("### ", "", "عنوان")' title="H3">H3</button>
        <span class="tb-sep"></span>
        <button class="tb-btn tb-bold" @onclick='()=> InsertAsync("**", "**", "نص عريض")' title="عريض"><b>B</b></button>
        <button class="tb-btn tb-italic" @onclick='()=> InsertAsync("*", "*", "نص مائل")' title="مائل"><i>I</i></button>
        <button class="tb-btn" @onclick='()=> InsertAsync("~~", "~~", "مشطوب")' title="مشطوب"><s>S</s></button>
        <button class="tb-btn" @onclick='()=> InsertAsync("`", "`", "كود")' title="كود">`</button>
        <span class="tb-sep"></span>
        <button class="tb-btn" @onclick='()=> InsertAsync("- [ ] ", "", "مهمة")' title="توجل">☐</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("- ", "", "عنصر")' title="قائمة نقطية">•</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("1. ", "", "عنصر")' title="قائمة رقمية">1.</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("> ", "", "اقتباس")' title="اقتباس">❞</button>
        <button class="tb-btn" @onclick='()=> InsertAsync("---\n", "", "")' title="فاصل">—</button>
    </div>

    <div class="planning-body">
        @if(_isEdit){
            <textarea id="planning-textarea" class="planning-editor" @bind="ContentProxy" @bind:event="oninput" placeholder="ابدأ الكتابة هنا... # عنوان, **عريض**, - [ ] توجل"></textarea>
        } else {
            <div class="planning-preview markdown-body">
                @((MarkupString)PreviewHtml)
            </div>
        }
    </div>

    <div class="planning-footer">
        <span class="planning-path">@_filePath</span>
        <span class="planning-status">@(_saved ? "محفوظ" : "غير محفوظ") • @_content.Length حرف</span>
    </div>
</div>

<style>
    .planning-app{ display:flex; flex-direction:column; height:100vh; background:#FFFFFF; color:#1C1917; font-family:'Tajawal',sans-serif; }
    .planning-header{ height:48px; display:flex; align-items:center; justify-content:space-between; padding:0 16px; border-bottom:1px solid #E7E5E4; background:#FFFFFF; flex-shrink:0; }
    .planning-title{ font-size:14px; font-weight:800; }
    .planning-header-actions{ display:flex; gap:8px; }
    .planning-toggle, .planning-save{ height:32px; padding:0 14px; border-radius:8px; border:1px solid #E7E5E4; background:#FFFFFF; font-size:12px; font-weight:600; cursor:pointer; }
    .planning-toggle:hover{ background:#F5F5F4; }
    .planning-save{ background:#1C1917; color:#fff; border-color:#1C1917; }
    .planning-save:hover{ opacity:.9; }
    .planning-toolbar{ display:flex; align-items:center; gap:4px; padding:8px 12px; border-bottom:1px solid #E7E5E4; background:#FAFAF9; flex-wrap:wrap; flex-shrink:0; }
    .tb-btn{ min-width:32px; height:30px; padding:0 8px; border:1px solid #E7E5E4; background:#FFFFFF; border-radius:7px; font-size:12px; cursor:pointer; display:grid; place-items:center; }
    .tb-btn:hover{ background:#F5F5F4; border-color:#D6D3D1; }
    .tb-bold{ font-weight:800; } .tb-italic{ font-style:italic; }
    .tb-sep{ width:1px; height:20px; background:#E7E5E4; margin:0 4px; }
    .planning-body{ flex:1; overflow:hidden; display:flex; background:#FFFFFF; }
    .planning-editor{ flex:1; width:100%; border:0; padding:20px; font-size:14px; line-height:1.8; resize:none; outline:none; background:#FFFFFF; color:#1C1917; font-family:'Tajawal',sans-serif; }
    .planning-preview{ flex:1; overflow-y:auto; padding:20px 24px; font-size:14px; line-height:1.8; background:#FFFFFF; }
    .planning-preview h1{ font-size:22px; font-weight:800; margin:16px 0 8px; }
    .planning-preview h2{ font-size:18px; font-weight:700; margin:14px 0 8px; }
    .planning-preview h3{ font-size:15px; font-weight:700; margin:12px 0 6px; }
    .planning-preview p{ margin:8px 0; }
    .planning-preview ul, .planning-preview ol{ margin:8px 18px; }
    .planning-preview blockquote{ border-right:3px solid #E7E5E4; margin:8px 0; padding:4px 12px; color:#78716C; background:#FAFAF9; }
    .planning-preview code{ background:#F5F5F4; padding:2px 6px; border-radius:6px; font-size:13px; }
    .planning-preview input[type="checkbox"]{ margin-left:6px; }
    .planning-footer{ height:32px; display:flex; align-items:center; justify-content:space-between; padding:0 12px; border-top:1px solid #E7E5E4; background:#FAFAF9; font-size:11px; color:#78716C; flex-shrink:0; }
    .planning-path{ font-family:monospace; direction:ltr; }
</style>

@code {
    private string _content = "";
    private bool _isEdit = true;
    private bool _saved = true;
    private string _filePath = "";
    private string PreviewHtml => string.IsNullOrWhiteSpace(_content) ? "<p style='color:#78716C'>لا يوجد محتوى للمعاينة</p>" : Markdig.Markdown.ToHtml(_content, new MarkdownPipelineBuilder().UseAdvancedExtensions().UseTaskLists().Build());

    protected override async Task OnInitializedAsync()
    {
        _filePath = PlanningRepo.GetFilePath();
        _content = await PlanningRepo.LoadAsync();
        _saved = true;
    }

    private async Task InsertAsync(string before, string after, string placeholder)
    {
        if(!_isEdit) _isEdit = true;
        try
        {
            await JS.InvokeVoidAsync("planningEditor.insert", before, after, placeholder);
            // بعد الإدخال عبر JS، القيمة في textarea تغيرت لكن _content لم يتحدث إلا عبر input event
            // نحاول قراءتها
            await Task.Delay(50);
            var val = await JS.InvokeAsync<string>("planningEditor.getValue");
            if(val != null) { _content = val; _saved = false; StateHasChanged(); }
        }
        catch
        {
            // fallback بسيط
            _content += $"{before}{placeholder}{after}";
            _saved = false;
        }
    }

    private async Task SaveAsync()
    {
        await PlanningRepo.SaveAsync(_content);
        _saved = true;
        _filePath = PlanningRepo.GetFilePath();
    }

    // تحديث حالة غير محفوظ عند الكتابة
    private string ContentProxy
    {
        get => _content;
        set { _content = value; _saved = false; }
    }
}
