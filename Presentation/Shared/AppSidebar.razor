@namespace Jamrah.Presentation.Shared
@using Jamrah.Application.Services
@using Jamrah.Core.Entities
@using Jamrah.Presentation.Bookmarks
@using Microsoft.JSInterop
@inject BookmarkStateService State
@inject IAppNavService Nav
@inject Jamrah.Application.Services.LocalizationService L
@inject IJSRuntime JS
@implements IDisposable

<aside class="app-sb">
    <div class="sb-brand">
        <span class="sb-mark">J</span><span class="sb-name">Jamrah</span>
        <button class="sb-coll" @onclick="() => OnToggleSidebar.InvokeAsync()" title="@L["nav.collapse"]">
            @((MarkupString)BookmarkIcons.Svg("chevL", 14))
        </button>
    </div>

    @foreach (var n in NavItems.Where(n => n.Id is not ("calendar" or "planning")))
    {
        var id = n.Id;
        <div class="sb-i sb-navi nav-@id @(Nav.CurrentPage == id ? "on" : "")" @onclick='() => Nav.Request(id)'>
            @((MarkupString)NavIcon(n.Path))<span class="n">@NavLabel(n.Id, n.Label)</span>
        </div>
    }

    @* Bookmarks — parent of the whole library group *@
    <div class="sb-i sb-navi @(Nav.CurrentPage == "bookmarks" ? "on" : "") @(Nav.BookmarksExpanded ? "" : "closed")" @onclick="OnBookmarksClick">
        @((MarkupString)NavIcon(BookmarkIconPath))<span class="n">@L["nav.bookmarks"]</span>
        <span class="chev">@((MarkupString)BookmarkIcons.Svg("chevD", 13))</span>
    </div>
    @if (Nav.BookmarksExpanded)
    {
        <div class="bm-nest">
            <div class="sb-sec @(!LibOpen ? "closed" : "")" @onclick='() => LibOpen = !LibOpen'>
                <span>@L["nav.library"]</span><span class="chev">@((MarkupString)BookmarkIcons.Svg("chevD", 12))</span>
            </div>
            @if (LibOpen)
            {
                <div class="sb-i @(IsOn("home", null, null) ? "on" : "")" @onclick='() => NavTo("home", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("home", "folder"))<span class="n">@L["nav.home"]</span>
                </div>
                <div class="sb-i @(IsOn("all", null, null) ? "on" : "")" @onclick='() => NavTo("all", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("grid", "folder"))<span class="n">@L["nav.all"]</span>
                    <span class="c">@State.Items.Count(i => !i.Deleted)</span>
                </div>
                <div class="sb-i @(IsOn("clipboard", null, null) ? "on" : "")" @onclick='() => NavTo("clipboard", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("clipboard", "folder"))<span class="n">@L["nav.clipboard"]</span>
                    <span class="c">@State.Clips.Count</span>
                </div>
                @* v2 parity: passwords row (page design comes later, placeholder for now) *@
                <div class="sb-i @(IsOn("passwords", null, null) ? "on" : "")" @onclick='() => NavTo("passwords", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("lock", "folder"))<span class="n">@L["nav.passwords"]</span>
                </div>
            }

            <div class="sb-sec @(!FoldOpen ? "closed" : "")" @onclick="() => FoldOpen = !FoldOpen">
                <span>@L["nav.folders"]</span>
                <button class="sb-sec-add" title="@L["nav.newFolder"]" @onclick:stopPropagation="true" @onclick="() => NewFolderInline(null)">
                    @((MarkupString)BookmarkIcons.Svg("plus", 12))
                </button>
                <span class="chev">@((MarkupString)BookmarkIcons.Svg("chevD", 12))</span>
            </div>
            @if (FoldOpen)
            {
                @foreach (var f in State.Folders.Where(f => !f.IsArchived && string.IsNullOrEmpty(f.ParentId)))
                {
                    <BookmarkFolderRow Folder="f" OnNavigate="Fwd" OnFolderMenu="OnFolderMenuRequest" />
                }
                <div class="sb-add" @onclick="() => NewFolderInline(null)">@((MarkupString)BookmarkIcons.Svg("plus", 13)) @L["nav.newFolder"]</div>
            }

            <div class="sb-sec @(!SysOpen ? "closed" : "")" @onclick="() => SysOpen = !SysOpen">
                <span>@L["nav.system"]</span><span class="chev">@((MarkupString)BookmarkIcons.Svg("chevD", 12))</span>
            </div>
            @if (SysOpen)
            {
                <div class="sb-i @(IsOn("archive", null, null) ? "on" : "")" @onclick='() => NavTo("archive", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("archive", "folder"))<span class="n">@L["nav.archive"]</span>
                    <span class="c">@State.Items.Count(i => i.Archived && !i.Deleted)</span>
                </div>
                <div class="sb-i @(IsOn("trash", null, null) ? "on" : "")" @onclick='() => NavTo("trash", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("trash", "folder"))<span class="n">@L["nav.trash"]</span>
                    <span class="c">@State.Items.Count(i => i.Deleted)</span>
                </div>
                <div class="sb-i @(IsOn("tags", null, null) ? "on" : "")" @onclick='() => NavTo("tags", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("tag", "folder"))<span class="n">@L["nav.tags"]</span>
                    <span class="c">@State.Tags.Count</span>
                </div>
                <div class="sb-i @(IsOn("templates", null, null) ? "on" : "")" @onclick='() => NavTo("templates", null, null)'>
                    @((MarkupString)BookmarkIcons.FdIcon("layout", "folder"))<span class="n">@L["nav.templates"]</span>
                    <span class="c">@(22 + State.CustomTemplates.Count)</span>
                </div>
            }
        </div>
    }

    @* v2 parity: settings lives in the footer, not in System *@
    <div class="sb-foot">
        <button class="sb-setbtn" @onclick='() => NavTo("settings", null, null)'>
            @((MarkupString)BookmarkIcons.Svg("sliders", 15)) @L["nav.settings"]
        </button>
        <div style="margin-top:8px">@State.Items.Count(i => !i.Deleted) @L["nav.foot"]</div>
    </div>
</aside>

@if (_menuId != null)
{
    <FolderContextMenu FolderId="@_menuId" X="_menuX" Y="_menuY"
                       OnClose="() => { _menuId = null; StateHasChanged(); }"
                       OnNewNote="id => OnNewNote.InvokeAsync(id)"
                       OnSearchInFolder="SearchInFolder"
                       OnToast="msg => OnToast.InvokeAsync(msg)" />
}

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback<(string Ctx, string? Id, string? Tag)> OnNavigate { get; set; }
    [Parameter] public EventCallback OnNewCollection { get; set; }
    [Parameter] public EventCallback OnNewSmart { get; set; }
    [Parameter] public EventCallback<string> OnNewNote { get; set; }
    [Parameter] public EventCallback<string> OnToast { get; set; }
    [Parameter] public EventCallback<string> OnCollectionMenu { get; set; }
    // ADDITIVE (new): page management + targeted add actions (old callbacks untouched).
    [Parameter] public EventCallback<string> OnNewFolderInCollection { get; set; }
    [Parameter] public EventCallback<string> OnNewPageInCollection { get; set; }
    [Parameter] public EventCallback<string> OnNewSubPage { get; set; }
    [Parameter] public EventCallback<string> OnPageMenu { get; set; }

    private static readonly (string Id, string Label, string Path)[] NavItems = new[]
    {
        ("tasks", "Tasks",
            "M3,13 L5,13 L5,11 L3,11 L3,13 Z M3,17 L5,17 L5,15 L3,15 L3,17 Z M3,9 L5,9 L5,7 L3,7 L3,9 Z M7,13 L21,13 L21,11 L7,11 L7,13 Z M7,17 L21,17 L21,15 L7,15 L7,17 Z M7,7 L7,9 L21,9 L21,7 L7,7 Z"),
        ("pomodoro", "Pomodoro",
            "M15,1 L9,1 L9,3 L15,3 L15,1 Z M11,14 L13,14 L13,8 L11,8 L11,14 Z M19.03,7.39 L20.45,5.97 C20.02,5.46 19.55,4.98 19.04,4.56 L17.62,5.98 C16.07,4.74 14.12,4 12,4 C7.03,4 3,8.03 3,13 C3,17.97 7.02,22 12,22 C16.98,22 21,17.97 21,13 C21,10.88 20.26,8.93 19.03,7.39 Z M12,20 C8.13,20 5,16.87 5,13 C5,9.13 8.13,6 12,6 C15.87,6 19,9.13 19,13 C19,16.87 16.87,20 12,20 Z"),
        ("calendar", "Calendar",
            "M20,3 L19,3 L19,1 L17,1 L17,3 L7,3 L7,1 L5,1 L5,3 L4,3 C2.9,3 2,3.9 2,5 L2,21 C2,22.1 2.9,23 4,23 L20,23 C21.1,23 22,22.1 22,21 L22,5 C22,3.9 21.1,3 20,3 Z M20,21 L4,21 L4,8 L20,8 L20,21 Z"),
        ("planning", "Planning",
            "M14,2 H6 C4.9,2 4,2.9 4,4 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V8 L14,2 Z M14,2 V8 H20 M8,13 H16 M8,17 H16 M8,9 H10"),
    };

    private const string BookmarkIconPath =
        "M17,3 L7,3 C5.9,3 5,3.9 5,5 L5,21 L12,16 L19,21 L19,5 C19,3.9 18.1,3 17,3 Z";

    private bool LibOpen = true;
    private bool FoldOpen = true;
    private bool SysOpen = true;
    private string? _menuId;
    private double _menuX;
    private double _menuY;

    private async Task NewFolderInline(string? parentId)
    {
        var id = await State.CreateFolderAsync(parentId);
        if (id == null) return;
        State.RenameFolderId = id;
        await InvokeAsync(StateHasChanged);
    }

    private void OnFolderMenuRequest((string Id, double X, double Y) m)
    {
        _menuId = m.Id;
        _menuX = m.X;
        _menuY = m.Y;
        StateHasChanged();
    }

    private async Task SearchInFolder(string folderId)
    {
        await Fwd(("folder", folderId, null));
        try
        {
            await Task.Delay(60);
            await JS.InvokeVoidAsync("bmShell.focusSearch");
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnStateChanged += OnState;
        Nav.Changed += OnNavChanged;
        L.OnLanguageChanged += OnLang;
        await State.InitAsync();
    }

    private void OnState() => InvokeAsync(StateHasChanged);
    private void OnNavChanged() => InvokeAsync(StateHasChanged);
    private void OnLang() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnStateChanged -= OnState;
        Nav.Changed -= OnNavChanged;
        L.OnLanguageChanged -= OnLang;
    }

    private string NavLabel(string id, string fallback) => id switch
    {
        "tasks" => L["nav.tasks"],
        "pomodoro" => L["nav.pomodoro"],
        "calendar" => L["nav.calendar"],
        "planning" => L["nav.planning"],
        _ => fallback,
    };

    private static string NavIcon(string d) =>
        $"<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"{d}\"/></svg>";

    private void OnBookmarksClick()
    {
        // UNIFIED: header only expands/collapses, never forces home.
        // Going home is done explicitly via the Home row.
        if (Nav.CurrentPage != "bookmarks")
        {
            Nav.SetBookmarksExpanded(true);
            Nav.Request("bookmarks");
        }
        else
        {
            Nav.SetBookmarksExpanded(!Nav.BookmarksExpanded);
        }
    }

    // UNIFIED single path: library rows navigate directly when already on the
    // Bookmarks page, otherwise store the target route then open the page.
    // No forced "home" here — the requested ctx/id/tag is preserved as-is.
    private Task NavTo(string ctx, string? id, string? tag)
    {
        if (Nav.CurrentPage == "bookmarks") return OnNavigate.InvokeAsync((ctx, id, tag));
        State.SetRoute(ctx, id, tag);
        Nav.SetBookmarksExpanded(true);
        Nav.Request("bookmarks");
        return Task.CompletedTask;
    }

    // UNIFIED: folder rows use the same path as library rows, so clicking
    // them from any other page opens Bookmarks on the right target instead of
    // being dropped (PageShell on non-bookmark pages has no OnNavigate handler).
    private Task Fwd((string Ctx, string? Id, string? Tag) t)
    {
        if (Nav.CurrentPage == "bookmarks") return OnNavigate.InvokeAsync(t);
        State.SetRoute(t.Ctx, t.Id, t.Tag);
        Nav.SetBookmarksExpanded(true);
        Nav.Request("bookmarks");
        return Task.CompletedTask;
    }

    private bool IsOn(string ctx, string? id, string? tag) =>
        Nav.CurrentPage == "bookmarks" && State.Route.Ctx == ctx && (State.Route.Id ?? null) == (id ?? null) && (State.Route.Tag ?? null) == (tag ?? null);

    private Task Navigate((string Ctx, string? Id, string? Tag) nav) => OnNavigate.InvokeAsync(nav);
}
