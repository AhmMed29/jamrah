@namespace Jamrah.Presentation.Shared
@inject Jamrah.Application.Services.LocalizationService L
@implements IDisposable

<div class="lang-card">
    <div class="lang-title">@L["lang.language"]</div>
    <button class="lang-row @(L.Lang == "ar" ? "on" : "")" @onclick='() => Pick("ar")'>
        <span>العربية</span>
        @if (L.Lang == "ar") { <span class="lang-check">✓</span> }
    </button>
    <button class="lang-row @(L.Lang == "en" ? "on" : "")" @onclick='() => Pick("en")'>
        <span>English</span>
        @if (L.Lang == "en") { <span class="lang-check">✓</span> }
    </button>
</div>

<style>
    .lang-card { background: var(--card, #FFFFFF); border: 1px solid var(--border, #E7E5E4); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .lang-title { font-weight: 800; font-size: 13px; }
    .lang-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 12px; border-radius: 9px; border: 1px solid var(--border, #E7E5E4); background: var(--bg, #FAFAF9); cursor: pointer; font-size: 13px; color: inherit; font-family: inherit; text-align: start; }
    .lang-row.on { border-color: var(--text, #1C1917); font-weight: 700; }
    .lang-check { font-weight: 800; }
</style>

@code {
    protected override void OnInitialized()
    {
        L.OnLanguageChanged += OnLang;
    }

    private void Pick(string lang)
    {
        L.SetLanguage(lang);
    }

    private void OnLang() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.OnLanguageChanged -= OnLang;
    }
}
