@namespace Jamrah.Presentation.Shared
@using Jamrah.Application.Services
@using Jamrah.Core.Interfaces
@inject ChangelogService Changelog
@inject ISettingsRepository Settings
@inject IUpdateService Updates
@inject Jamrah.Application.Services.LocalizationService L
@implements IDisposable

@* "What's new" window. Appears once per release (the user can dismiss it for
   good) and can be opened any time from Settings. *@

@if (_open && _active is not null)
{    <div @ref="_overlayRef" tabindex="-1" @onkeydown="OnKey"
         dir="@L.Dir" lang="@L.Lang"
         style="position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(28,25,23,.46);backdrop-filter:blur(6px);padding:16px;"
         @onclick="CloseAsync">
        <div role="dialog" aria-modal="true" aria-labelledby="wn-title"
             style="width:min(760px,100%);max-height:min(calc(88vh / var(--z,1)),860px);display:flex;flex-direction:column;background:var(--card,#fff);color:var(--text,#1c1917);border:1px solid var(--border,#e7e5e4);border-radius:24px;box-shadow:0 24px 70px rgba(0,0,0,.24);overflow:hidden;"
             @onclick:stopPropagation="true">

            @* ── header ── *@
            <div style="display:flex;align-items:center;gap:14px;padding:20px 22px;border-bottom:1px solid var(--border,#e7e5e4);background:var(--card,#fff);">
                <div style="width:46px;height:46px;border-radius:14px;background:linear-gradient(140deg,#1c1917,#57534e);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:21px;box-shadow:0 4px 12px rgba(0,0,0,.18);">J</div>
                <div style="min-width:0;flex:1;">
                    <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;">
                        <h2 id="wn-title" style="margin:0;font-size:19px;font-weight:800;letter-spacing:-.01em;">@L["wn.title"]</h2>
                        <span style="background:linear-gradient(90deg,#10b981,#0d9488);color:#fff;font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em;">@_active.Version</span>
                    </div>
                    <p style="margin:3px 0 0;color:var(--muted,#78716c);font-size:12.5px;">@L["wn.subtitle"]</p>
                </div>
                <button type="button" title="@L["wn.close"]" aria-label="@L["wn.close"]"
                        @onclick="CloseAsync"
                        style="width:34px;height:34px;border-radius:999px;border:0;background:var(--card2,#f5f5f4);color:var(--muted,#78716c);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg>
                </button>
            </div>

            @* ── version tabs + category filter ── *@
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 22px;background:var(--card2,#f5f5f4);border-bottom:1px solid var(--border,#e7e5e4);">
                <div style="display:flex;gap:3px;padding:3px;background:var(--card,#fff);border:1px solid var(--border,#e7e5e4);border-radius:12px;">
                    @foreach (var r in _releases)
                    {
                        var v = r.Version;
                        <button type="button" @onclick="() => SelectVersion(v)"
                                style="border:0;border-radius:9px;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer;@(v == _active.Version ? "background:var(--ink,#1c1917);color:#fff;" : "background:transparent;color:var(--muted,#78716c);")">@v</button>
                    }
                </div>
                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                    @foreach (var f in Filters)
                    {
                        var key = f.Key;
                        <button type="button" @onclick="() => _filter = key"
                                style="border:0;border-radius:11px;padding:6px 11px;font-size:11.5px;font-weight:600;cursor:pointer;@(key == _filter ? "background:#e7e5e4;color:var(--text,#1c1917);font-weight:800;" : "background:transparent;color:var(--muted,#78716c);")">@f.Label</button>
                    }
                </div>
            </div>

            @* ── body ── *@
            <div style="padding:20px 22px;overflow-y:auto;flex:1;min-height:0;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;">
                    <span style="display:flex;align-items:center;gap:7px;color:var(--muted,#78716c);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7M5 9h14v11H5V9m6 3-4 4h3v4h2v-4h3l-4-4Z"/></svg>
                        @_active.Date
                    </span>
                    <span style="color:var(--muted,#78716c);font-size:11px;font-family:var(--mono,monospace);">v@_active.Version</span>
                </div>

                @if (Filtered.Count == 0)
                {
                    <div style="text-align:center;padding:38px 10px;color:var(--muted,#78716c);">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" style="opacity:.45"><path d="M3 5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5m2 6h14l-2 6H5l2-6Z"/></svg>
                        <p style="margin:9px 0 0;font-size:13px;font-weight:600;">@L["wn.empty"]</p>
                    </div>
                }
                else
                {
                    <div style="display:flex;flex-direction:column;gap:11px;">
                        @foreach (var it in Filtered)
                        {
                            var kind = KindOf(it.Type);
                            <div style="display:flex;gap:14px;align-items:flex-start;padding:15px 16px;border:1px solid var(--border,#e7e5e4);border-radius:17px;background:var(--card,#fff);">
                                <div style="width:46px;height:46px;border-radius:14px;border:1px solid @(kind.TileBorder);background:@(kind.TileBg);display:flex;align-items:center;justify-content:center;font-size:23px;flex:none;">@it.Emoji</div>
                                <div style="min-width:0;flex:1;">
                                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;">
                                        <h3 style="margin:0;font-size:15px;font-weight:800;line-height:1.35;">@it.Title(L.Lang)</h3>
                                        <span style="flex:none;padding:3px 9px;border-radius:999px;font-size:10.5px;font-weight:800;color:#fff;background:@(kind.Pill);">@kind.Label</span>
                                    </div>
                                    <p style="margin:6px 0 0;color:var(--muted,#78716c);font-size:12.5px;line-height:1.65;">@it.Desc(L.Lang)</p>
                                    @if (it.Tags.Count > 0)
                                    {
                                        <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:9px;">
                                            @foreach (var tg in it.Tags)
                                            {
                                                <span style="display:flex;align-items:center;gap:4px;color:var(--muted,#78716c);font-size:10.5px;font-weight:700;">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="color:#16a34a;"><path d="M20 6 9 17l-5-5"/></svg>@tg
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ── feedback ── *@
                <div style="margin-top:22px;padding-top:16px;border-top:1px solid var(--border,#e7e5e4);">
                    <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--muted,#78716c);margin-bottom:11px;">@L["wn.feedback"]</div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;">
                        <button type="button" @onclick="() => OpenIssue(true)"
                                style="display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:start;border:0;border-radius:16px;padding:14px 16px;cursor:pointer;color:#fff;background:linear-gradient(90deg,#e11d48,#be123c);box-shadow:0 6px 16px rgba(190,18,60,.22);">
                            <span style="display:flex;align-items:center;gap:11px;">
                                <span style="font-size:21px;">🐛</span>
                                <span>
                                    <span style="display:block;font-size:13.5px;font-weight:800;">@L["wn.reportBug"]</span>
                                    <span style="display:block;font-size:11px;opacity:.85;">@L["wn.reportBugHint"]</span>
                                </span>
                            </span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="opacity:.75;flex:none;"><path d="M13 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2h12.2l-4.6-4.6L13 5Z"/></svg>
                        </button>
                        <button type="button" @onclick="() => OpenIssue(false)"
                                style="display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:start;border:0;border-radius:16px;padding:14px 16px;cursor:pointer;color:#fff;background:linear-gradient(90deg,#7c3aed,#4f46e5);box-shadow:0 6px 16px rgba(109,40,217,.22);">
                            <span style="display:flex;align-items:center;gap:11px;">
                                <span style="font-size:21px;">💡</span>
                                <span>
                                    <span style="display:block;font-size:13.5px;font-weight:800;">@L["wn.requestFeature"]</span>
                                    <span style="display:block;font-size:11px;opacity:.85;">@L["wn.requestFeatureHint"]</span>
                                </span>
                            </span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="opacity:.75;flex:none;"><path d="M13 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2h12.2l-4.6-4.6L13 5Z"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            @* ── footer ── *@
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 22px;background:var(--card2,#f5f5f4);border-top:1px solid var(--border,#e7e5e4);">
                <a href="https://github.com/AhmMed29/jamrah" target="_blank" rel="noopener noreferrer"
                   style="display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--text,#1c1917);font-weight:700;font-size:12px;background:var(--card,#fff);border:1px solid var(--border,#e7e5e4);border-radius:12px;padding:7px 12px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    @L["wn.repo"]
                </a>
                <button type="button" @onclick="CloseAsync"
                        style="border:0;border-radius:12px;background:var(--ink,#1c1917);color:#fff;font-size:13px;font-weight:700;padding:10px 20px;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.16);">
                    @L["wn.gotIt"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string RepoUrl = "https://github.com/AhmMed29/jamrah";

    private IReadOnlyList<ChangelogRelease> _releases = Array.Empty<ChangelogRelease>();
    private ChangelogRelease? _active;
    private string _filter = "all";
    private bool _open;
    private bool _needFocus;
    private ElementReference _overlayRef;

    private List<ChangelogItem> Filtered => _active is null
        ? new List<ChangelogItem>()
        : _active.Items.Where(i => _filter == "all" || i.Type == _filter).ToList();

    private IEnumerable<(string Key, string Label)> Filters => new[]
    {
        ("all", L["wn.all"]),
        ("feature", L["wn.features"]),
        ("fix", L["wn.fixes"]),
        ("improvement", L["wn.polish"])
    };

    private (string Pill, string TileBg, string TileBorder, string Label) KindOf(string type) => type switch
    {
        "feature" => ("linear-gradient(90deg,#7c3aed,#4f46e5)", "#f5f3ff", "#ede9fe", L["wn.newFeature"]),
        "fix" => ("linear-gradient(90deg,#e11d48,#dc2626)", "#fff1f2", "#ffe4e6", L["wn.fix"]),
        _ => ("linear-gradient(90deg,#059669,#0d9488)", "#ecfdf5", "#d1fae5", L["wn.improvement"])
    };

    protected override void OnInitialized()
    {
        Changelog.OpenRequested += OnOpenRequested;
        Updates.Changed += OnUpdatesChanged;
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        _releases = await Changelog.LoadAsync();
        if (_active is null && _releases.Count > 0) _active = _releases[0];
        await InvokeAsync(StateHasChanged);
    }

    private void OnOpenRequested()
    {
        _ = InvokeAsync(() =>
        {
            _open = true;
            _needFocus = true;
            StateHasChanged();
        });
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = AutoShowAsync();
            return;
        }
        if (_open && _needFocus)
        {
            _needFocus = false;
            try { await _overlayRef.FocusAsync(); } catch { }
        }
    }

    /// <summary>Opens the window the first time this release is seen.</summary>
    private async Task AutoShowAsync()
    {
        try
        {
            // Let the update check settle first, then wait for the update window
            // to be dismissed - the two must never sit on top of each other.
            var until = DateTime.UtcNow.AddSeconds(6);
            while (DateTime.UtcNow < until)
            {
                var st = Updates.State;
                if (st.Stage != UpdateStage.Idle && st.Stage != UpdateStage.Checking) break;
                await Task.Delay(250);
            }
            until = DateTime.UtcNow.AddSeconds(60);
            while (Updates.State.PromptVisible && DateTime.UtcNow < until) await Task.Delay(400);
            if (Updates.State.PromptVisible) return;

            await LoadAsync();
            var latest = _releases.FirstOrDefault();
            if (latest is null) return;
            var seen = await Settings.GetAsync(ChangelogService.SeenKey);
            if (!string.IsNullOrEmpty(seen) && seen == latest.Version) return;
            await InvokeAsync(() =>
            {
                _active = latest;
                _open = true;
                _needFocus = true;
                StateHasChanged();
            });
        }
        catch { }
    }

    private void SelectVersion(string version)
    {
        var r = _releases.FirstOrDefault(x => x.Version == version);
        if (r is not null) _active = r;
    }

    private async Task CloseAsync()
    {
        _open = false;
        await RememberAsync();
        StateHasChanged();
    }

    /// <summary>Remembers the newest release so the window stays closed for it.</summary>
    private async Task RememberAsync()
    {
        var latest = _releases.FirstOrDefault();
        if (latest is null) return;
        try { await Settings.SetAsync(ChangelogService.SeenKey, latest.Version); } catch { }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private async Task OpenIssue(bool bug)
    {
        var title = bug ? L["wn.reportBug"] : L["wn.requestFeature"];
        var body = bug
            ? L["wn.reportBugBody"]
            : L["wn.requestFeatureBody"];
        var url = $"{RepoUrl}/issues/new?title={Uri.EscapeDataString(title)}&body={Uri.EscapeDataString(body)}";
        try { await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(url); } catch { }
    }

    public void Dispose()
    {
        Changelog.OpenRequested -= OnOpenRequested;
        Updates.Changed -= OnUpdatesChanged;
    }
}
