@namespace Jamrah.Components.Tasks
@* تصميم فقط - Topbar view-switcher فقط، السايدبار بدون Board/Matrix *@

<div class="app" dir="rtl">
    <aside class="sidebar">
        <div class="brand"><div class="brand-mark">J</div><div class="brand-name">Jamrah</div></div>
        
        <!-- Sidebar -->
        <button class="sidebar-toggle" onclick="document.querySelector('.sidebar').classList.toggle('collapsed'); document.querySelector('.main').classList.toggle('sidebar-collapsed')" title="فتح/إغلاق">‹</button>
        
        <div class="nav-section">
            <div class="nav-label">MY TASKS</div>
            <button class="nav-item active"><span class="nav-icon">○</span><span>اليوم</span><span class="nav-count">3</span></button>
            <button class="nav-item"><span class="nav-icon">→</span><span>القادمة</span><span class="nav-count">0</span></button>
            <button class="nav-item"><span class="nav-icon">□</span><span>بدون تاريخ</span><span class="nav-count">1</span></button>
        </div>
        <div class="nav-section">
            <div class="nav-label">HISTORY</div>
            <button class="nav-item"><span class="nav-icon">✓</span><span>تم الإنجاز</span><span class="nav-count">1</span></button>
            <button class="nav-item"><span class="nav-icon">▱</span><span>الأرشيف</span><span class="nav-count">0</span></button>
        </div>
        <div class="storage-chart">
            <div class="storage-top"><span>نشاط اليوم</span><span style="font-size:10px;color:var(--muted)">هوفر لعرض المهمة</span></div>
            <div class="curve-wrap">
                <svg viewBox="0 0 240 60" class="activity-curve" preserveAspectRatio="none">
                    <path d="M0,54 C40,54 70,14 100,12 C118,11 118,46 122,47 C126,48 132,14 140,13 C175,11 205,54 240,52"
                          fill="none" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="100" cy="12" r="3" fill="var(--text)"><title>مراجعة LINQ - 10:00 ص</title></circle>
                    <circle cx="140" cy="13" r="3" fill="var(--text)"><title>حل تمارين C# - 2:00 م</title></circle>
                    <circle cx="122" cy="47" r="2.2" fill="var(--muted)"><title>فجوة - لا مهام</title></circle>
                    <line class="now-line" x1="0" y1="0" x2="0" y2="60" stroke="#DC2626" stroke-width="1.2"/>
                </svg>
            </div>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-title">
                <h1>اليوم</h1>
                <div class="view-switcher">
                    <button class="view-btn active" data-layout="list">قائمة</button>
                    <button class="view-btn" data-layout="board">Board</button>
                    <button class="view-btn" data-layout="matrix">Matrix</button>
                </div>
            </div>
            <div class="topbar-actions">
                <button class="icon-btn" title="اليوم">◷</button>
                <button class="primary-btn"><span>+</span><span>مهمة جديدة</span></button>
            </div>
        </header>

        <section class="content">
            <div class="day-header">
                <div class="day-info">
                    <div class="day-nav"><button class="day-nav-btn">→</button><button class="day-nav-btn">←</button></div>
                    <div class="date-block"><div class="date-title">اليوم</div><div class="date-subtitle">الخميس، 4 سبتمبر</div></div>
                    <button class="today-btn">اليوم</button>
                </div>
                <div class="day-progress"><div class="progress-info"><span>إنجاز اليوم</span><strong>1 / 3</strong></div><div class="progress-bar"><div class="progress-fill" style="width:33%"></div></div></div>
            </div>
            <div class="quick-add"><div class="quick-add-plus">+</div><input type="text" placeholder="أضف مهمة بسرعة..." /><div class="quick-add-hint">Enter للإضافة</div></div>
            <div id="viewContainer">
                <section class="task-section">
                    <div class="section-header"><div class="section-title"><span class="section-dot"></span><span>المهام</span><span class="section-count">2</span></div><div class="section-actions"><button class="section-action">إنهاء الكل</button></div></div>
                    <div class="task-list">
                        <div class="task-row"><button class="task-check"></button><span class="priority-dot priority-high"></span><div class="task-main"><div class="task-title">مراجعة LINQ</div><div class="task-meta"><span class="task-meta-item">◷ 10:00</span><span class="task-meta-item">▤ ملاحظات</span></div></div><button class="task-more">⋮</button></div>
                        <div class="task-row completed"><button class="task-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l4 4L19 6"/></svg></button><span class="priority-dot priority-medium"></span><div class="task-main"><div class="task-title">حل تمارين C#</div><div class="task-meta"><span class="task-meta-item">▣ 5 سبتمبر</span></div></div><button class="task-more">⋮</button></div>
                        <div class="task-row"><button class="task-check"></button><span class="priority-dot priority-low"></span><div class="task-main"><div class="task-title">بناء API للـ Student Management</div><div class="task-meta"><span class="task-meta-item">↻ يومي</span></div></div><button class="task-more">⋮</button></div>
                    </div>
                </section>
                @* Board/Matrix مخفيين حالياً - هيظهروا بزرار الـ Topbar في الربط *@
            </div>
        </section>
    </main>

    <aside class="details"><div class="details-header"><div class="details-header-title">تفاصيل المهمة</div><button class="icon-btn">×</button></div><div class="details-body"><div class="details-title">مراجعة LINQ</div></div><div class="details-footer"><button class="archive-btn">▱</button><button class="delete-btn">×</button><button class="save-btn">حفظ التغييرات</button></div></aside>
</div>

<div class="modal-overlay"><div class="modal"><div class="modal-header"><div class="modal-title">إضافة مهمة جديدة</div><button class="icon-btn">×</button></div><div class="modal-body"><div class="field"><label class="field-label">اسم المهمة</label><input class="field-input" placeholder="مثلاً: مراجعة LINQ" /></div></div><div class="modal-footer"><button class="secondary-btn">إلغاء</button><button class="primary-btn">إضافة المهمة</button></div></div></div>
<div class="context-menu"><button class="context-item">✓ تغيير حالة الإنجاز</button><button class="context-item">✎ تعديل</button><button class="context-item">▱ أرشفة</button><button class="context-item danger">× حذف</button></div>

    <style>
        /* =========================================================
           ROOT
        ========================================================= */

        :root {
            --bg: #FAFAF9;
            --surface: #FFFFFF;
            --surface-soft: #F5F5F4;

            --border: #E7E5E4;
            --border-light: #E7E5E4;
            --border2: #D6D3D1;

            --text: #1C1917;
            --text-soft: #78716C;
            --muted: #78716C;

            --orange: #FF6B35;
            --orange-soft: #F5F5F4;

            --green: #1C1917;
            --green-soft: #F5F5F4;

            --blue: #57534E;
            --blue-soft: #F5F5F4;

            --red: #DC2626;
            --red-soft: rgba(220, 38, 38, .08);

            --yellow: #78716C;
            --yellow-soft: #F5F5F4;

            --purple: #57534E;
            --purple-soft: #F5F5F4;

            --radius-sm: 8px;
            --radius: 12px;
            --radius-lg: 16px;

            --sidebar-width: 255px;
            --details-width: 350px;

            --shadow: 0 8px 32px rgba(0, 0, 0, .12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Tajawal", sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        button {
            border: 0;
            cursor: pointer;
        }

        input,
        textarea,
        select {
            outline: none;
        }

        /* =========================================================
           APP
        ========================================================= */

        .app {
            display: flex;
            min-height: 100vh;
        }

        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;

            background: var(--surface);
            border-left: 1px solid var(--border);

            padding: 22px 14px;

            display: flex;
            flex-direction: column;

            position: fixed;
            right: 0;
            top: 0;
            bottom: 0;

            z-index: 50;
        }
        .sidebar{transition:width .25s ease, padding .25s ease}
        .sidebar.collapsed{width:62px; padding:15px 8px}
        .sidebar.collapsed .brand-name, .sidebar.collapsed .nav-label, .sidebar.collapsed .nav-item span:not(.nav-icon), .sidebar.collapsed .storage{display:none}
        .sidebar.collapsed .nav-item{justify-content:center}
        .sidebar-toggle{position:absolute; left:-14px; top:20px; width:28px; height:28px; border-radius:50%; background:var(--surface); border:1px solid var(--border); display:grid; place-items:center; cursor:pointer; font-size:14px; color:var(--text); box-shadow:0 1px 4px rgba(0,0,0,.08); z-index:60}
        .sidebar.collapsed .sidebar-toggle{transform:rotate(180deg)}
        .main.sidebar-collapsed{margin-right:62px; width:calc(100% - 62px)}
        
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 5px 10px 22px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;

            border-radius: 10px;

            background: var(--text);
            color: white;

            display: grid;
            place-items: center;

            font-size: 18px;
            font-weight: 700;
        }

        .brand-name {
            font-size: 16px;
            font-weight: 700;
        }

        .nav-section {
            margin-bottom: 20px;
        }

        .nav-label {
            font-size: 11px;
            color: var(--muted);

            padding: 0 12px;
            margin-bottom: 7px;

            font-weight: 700;
        }

        .nav-item {
            width: 100%;

            display: flex;
            align-items: center;
            gap: 10px;

            padding: 10px 12px;

            border-radius: 10px;

            background: transparent;
            color: var(--text-soft);

            text-align: right;

            transition: .15s ease;
        }

        .nav-item:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .nav-item.active {
            background: var(--text);
            color: #fff;
            font-weight: 700;
        }

        .nav-icon {
            width: 19px;
            text-align: center;
            font-size: 15px;
        }

        .nav-count {
            margin-right: auto;

            min-width: 21px;
            height: 21px;

            display: grid;
            place-items: center;

            padding: 0 6px;

            border-radius: 6px;

            font-size: 11px;
            background: var(--surface-soft);
            color: var(--muted);
        }

        .nav-item.active .nav-count {
            background: rgba(255, 255, 255, .18);
            color: #fff;
        }

        .sidebar-bottom {
            margin-top: auto;

            border-top: 1px solid var(--border-light);
            padding-top: 15px;
        }

        .storage {
            padding: 10px 12px;
        }

        .storage-chart{padding:10px 12px}
        .curve-wrap{
            position:relative; margin-top:8px; height:62px; border-radius:8px; overflow:hidden;
            background-color:var(--surface-soft);
            background-image:
                linear-gradient(var(--border) 0.5px, transparent 0.5px),
                linear-gradient(90deg, var(--border) 0.5px, transparent 0.5px),
                linear-gradient(var(--border2) 0.8px, transparent 0.8px),
                linear-gradient(90deg, var(--border2) 0.8px, transparent 0.8px);
            background-size: 10px 10px, 10px 10px, 60px 60px, 60px 60px;
        }
        .activity-curve{width:100%; height:100%; display:block; overflow:visible}
        .activity-curve circle{cursor:pointer; transition:r .15s}
        .activity-curve circle:hover{r:5}
        .now-line{transition:x1 .5s, x2 .5s}
        
        .storage-top {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;

            font-size: 11px;
            color: var(--muted);
        }

        .storage-bar {
            height: 5px;
            border-radius: 20px;
            background: var(--border-light);
            overflow: hidden;
        }

        .storage-progress {
            height: 100%;
            width: 40%;
            background: var(--text);
            border-radius: inherit;
        }

        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            margin-right: var(--sidebar-width);

            width: calc(100% - var(--sidebar-width));

            min-width: 0;

            transition: .2s ease;
        }

        .main.details-open {
            margin-left: var(--details-width);
        }

        /* =========================================================
           TOPBAR
        ========================================================= */

        .topbar {
            height: 52px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 16px;

            border-bottom: 1px solid var(--border);

            background: var(--surface);

            position: sticky;
            top: 0;
            z-index: 30;
        }

        .topbar-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-title h1 {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0;
        }

        .view-switcher {
            display: flex;
            align-items: center;

            padding: 3px;

            background: var(--surface-soft);
            border: 1px solid var(--border);

            border-radius: 10px;
        }

        .view-btn {
            padding: 7px 12px;

            background: transparent;
            color: var(--muted);

            border-radius: 7px;

            font-size: 12px;
            font-weight: 600;
        }

        .view-btn:hover {
            color: var(--text);
        }

        .view-btn.active {
            background: var(--text);
            color: #fff;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            width: 32px;
            height: 32px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            color: var(--text-soft);

            border: 1px solid var(--border);

            background: var(--surface);
        }

        .icon-btn:hover {
            background: var(--surface-soft);
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            height: 32px;

            padding: 0 12px;

            background: var(--text);
            color: white;

            border-radius: 10px;

            font-size: 12px;
            font-weight: 500;
        }

        .primary-btn:hover {
            opacity: .9;
        }

        /* =========================================================
           CONTENT
        ========================================================= */

        .content {
            max-width: 1080px;
            margin: 0 auto;

            padding: 28px 30px 60px;
        }

        /* =========================================================
           DAY HEADER
        ========================================================= */

        .day-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 22px;
        }

        .day-info {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .day-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .day-nav-btn {
            width: 32px;
            height: 32px;

            display: grid;
            place-items: center;

            border-radius: 8px;

            color: var(--text-soft);
            background: transparent;
        }

        .day-nav-btn:hover {
            background: white;
            border: 1px solid var(--border);
        }

        .date-block {
            min-width: 175px;
        }

        .date-title {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
        }

        .date-subtitle {
            margin-top: 3px;

            font-size: 12px;
            color: var(--muted);
        }

        .today-btn {
            padding: 6px 10px;

            border: 1px solid var(--border);
            background: white;

            border-radius: 7px;

            font-size: 11px;
            font-weight: 700;

            color: var(--text-soft);
        }

        .today-btn:hover {
            border-color: var(--text);
            color: var(--text);
        }

        .date-picker {
            width: 34px;
            height: 34px;

            border: 1px solid var(--border);
            background: white;

            border-radius: 8px;

            cursor: pointer;
            color: var(--text-soft);
        }

        .day-progress {
            min-width: 180px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;

            margin-bottom: 7px;

            font-size: 11px;
            color: var(--muted);
        }

        .progress-info strong {
            color: var(--text);
        }

        .progress-bar {
            height: 6px;

            border-radius: 20px;
            background: var(--border);

            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0;

            background: var(--text);
            border-radius: inherit;

            transition: width .25s ease;
        }

        /* =========================================================
           QUICK ADD
        ========================================================= */

        .quick-add {
            display: flex;
            align-items: center;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 12px;

            margin-bottom: 24px;

            transition: .15s ease;
        }

        .quick-add:focus-within {
            border-color: var(--text);
        }

        .quick-add-plus {
            width: 46px;

            display: grid;
            place-items: center;

            font-size: 19px;
            color: var(--text);
        }

        .quick-add input {
            flex: 1;

            height: 50px;

            border: 0;

            font-size: 13px;
            color: var(--text);

            background: transparent;
        }

        .quick-add input::placeholder {
            color: var(--muted);
        }

        .quick-add-hint {
            padding: 0 14px;

            font-size: 10px;
            color: var(--muted);
        }

        /* =========================================================
           SECTION
        ========================================================= */

        .task-section {
            margin-bottom: 25px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 9px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;

            font-size: 12px;
            font-weight: 700;
            color: var(--text);
        }

        .section-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;
            background: var(--border2);
        }

        .section-count {
            color: var(--muted);
            font-size: 10px;
            font-weight: 500;
        }

        .section-actions {
            display: flex;
            gap: 5px;
        }

        .section-action {
            font-size: 11px;
            color: var(--muted);
            background: transparent;
            padding: 4px 6px;
            border-radius: 6px;
        }

        .section-action:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        /* =========================================================
           TASK LIST
        ========================================================= */

        .task-list {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 12px;

            overflow: hidden;
        }

        .task-row {
            min-height: 55px;

            display: flex;
            align-items: center;

            gap: 10px;

            padding: 8px 13px;

            border-bottom: 1px solid var(--border-light);

            cursor: pointer;

            transition: background .12s ease;
        }

        .task-row:last-child {
            border-bottom: 0;
        }

        .task-row:hover {
            background: var(--surface-soft);
        }

        .task-row.selected {
            background: var(--surface-soft);
        }

        .task-check {
            width: 19px;
            height: 19px;

            flex-shrink: 0;

            border: 1px solid var(--border2);
            border-radius: 6px;

            background: var(--surface);

            display: grid;
            place-items: center;

            transition: .15s ease;
        }

        .task-check:hover {
            border-color: var(--text);
        }

        .task-row.completed .task-check {
            background: var(--text);
            border-color: var(--text);
            color: white;
        }

        .task-check svg {
            width: 12px;
            height: 12px;
        }

        .priority-dot {
            width: 7px;
            height: 7px;

            flex-shrink: 0;

            border-radius: 50%;
        }

        .priority-low {
            background: #A8A29E;
        }

        .priority-medium {
            background: #78716C;
        }

        .priority-high {
            background: #57534E;
        }

        .priority-urgent {
            background: #1C1917;
        }

        .task-main {
            min-width: 0;
            flex: 1;
        }

        .task-title {
            font-size: 12px;
            font-weight: 500;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .task-row.completed .task-title {
            color: var(--muted);
            text-decoration: line-through;
        }

        .task-meta {
            display: flex;
            align-items: center;
            gap: 8px;

            margin-top: 3px;

            font-size: 10px;
            color: var(--muted);
        }

        .task-meta-item {
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .task-more {
            width: 28px;
            height: 28px;

            display: grid;
            place-items: center;

            border-radius: 7px;

            color: var(--muted);
            background: transparent;

            opacity: 0;
        }

        .task-row:hover .task-more {
            opacity: 1;
        }

        .task-more:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        /* =========================================================
           EMPTY
        ========================================================= */

        .empty {
            padding: 55px 20px;

            display: flex;
            flex-direction: column;
            align-items: center;

            text-align: center;
        }

        .empty-icon {
            width: 48px;
            height: 48px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background: var(--surface-soft);

            color: var(--muted);

            font-size: 20px;

            margin-bottom: 13px;
        }

        .empty-title {
            font-size: 14px;
            font-weight: 700;
        }

        .empty-text {
            max-width: 300px;

            margin-top: 5px;

            color: var(--muted);
            font-size: 11px;
            line-height: 1.7;
        }

        /* =========================================================
           UPCOMING / OTHER VIEWS
        ========================================================= */

        .date-group {
            margin-bottom: 24px;
        }

        .date-group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 8px;
        }

        .date-group-title {
            font-size: 12px;
            font-weight: 700;
        }

        .date-group-title span {
            color: var(--muted);
            font-weight: 500;
            margin-right: 5px;
        }

        .date-group-count {
            font-size: 10px;
            color: var(--muted);
        }

        /* =========================================================
           BOARD
        ========================================================= */

        .board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 13px;

            align-items: start;
        }

        .board-column {
            background: var(--surface-soft);

            border: 1px solid var(--border);

            border-radius: 14px;

            padding: 10px;

            min-height: 250px;
        }

        .board-column-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 3px 4px 10px;
        }

        .board-column-title {
            font-size: 12px;
            font-weight: 700;
        }

        .board-column-count {
            min-width: 22px;
            height: 21px;

            display: grid;
            place-items: center;

            border-radius: 6px;

            background: white;

            color: var(--muted);

            font-size: 10px;
        }

        .board-list {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .board-card {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 10px;

            padding: 10px;

            cursor: pointer;

            transition: .15s ease;
        }

        .board-card:hover {
            box-shadow: 0 1px 2px rgba(0,0,0,.04);
        }

        .board-card-title {
            font-size: 12px;
            font-weight: 500;
            line-height: 1.4;

            margin-bottom: 9px;
        }

        .board-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            color: var(--muted);

            font-size: 10px;
        }

        /* =========================================================
           EISENHOWER
        ========================================================= */

        .matrix {
            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 12px;
        }

        .matrix-box {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 14px;

            padding: 13px;

            min-height: 220px;
        }

        .matrix-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 11px;
        }

        .matrix-title {
            display: flex;
            align-items: center;
            gap: 7px;

            font-size: 12px;
            font-weight: 700;
        }

        .matrix-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .matrix-subtitle {
            color: var(--muted);
            font-size: 10px;
        }

        .matrix-tasks {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .matrix-task {
            padding: 9px 10px;

            border: 1px solid var(--border-light);

            border-radius: 8px;

            font-size: 11px;

            cursor: pointer;
        }

        .matrix-task:hover {
            background: var(--surface-soft);
        }

        /* =========================================================
           DETAILS SIDEBAR
        ========================================================= */

        .details {
            width: var(--details-width);

            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;

            background: white;

            border-right: 1px solid var(--border);

            z-index: 60;

            transform: translateX(-100%);
            transition: transform .22s ease;

            display: flex;
            flex-direction: column;
        }

        .details.open {
            transform: translateX(0);
        }

        .details-header {
            height: 72px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 18px;

            border-bottom: 1px solid var(--border);
        }

        .details-header-title {
            font-size: 13px;
            font-weight: 700;
        }

        .details-header-actions {
            display: flex;
            gap: 4px;
        }

        .details-body {
            flex: 1;
            overflow-y: auto;

            padding: 20px;
        }

        .details-title {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.5;

            margin-bottom: 20px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field-label {
            display: block;

            font-size: 10px;
            color: var(--muted);

            font-weight: 700;

            margin-bottom: 7px;
        }

        .field-input,
        .field-select,
        .field-textarea {
            width: 100%;

            border: 1px solid var(--border);

            background: var(--bg);

            border-radius: 10px;

            padding: 8px 10px;

            color: var(--text);

            font-size: 12px;
        }

        .field-input:focus,
        .field-select:focus,
        .field-textarea:focus {
            background: var(--surface);
            border-color: var(--text);
        }

        .field-textarea {
            min-height: 100px;
            resize: vertical;

            line-height: 1.7;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .status-btn {
            width: 100%;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;

            padding: 10px;

            border: 1px solid var(--border);

            border-radius: 10px;

            background: var(--surface);

            font-size: 11px;
            font-weight: 700;

            color: var(--text-soft);
        }

        .status-btn.completed {
            background: var(--text);
            border-color: var(--text);
            color: #fff;
        }

        .details-footer {
            border-top: 1px solid var(--border);

            padding: 13px 18px;

            display: flex;
            gap: 8px;
        }

        .save-btn {
            flex: 1;

            height: 32px;

            border-radius: 10px;

            background: var(--text);
            color: white;

            font-size: 12px;
            font-weight: 500;
        }

        .save-btn:hover {
            opacity: .9;
        }

        .delete-btn {
            width: 40px;
            height: 32px;

            border-radius: 10px;

            background: var(--red-soft);
            color: var(--red);
        }

        .archive-btn {
            width: 40px;
            height: 32px;

            border-radius: 10px;

            background: var(--surface-soft);
            color: var(--text-soft);
        }

        /* =========================================================
           MODAL
        ========================================================= */

        .modal-overlay {
            position: fixed;
            inset: 0;

            background: rgba(28,25,23,.22);
            backdrop-filter: blur(4px);

            display: none;
            align-items: center;
            justify-content: center;

            z-index: 100;

            padding: 20px;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal {
            width: 100%;
            max-width: 450px;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 16px;

            box-shadow: 0 20px 40px rgba(0,0,0,.06);

            overflow: hidden;
        }

        .modal-header {
            padding: 16px 16px 10px;

            border-bottom: 1px solid var(--border);

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 13px;
            font-weight: 700;
        }

        .modal-body {
            padding: 16px;
        }

        .modal-footer {
            padding: 13px 16px;

            border-top: 1px solid var(--border);

            display: flex;
            justify-content: flex-start;
            gap: 6px;
        }

        .secondary-btn {
            height: 32px;

            padding: 0 12px;

            border: 1px solid var(--border);

            background: var(--surface);

            border-radius: 10px;

            color: var(--text);

            font-size: 12px;
            font-weight: 500;
        }

        .secondary-btn:hover {
            background: var(--surface-soft);
        }

        /* =========================================================
           CONTEXT MENU
        ========================================================= */

        .context-menu {
            position: fixed;

            min-width: 155px;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 10px;

            box-shadow: 0 8px 24px rgba(0,0,0,.1);

            padding: 5px;

            z-index: 200;

            display: none;
        }

        .context-menu.open {
            display: block;
        }

        .context-item {
            width: 100%;

            display: flex;
            align-items: center;
            gap: 8px;

            padding: 8px 9px;

            border-radius: 6px;

            background: transparent;

            color: var(--text-soft);

            font-size: 11px;

            text-align: right;
        }

        .context-item:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .context-item.danger {
            color: var(--red);
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1000px) {
            :root {
                --sidebar-width: 220px;
            }

            .board {
                grid-template-columns: 1fr;
            }

            .day-progress {
                display: none;
            }
        }

        @@media (max-width: 760px) {
            .sidebar {
                width: 62px;
                padding: 15px 8px;
            }

            .brand {
                justify-content: center;
                padding: 3px 0 20px;
            }

            .brand-name,
            .nav-label,
            .nav-item span:not(.nav-icon),
            .nav-count,
            .storage {
                display: none;
            }

            .nav-item {
                justify-content: center;
                padding: 11px;
            }

            .main {
                margin-right: 62px;
                width: calc(100% - 62px);
            }

            .topbar {
                padding: 0 15px;
            }

            .topbar-title h1 {
                display: none;
            }

            .view-switcher {
                margin-right: 0;
            }

            .content {
                padding: 20px 15px 50px;
            }

            .day-header {
                align-items: flex-start;
            }

            .date-block {
                min-width: 0;
            }

            .date-title {
                font-size: 17px;
            }

            .matrix {
                grid-template-columns: 1fr;
            }

            .details {
                width: min(350px, 90vw);
            }

            .main.details-open {
                margin-left: 0;
            }
        }

        @@media (max-width: 500px) {
            .view-btn {
                padding: 7px 8px;
                font-size: 10px;
            }

            .primary-btn span {
                display: none;
            }

            .day-header {
                gap: 10px;
            }

            .day-nav {
                order: 2;
            }

            .day-info {
                gap: 6px;
            }

            .today-btn {
                display: none;
            }

            .task-meta-item.hide-mobile {
                display: none;
            }
        }

        /* =========================================================
           SCROLLBAR
        ========================================================= */

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 4px;
        }

        /* =========================================================
           UTILITY
        ========================================================= */

        .hidden {
            display: none !important;
        }

        .text-green {
            color: var(--green);
        }

        .text-muted {
            color: var(--muted);
        }
    </style>

    <script>
        (function(){
            var now = new Date();
            var x = (now.getHours() + now.getMinutes()/60) * 10; // 10px لكل ساعة
            document.querySelectorAll('.now-line').forEach(function(l){
                l.setAttribute('x1', x); l.setAttribute('x2', x);
            });
        })();
    </script>