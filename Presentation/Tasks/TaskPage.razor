            align-items: center;
            justify-content: space-between;

            padding: 3px 4px 10px;
        }

        .board-column-title {
            font-size: 12px;
            font-weight: 700;
        }

        .board-column-count {
            min-width: 22px;
            height: 21px;

            display: grid;
            place-items: center;

            border-radius: 6px;

            background: white;

            color: var(--muted);

            font-size: 10px;
        }

        .board-list {
            display: flex;
            flex-direction: column;
            gap: 7px;
