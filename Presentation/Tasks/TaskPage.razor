@namespace Jamrah.Presentation.Tasks
@using Jamrah.Core.Entities
@using Jamrah.Application.Services
@inject TaskStateService TaskState
@inject NavigationManager Nav
@implements IDisposable

<div class="app" dir="rtl">
    <aside class="sidebar @( _sidebarCollapsed ? "collapsed" : "" )" id="sidebar">
        <div class="sidebar-top">
            <button class="sidebar-toggle" @onclick="ToggleSidebar" title="طي / توسيع" aria-label="طي السايدبار">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 18L9 12L15 6"></path>
                </svg>
            </button>
        </div>

        <div class="nav-squares">
            <button class="nav-square @(_view=="today" ? "active" : "")" @onclick='() => SetView("today")' title="اليوم">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                    <circle cx="12" cy="15" r="2.1"></circle>
                </svg>
                @if(_todayCount>0){<span class="nav-square-count">@_todayCount</span>}
            </button>
            <button class="nav-square @(_view=="upcoming" ? "active" : "")" @onclick='() => SetView("upcoming")' title="القادمة">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                    <path d="M12 15l3 -3 3 3"></path>
                    <path d="M12 12v6"></path>
                </svg>
                @if(_upcomingCount>0){<span class="nav-square-count">@_upcomingCount</span>}
            </button>
            <button class="nav-square @(_view=="no-date" ? "active" : "")" @onclick='() => SetView("no-date")' title="بدون تاريخ">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                    <path d="M9 16h6"></path>
                </svg>
                @if(_noDateCount>0){<span class="nav-square-count">@_noDateCount</span>}
            </button>
            <button class="nav-square @(_view=="completed" ? "active" : "")" @onclick='() => SetView("completed")' title="تم الإنجاز">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8.5 12l2.3 2.3L15.5 9.5"></path>
                </svg>
                @if(_completedCount>0){<span class="nav-square-count">@_completedCount</span>}
            </button>
            <button class="nav-square @(_view=="archived" ? "active" : "")" @onclick='() => SetView("archived")' title="الأرشيف">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="5" rx="1.2"></rect>
                    <path d="M5 9h14v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V9z"></path>
                    <path d="M9.5 13h5"></path>
                </svg>
                @if(_archivedCount>0){<span class="nav-square-count">@_archivedCount</span>}
            </button>
        </div>

        <div class="today-card">
            <div class="today-card-label">اليوم</div>
            <div class="today-card-date">@_currentDateStr</div>
            <div class="today-card-time">@_currentTimeStr</div>
            <div class="today-card-sub">@_currentSubStr</div>
        </div>

        <div class="nav-section">
            <div class="nav-label">VIEWS</div>
            <button class="nav-item @(_view=="board" ? "active" : "")" @onclick='() => SetView("board")'>
                <span class="nav-icon">▦</span><span>Board</span>
            </button>
            <button class="nav-item @(_view=="matrix" ? "active" : "")" @onclick='() => SetView("matrix")'>
                <span class="nav-icon">⊞</span><span>Eisenhower</span>
            </button>
        </div>
    </aside>

    <main class="main @(_sidebarCollapsed ? "sidebar-collapsed" : "") @(_selectedTask!=null ? "details-open" : "")" id="main">
        <header class="topbar">
            <div class="topbar-title">
                <h1>@PageTitle</h1>
            </div>
            <div class="topbar-actions">
                <button class="icon-btn" @onclick="GoToday" title="اليوم">◷</button>
                <button class="primary-btn" @onclick="OpenCreateModal"><span>+</span><span>مهمة جديدة</span></button>
            </div>
        </header>

        <section class="content">
            @if(_view=="today"){
                <div class="day-header">
                    <div class="day-info">
                        <div class="day-nav">
                            <button class="day-nav-btn" @onclick="PrevDay" title="اليوم السابق">→</button>
                            <button class="day-nav-btn" @onclick="NextDay" title="اليوم التالي">←</button>
                        </div>
                        <div class="date-block">
                            <div class="date-title">@(_currentDate.Date==DateTime.Today ? "اليوم" : FormatDate(_currentDate))</div>
                            <div class="date-subtitle">@FormatDate(_currentDate)</div>
                        </div>
                        <button class="today-btn" @onclick="GoToday">اليوم</button>
                        <input type="date" class="date-picker" value="@_currentDate.ToString("yyyy-MM-dd")" @onchange="OnDatePicked" title="اختيار تاريخ" />
                    </div>
                    <div class="day-progress">
                        <div class="progress-info"><span>إنجاز اليوم</span><strong>@_dayCompleted / @_dayTotal</strong></div>
                        <div class="progress-bar"><div class="progress-fill" style="width:@_dayPercent%"></div></div>
                    </div>
                </div>
            }

            @if(_view!="completed" && _view!="archived"){
                <div class="quick-add">
                    <div class="quick-add-plus">+</div>
                    <input type="text" placeholder="أضف مهمة بسرعة..." @bind="_quickTitle" @bind:event="oninput" @onkeydown="OnQuickKeyDown" />
                    <div class="quick-add-hint">Enter للإضافة</div>
                </div>
            }

            <div id="viewContainer">
                @if(_view=="today"){
                    @DayListView
                } else if(_view=="upcoming"){
                    @UpcomingView
                } else if(_view=="no-date"){
                    @NoDateView
                } else if(_view=="completed"){
                    @CompletedView
                } else if(_view=="archived"){
                    @ArchivedView
                } else if(_view=="board"){
                    @BoardView
                } else if(_view=="matrix"){
                    @MatrixView
                }
            </div>
        </section>
    </main>

    <aside class="details @(_selectedTask!=null ? "open" : "")" id="detailsPanel">
        <div class="details-header">
            <div class="details-header-title">تفاصيل المهمة</div>
            <div class="details-header-actions">
                <button class="icon-btn" @onclick="CloseDetails" title="إغلاق">×</button>
            </div>
        </div>
        <div class="details-body">
            @if(_selectedTask!=null){
                <div class="details-title">@_selectedTask.Title</div>
                <div class="field">
                    <label class="field-label">اسم المهمة</label>
                    <input class="field-input" @bind="_editTitle" />
                </div>
                <div class="details-grid">
                    <div class="field">
                        <label class="field-label">التاريخ</label>
                        <input class="field-input" type="date" value="@_editDate" @onchange="e => _editDate = e.Value?.ToString()" />
                    </div>
                    <div class="field">
                        <label class="field-label">الوقت</label>
                        <input class="field-input" type="time" value="@_editTime" @onchange="e => _editTime = e.Value?.ToString()" />
                    </div>
                </div>
                <div class="details-grid">
                    <div class="field">
                        <label class="field-label">الأولوية</label>
                        <select class="field-select" @bind="_editPriority">
                            <option value="low">منخفضة</option>
                            <option value="medium">متوسطة</option>
                            <option value="high">عالية</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label">التكرار</label>
                        <select class="field-select" @bind="_editRepeat">
                            <option value="none">بدون تكرار</option>
                            <option value="daily">يومي</option>
                            <option value="weekly">أسبوعي</option>
                            <option value="monthly">شهري</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label class="field-label">Eisenhower</label>
                    <select class="field-select" @bind="_editQuadrant">
                        <option value="1">مهم وعاجل</option>
                        <option value="2">مهم وغير عاجل</option>
                        <option value="3">غير مهم وعاجل</option>
                        <option value="4">غير مهم وغير عاجل</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field-label">الحالة</label>
                    <button class="status-btn @(_selectedTask.IsDone ? "completed" : "")" @onclick="()=>ToggleTask(_selectedTask)">
                        @(_selectedTask.IsDone ? "✓ تم الإنجاز" : "○ قيد التنفيذ")
                    </button>
                </div>
                <div class="field">
                    <label class="field-label">ملاحظات</label>
                    <textarea class="field-textarea" @bind="_editNotes" placeholder="أضف أي تفاصيل تحتاجها..."></textarea>
                </div>
                @if(_selectedTask.CompletedAt!=null){
                    <div style="font-size:10px;color:var(--muted);padding-top:5px;">تم الإنجاز: @FormatDateTime(_selectedTask.CompletedAt.Value)</div>
                }
                @if(_selectedTask.ArchivedAt!=null){
                    <div style="margin-top:12px;padding:10px;background:var(--surface-soft);border-radius:8px;font-size:10px;color:var(--muted);">هذه المهمة موجودة في الأرشيف.</div>
                }
            }
        </div>
        <div class="details-footer">
            <button class="archive-btn" @onclick="ArchiveSelected" title="أرشفة">@(_selectedTask?.ArchivedAt!=null ? "↶" : "▱")</button>
            <button class="delete-btn" @onclick="DeleteSelected" title="حذف">×</button>
            <button class="save-btn" @onclick="SaveSelected">حفظ التغييرات</button>
        </div>
    </aside>
</div>

@if(_showCreateModal){
<div class="modal-overlay open" @onclick="CloseCreateModal">
    <div class="modal" @onclick:stopPropagation="true">
        <div class="modal-header">
            <div class="modal-title">إضافة مهمة جديدة</div>
            <button class="icon-btn" @onclick="CloseCreateModal">×</button>
        </div>
        <div class="modal-body">
            <div class="field">
                <label class="field-label">اسم المهمة</label>
                <input class="field-input" @bind="_newTitle" placeholder="مثلاً: مراجعة LINQ" />
            </div>
            <button type="button" class="secondary-btn" style="margin-bottom:12px; width:100%;" @onclick="()=> _showSchedule = !_showSchedule">
                @(_showSchedule ? "إلغاء الجدولة" : "+ جدولة المهمة")
            </button>
            @if(_showSchedule){
            <div class="details-grid">
                <div class="field">
                    <label class="field-label">التاريخ</label>
                    <input class="field-input" type="date" value="@_newDate" @onchange="e => _newDate = e.Value?.ToString()" />
                </div>
                <div class="field">
                    <label class="field-label">الوقت</label>
                    <input class="field-input" type="time" value="@_newTime" @onchange="e => _newTime = e.Value?.ToString()" />
                </div>
            </div>
            }
            <div class="details-grid">
                <div class="field">
                    <label class="field-label">الأولوية</label>
                    <select class="field-select" @bind="_newPriority">
                        <option value="low">منخفضة</option>
                        <option value="medium">متوسطة</option>
                        <option value="high">عالية</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field-label">التكرار</label>
                    <select class="field-select" @bind="_newRepeat">
                        <option value="none">بدون تكرار</option>
                        <option value="daily">يومي</option>
                        <option value="weekly">أسبوعي</option>
                        <option value="monthly">شهري</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="field-label">ملاحظات</label>
                <textarea class="field-textarea" @bind="_newNotes" placeholder="اختياري..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="primary-btn" @onclick="CreateTask">إضافة المهمة</button>
            <button class="secondary-btn" @onclick="CloseCreateModal">إلغاء</button>
        </div>
    </div>
</div>
}

@if(_contextTaskId!=null){
<div class="context-menu open" style="left:@(_contextX)px; top:@(_contextY)px;">
    <button class="context-item" @onclick="ContextComplete">✓ تغيير حالة الإنجاز</button>
    <button class="context-item" @onclick="ContextEdit">✎ تعديل</button>
    <button class="context-item" @onclick="ContextArchive">▱ أرشفة</button>
    <button class="context-item danger" @onclick="ContextDelete">× حذف</button>
</div>
}


<style>

        /* =========================================================
           ROOT
        ========================================================= */

        :root {
            --bg: #FAFAF9;
            --surface: #FFFFFF;
            --surface-soft: #F5F5F4;

            --border: #E7E5E4;
            --border-light: #E7E5E4;
            --border2: #D6D3D1;

            --text: #1C1917;
            --text-soft: #78716C;
            --muted: #78716C;

            --orange: #FF6B35;
            --orange-soft: #F5F5F4;

            --green: #1C1917;
            --green-soft: #F5F5F4;

            --blue: #57534E;
            --blue-soft: #F5F5F4;

            --red: #DC2626;
            --red-soft: rgba(220, 38, 38, .08);

            --yellow: #78716C;
            --yellow-soft: #F5F5F4;

            --purple: #57534E;
            --purple-soft: #F5F5F4;

            --radius-sm: 8px;
            --radius: 12px;
            --radius-lg: 16px;

            --sidebar-width: 255px;
            --details-width: 350px;

            --shadow: 0 8px 32px rgba(0, 0, 0, .12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Tajawal", sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        button {
            border: 0;
            cursor: pointer;
        }

        input,
        textarea,
        select {
            outline: none;
        }

        /* =========================================================
           APP
        ========================================================= */

        .app {
            display: flex;
            min-height: 100vh;
        }

        /* =========================================================
           SIDEBAR — NEW DESIGN (RIGHT FIXED — MINIMAL)
        ========================================================= */

        .sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;

            background: var(--surface);
            border-left: 1px solid var(--border);

            padding: 14px 12px;

            display: flex;
            flex-direction: column;
            gap: 0;

            position: fixed;
            right: 0;
            top: 0;
            bottom: 0;

            z-index: 50;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width .22s ease, padding .22s ease;
        }

        .sidebar.collapsed {
            width: 72px;
            padding: 14px 8px;
        }

        /* --- toggle — square inside, not on border --- */
        .sidebar-top {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            margin-bottom: 12px;
        }

        .sidebar.collapsed .sidebar-top {
            justify-content: center;
        }

        .sidebar-toggle {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text-soft);
            transition: .15s ease;
        }

        .sidebar-toggle:hover {
            background: var(--surface-soft);
            color: var(--text);
            border-color: var(--border2);
        }

        .sidebar-toggle svg {
            width: 16px;
            height: 16px;
            display: block;
            transition: transform .22s ease;
        }

        .sidebar.collapsed .sidebar-toggle svg {
            transform: rotate(180deg);
        }

        /* --- 5 squares — replaces brand + old vertical nav --- */
        .nav-squares {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
            margin-bottom: 14px;
        }

        .sidebar.collapsed .nav-squares {
            grid-template-columns: 1fr;
            gap: 8px;
            justify-items: center;
        }

        .nav-square {
            aspect-ratio: 1 / 1;
            width: 100%;
            position: relative;
            display: grid;
            place-items: center;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text-soft);
            transition: .15s ease;
        }

        .nav-square:hover {
            background: var(--surface-soft);
            color: var(--text);
            border-color: var(--border2);
        }

        .nav-square.active {
            background: var(--text);
            color: #fff;
            border-color: var(--text);
        }

        .nav-square svg {
            width: 18px;
            height: 18px;
            display: block;
        }

        .nav-square-count {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: 6px;
            background: var(--text);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            display: grid;
            place-items: center;
            line-height: 1;
            border: 1px solid var(--surface);
        }

        .nav-square.active .nav-square-count {
            background: #fff;
            color: var(--text);
            border-color: var(--text);
        }

        .sidebar.collapsed .nav-square {
            width: 44px;
            height: 44px;
        }

        .sidebar.collapsed .nav-square-count {
            top: -4px;
            right: -4px;
        }

        /* --- today card — minimal --- */
        .today-card {
            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 12px;
            margin-bottom: 16px;
        }

        .sidebar.collapsed .today-card {
            display: none;
        }

        .today-card-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--muted);
            letter-spacing: .04em;
            margin-bottom: 6px;
        }

        .today-card-date {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            line-height: 1.4;
            margin-bottom: 6px;
        }

        .today-card-time {
            font-size: 22px;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
            letter-spacing: .02em;
            direction: ltr;
            text-align: right;
        }

        .today-card-sub {
            margin-top: 6px;
            font-size: 11px;
            color: var(--muted);
        }

        .nav-section {
            margin-bottom: 20px;
        }

        .nav-label {
            font-size: 11px;
            color: var(--muted);

            padding: 0 12px;
            margin-bottom: 7px;

            font-weight: 700;
        }

        .sidebar.collapsed .nav-label {
            display: none;
        }

        .nav-item {
            width: 100%;

            display: flex;
            align-items: center;
            gap: 10px;

            padding: 10px 12px;

            border-radius: 10px;

            background: transparent;
            color: var(--text-soft);

            text-align: right;

            transition: .15s ease;
        }

        .nav-item:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .nav-item.active {
            background: var(--text);
            color: #fff;
            font-weight: 700;
        }

        .nav-icon {
            width: 19px;
            text-align: center;
            font-size: 15px;
        }

        .nav-count {
            margin-right: auto;

            min-width: 21px;
            height: 21px;

            display: grid;
            place-items: center;

            padding: 0 6px;

            border-radius: 6px;

            font-size: 11px;
            background: var(--surface-soft);
            color: var(--muted);
        }

        .nav-item.active .nav-count {
            background: rgba(255, 255, 255, .18);
            color: #fff;
        }

        .sidebar.collapsed .nav-item {
            justify-content: center;
            padding: 11px;
        }

        .sidebar.collapsed .nav-item span:not(.nav-icon),
        .sidebar.collapsed .nav-count {
            display: none;
        }

        .main.sidebar-collapsed {
            margin-right: 72px;
            width: calc(100% - 72px);
        }

        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            margin-right: var(--sidebar-width);

            width: calc(100% - var(--sidebar-width));

            min-width: 0;

            transition: .2s ease;
        }

        .main.details-open {
            margin-left: var(--details-width);
        }

        /* =========================================================
           TOPBAR
        ========================================================= */

        .topbar {
            height: 52px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 16px;

            border-bottom: 1px solid var(--border);

            background: var(--surface);

            position: sticky;
            top: 0;
            z-index: 30;
        }

        .topbar-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-title h1 {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0;
        }

        .view-switcher {
            display: flex;
            align-items: center;

            padding: 3px;

            background: var(--surface-soft);
            border: 1px solid var(--border);

            border-radius: 10px;
        }

        .view-btn {
            padding: 7px 12px;

            background: transparent;
            color: var(--muted);

            border-radius: 7px;

            font-size: 12px;
            font-weight: 600;
        }

        .view-btn:hover {
            color: var(--text);
        }

        .view-btn.active {
            background: var(--text);
            color: #fff;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            width: 32px;
            height: 32px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            color: var(--text-soft);

            border: 1px solid var(--border);

            background: var(--surface);
        }

        .icon-btn:hover {
            background: var(--surface-soft);
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            height: 32px;

            padding: 0 12px;

            background: var(--text);
            color: white;

            border-radius: 10px;

            font-size: 12px;
            font-weight: 500;
        }

        .primary-btn:hover {
            opacity: .9;
        }

        /* =========================================================
           CONTENT
        ========================================================= */

        .content {
            max-width: 1080px;
            margin: 0 auto;

            padding: 28px 30px 60px;
        }

        /* =========================================================
           DAY HEADER
        ========================================================= */

        .day-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 22px;
        }

        .day-info {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .day-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .day-nav-btn {
            width: 32px;
            height: 32px;

            display: grid;
            place-items: center;

            border-radius: 8px;

            color: var(--text-soft);
            background: transparent;
        }

        .day-nav-btn:hover {
            background: white;
            border: 1px solid var(--border);
        }

        .date-block {
            min-width: 175px;
        }

        .date-title {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
        }

        .date-subtitle {
            margin-top: 3px;

            font-size: 12px;
            color: var(--muted);
        }

        .today-btn {
            padding: 6px 10px;

            border: 1px solid var(--border);
            background: white;

            border-radius: 7px;

            font-size: 11px;
            font-weight: 700;

            color: var(--text-soft);
        }

        .today-btn:hover {
            border-color: var(--text);
            color: var(--text);
        }

        .date-picker {
            width: 34px;
            height: 34px;

            border: 1px solid var(--border);
            background: white;

            border-radius: 8px;

            cursor: pointer;
            color: var(--text-soft);
        }

        .day-progress {
            min-width: 180px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;

            margin-bottom: 7px;

            font-size: 11px;
            color: var(--muted);
        }

        .progress-info strong {
            color: var(--text);
        }

        .progress-bar {
            height: 6px;

            border-radius: 20px;
            background: var(--border);

            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0;

            background: var(--text);
            border-radius: inherit;

            transition: width .25s ease;
        }

        /* =========================================================
           QUICK ADD
        ========================================================= */

        .quick-add {
            display: flex;
            align-items: center;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 12px;

            margin-bottom: 24px;

            transition: .15s ease;
        }

        .quick-add:focus-within {
            border-color: var(--text);
        }

        .quick-add-plus {
            width: 46px;

            display: grid;
            place-items: center;

            font-size: 19px;
            color: var(--text);
        }

        .quick-add input {
            flex: 1;

            height: 50px;

            border: 0;

            font-size: 13px;
            color: var(--text);

            background: transparent;
        }

        .quick-add input::placeholder {
            color: var(--muted);
        }

        .quick-add-hint {
            padding: 0 14px;

            font-size: 10px;
            color: var(--muted);
        }

        /* =========================================================
           SECTION
        ========================================================= */

        .task-section {
            margin-bottom: 25px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 9px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;

            font-size: 12px;
            font-weight: 700;
            color: var(--text);
        }

        .section-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;
            background: var(--border2);
        }

        .section-count {
            color: var(--muted);
            font-size: 10px;
            font-weight: 500;
        }

        .section-actions {
            display: flex;
            gap: 5px;
        }

        .section-action {
            font-size: 11px;
            color: var(--muted);
            background: transparent;
            padding: 4px 6px;
            border-radius: 6px;
        }

        .section-action:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        /* =========================================================
           TASK LIST
        ========================================================= */

        .task-list {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 12px;

            overflow: hidden;
        }

        .task-row {
            min-height: 55px;

            display: flex;
            align-items: center;

            gap: 10px;

            padding: 8px 13px;

            border-bottom: 1px solid var(--border-light);

            cursor: pointer;

            transition: background .12s ease;
        }

        .task-row:last-child {
            border-bottom: 0;
        }

        .task-row:hover {
            background: var(--surface-soft);
        }

        .task-row.selected {
            background: var(--surface-soft);
        }

        .task-check {
            width: 19px;
            height: 19px;

            flex-shrink: 0;

            border: 1px solid var(--border2);
            border-radius: 6px;

            background: var(--surface);

            display: grid;
            place-items: center;

            transition: .15s ease;
        }

        .task-check:hover {
            border-color: var(--text);
        }

        .task-row.completed .task-check {
            background: var(--text);
            border-color: var(--text);
            color: white;
        }

        .task-check svg {
            width: 12px;
            height: 12px;
        }

        .priority-dot {
            width: 7px;
            height: 7px;

            flex-shrink: 0;

            border-radius: 50%;
        }

        .priority-low {
            background: #A8A29E;
        }

        .priority-medium {
            background: #78716C;
        }

        .priority-high {
            background: #57534E;
        }

        .priority-urgent {
            background: #1C1917;
        }

        .task-main {
            min-width: 0;
            flex: 1;
        }

        .task-title {
            font-size: 12px;
            font-weight: 500;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .task-row.completed .task-title {
            color: var(--muted);
            text-decoration: line-through;
        }

        .task-meta {
            display: flex;
            align-items: center;
            gap: 8px;

            margin-top: 3px;

            font-size: 10px;
            color: var(--muted);
        }

        .task-meta-item {
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .task-more {
            width: 28px;
            height: 28px;

            display: grid;
            place-items: center;

            border-radius: 7px;

            color: var(--muted);
            background: transparent;

            opacity: 0;
        }

        .task-row:hover .task-more {
            opacity: 1;
        }

        .task-more:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        /* =========================================================
           EMPTY
        ========================================================= */

        .empty {
            padding: 55px 20px;

            display: flex;
            flex-direction: column;
            align-items: center;

            text-align: center;
        }

        .empty-icon {
            width: 48px;
            height: 48px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background: var(--surface-soft);

            color: var(--muted);

            font-size: 20px;

            margin-bottom: 13px;
        }

        .empty-title {
            font-size: 14px;
            font-weight: 700;
        }

        .empty-text {
            max-width: 300px;

            margin-top: 5px;

            color: var(--muted);
            font-size: 11px;
            line-height: 1.7;
        }

        /* =========================================================
           UPCOMING / OTHER VIEWS
        ========================================================= */

        .date-group {
            margin-bottom: 24px;
        }

        .date-group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 8px;
        }

        .date-group-title {
            font-size: 12px;
            font-weight: 700;
        }

        .date-group-title span {
            color: var(--muted);
            font-weight: 500;
            margin-right: 5px;
        }

        .date-group-count {
            font-size: 10px;
            color: var(--muted);
        }

        /* =========================================================
           BOARD
        ========================================================= */

        .board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 13px;

            align-items: start;
        }

        .board-column {
            background: var(--surface-soft);

            border: 1px solid var(--border);

            border-radius: 14px;

            padding: 10px;

            min-height: 250px;
        }

        .board-column-header {
