        .board-card {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 10px;

            padding: 10px;

            cursor: pointer;

            transition: .15s ease;
        }

        .board-card:hover {
            box-shadow: 0 1px 2px rgba(0,0,0,.04);
        }

        .board-card-title {
            font-size: 12px;
            font-weight: 500;
            line-height: 1.4;

            margin-bottom: 9px;
        }

        .board-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            color: var(--muted);

            font-size: 10px;
        }

        /* =========================================================
           EISENHOWER
        ========================================================= */

        .matrix {
            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 12px;
        }

        .matrix-box {
            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 14px;

            padding: 13px;

            min-height: 220px;
        }

        .matrix-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 11px;
        }

        .matrix-title {
            display: flex;
            align-items: center;
            gap: 7px;

            font-size: 12px;
            font-weight: 700;
        }

        .matrix-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .matrix-subtitle {
            color: var(--muted);
            font-size: 10px;
        }

        .matrix-tasks {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .matrix-task {
            padding: 9px 10px;

            border: 1px solid var(--border-light);

            border-radius: 8px;

            font-size: 11px;

            cursor: pointer;
        }

        .matrix-task:hover {
            background: var(--surface-soft);
        }

        /* =========================================================
           DETAILS SIDEBAR
        ========================================================= */

        .details {
            width: var(--details-width);

            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;

            background: white;

            border-right: 1px solid var(--border);

            z-index: 60;

            transform: translateX(-100%);
            transition: transform .22s ease;

            display: flex;
            flex-direction: column;
        }

        .details.open {
            transform: translateX(0);
        }

        .details-header {
            height: 72px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 18px;

            border-bottom: 1px solid var(--border);
        }

        .details-header-title {
            font-size: 13px;
            font-weight: 700;
        }

        .details-header-actions {
            display: flex;
            gap: 4px;
        }

        .details-body {
            flex: 1;
            overflow-y: auto;

            padding: 20px;
        }

        .details-title {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.5;

            margin-bottom: 20px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field-label {
            display: block;

            font-size: 10px;
            color: var(--muted);

            font-weight: 700;

            margin-bottom: 7px;
        }

        .field-input,
        .field-select,
        .field-textarea {
            width: 100%;

            border: 1px solid var(--border);

            background: var(--bg);

            border-radius: 10px;

            padding: 8px 10px;

            color: var(--text);

            font-size: 12px;
        }

        .field-input:focus,
        .field-select:focus,
        .field-textarea:focus {
            background: var(--surface);
            border-color: var(--text);
        }

        .field-textarea {
            min-height: 100px;
            resize: vertical;

            line-height: 1.7;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .status-btn {
            width: 100%;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;

            padding: 10px;

            border: 1px solid var(--border);

            border-radius: 10px;

            background: var(--surface);

            font-size: 11px;
            font-weight: 700;

            color: var(--text-soft);
        }

        .status-btn.completed {
            background: var(--text);
            border-color: var(--text);
            color: #fff;
        }

        .details-footer {
            border-top: 1px solid var(--border);

            padding: 13px 18px;

            display: flex;
            gap: 8px;
        }

        .save-btn {
            flex: 1;

            height: 32px;

            border-radius: 10px;

            background: var(--text);
            color: white;

            font-size: 12px;
            font-weight: 500;
        }

        .save-btn:hover {
            opacity: .9;
        }

        .delete-btn {
            width: 40px;
            height: 32px;

            border-radius: 10px;

            background: var(--red-soft);
            color: var(--red);
        }

        .archive-btn {
            width: 40px;
            height: 32px;

            border-radius: 10px;

            background: var(--surface-soft);
            color: var(--text-soft);
        }

        /* =========================================================
           MODAL
        ========================================================= */

        .modal-overlay {
            position: fixed;
            inset: 0;

            background: rgba(28,25,23,.45);

            display: none;
            align-items: center;
            justify-content: center;

            z-index: 100;

            padding: 20px;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal {
            width: 100%;
            max-width: 450px;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 16px;

            box-shadow: 0 20px 40px rgba(0,0,0,.06);

            overflow: hidden;
        }

        .modal-header {
            padding: 16px 16px 10px;

            border-bottom: 1px solid var(--border);

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 13px;
            font-weight: 700;
        }

        .modal-body {
            padding: 16px;
        }

        .modal-footer {
            padding: 13px 16px;

            border-top: 1px solid var(--border);

            display: flex;
            justify-content: flex-start;
            gap: 6px;
        }

        .secondary-btn {
            height: 32px;

            padding: 0 12px;

            border: 1px solid var(--border);

            background: var(--surface);

            border-radius: 10px;

            color: var(--text);

            font-size: 12px;
            font-weight: 500;
        }

        .secondary-btn:hover {
            background: var(--surface-soft);
        }

        /* =========================================================
           CONTEXT MENU
        ========================================================= */

        .context-menu {
            position: fixed;

            min-width: 155px;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 10px;

            box-shadow: 0 8px 24px rgba(0,0,0,.1);

            padding: 5px;

            z-index: 200;

            display: none;
        }

        .context-menu.open {
            display: block;
        }

        .context-item {
            width: 100%;

            display: flex;
            align-items: center;
            gap: 8px;

            padding: 8px 9px;

            border-radius: 6px;

            background: transparent;

            color: var(--text-soft);

            font-size: 11px;

            text-align: right;
        }

        .context-item:hover {
            background: var(--surface-soft);
            color: var(--text);
        }

        .context-item.danger {
            color: var(--red);
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1000px) {
            :root {
                --sidebar-width: 220px;
            }

            .board {
                grid-template-columns: 1fr;
            }

            .day-progress {
                display: none;
            }
        }

        @@media (max-width: 760px) {
            .sidebar {
                width: 62px;
                padding: 15px 8px;
            }

            .sidebar .nav-squares {
                grid-template-columns: 1fr;
            }

            .sidebar .today-card {
                display: none;
            }

            .nav-label,
            .nav-item span:not(.nav-icon),
            .nav-count {
                display: none;
            }

            .sidebar-top {
                justify-content: center;
            }

            .nav-item {
                justify-content: center;
                padding: 11px;
            }

            .main {
                margin-right: 62px;
                width: calc(100% - 62px);
            }

            .main.sidebar-collapsed {
                margin-right: 62px;
                width: calc(100% - 62px);
            }

            .topbar {
                padding: 0 15px;
            }

            .topbar-title h1 {
                display: none;
            }

            .view-switcher {
                margin-right: 0;
            }

            .content {
                padding: 20px 15px 50px;
            }

            .day-header {
                align-items: flex-start;
            }

            .date-block {
                min-width: 0;
            }

            .date-title {
                font-size: 17px;
            }

            .matrix {
                grid-template-columns: 1fr;
            }

            .details {
                width: min(350px, 90vw);
            }

            .main.details-open {
                margin-left: 0;
            }
        }

        @@media (max-width: 500px) {
            .view-btn {
                padding: 7px 8px;
                font-size: 10px;
            }

            .primary-btn span {
                display: none;
            }

            .day-header {
                gap: 10px;
            }

            .day-nav {
                order: 2;
            }

            .day-info {
                gap: 6px;
            }

            .today-btn {
                display: none;
            }

            .task-meta-item.hide-mobile {
                display: none;
            }
        }

        /* =========================================================
           SCROLLBAR
        ========================================================= */

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 4px;
        }

        /* =========================================================
           UTILITY
        ========================================================= */

        .hidden {
            display: none !important;
        }

        .text-green {
            color: var(--green);
        }

        .text-muted {
            color: var(--muted);
        }
    
</style>


@code {
    private string _view = "today";
    private string _layout = "list"; // kept for parity with tasks-page.html (board/matrix as views, not layout)
    private DateTime _currentDate = DateTime.Today;
    private AppTask? _selectedTask;
    private bool _sidebarCollapsed;
    private bool _showCreateModal;
    private string? _contextTaskId;
    private double _contextX, _contextY;

    private string _quickTitle = "";
    private string _newTitle = "";
    private string? _newDate;
    private string? _newTime;
    private string _newPriority = "medium";
    private string _newRepeat = "none";
    private string _newNotes = "";
    private bool _showSchedule = false;

    private string _editTitle = "";
    private string? _editDate;
    private string? _editTime;
    private string _editPriority = "medium";
    private string _editRepeat = "none";
    private int _editQuadrant = 2;
    private string _editNotes = "";

    private System.Threading.Timer? _clockTimer;
    private string _currentDateStr = "";
    private string _currentTimeStr = "";
    private string _currentSubStr = "";

    private int _todayCount, _upcomingCount, _noDateCount, _completedCount, _archivedCount;
    private int _dayTotal, _dayCompleted, _dayPercent;

    private string PageTitle => _view switch {
        "today" => "اليوم",
        "upcoming" => "القادمة",
        "no-date" => "بدون تاريخ",
        "completed" => "تم الإنجاز",
        "archived" => "الأرشيف",
        "board" => "Board",
        "matrix" => "Eisenhower",
        _ => "Tasks"
    };

    protected override async Task OnInitializedAsync()
    {
        await TaskState.InitAsync();
        TaskState.OnStateChanged += OnStateChanged;
        _view = TaskState.CurrentView;
        _currentDate = TaskState.CurrentDate;
        _sidebarCollapsed = TaskState.SidebarCollapsed;
        UpdateCounts();
        StartClock();
    }

    private void OnStateChanged()
    {
        _view = TaskState.CurrentView;
        _currentDate = TaskState.CurrentDate;
        _sidebarCollapsed = TaskState.SidebarCollapsed;
        UpdateCounts();
        InvokeAsync(StateHasChanged);
    }

    private void StartClock()
    {
        UpdateClock();
        _clockTimer = new System.Threading.Timer(_ => {
            InvokeAsync(() => { UpdateClock(); StateHasChanged(); });
        }, null, 0, 1000);
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        var ar = new System.Globalization.CultureInfo("ar-EG");
        _currentDateStr = now.ToString("dddd، d MMMM yyyy", ar);
        _currentTimeStr = now.ToString("hh:mm:ss tt", ar);
        _currentSubStr = now.ToString("ddd", ar) + " • " + now.ToString("yyyy-MM-dd");
    }

    private void UpdateCounts()
    {
        _ = _layout;
        var tasks = TaskState.Tasks;
        var today = DateTime.Today;
        var active = tasks.Where(t => t.ArchivedAt == null).ToList();
        _todayCount = active.Count(t => t.DueDate?.Date == today && !t.IsDone);
        // For badge today we count pending today only (like HTML)
        var todayTasks = active.Where(t => t.DueDate?.Date == today || t.ScheduledDate?.Date == today).ToList();
        // upcoming: dueDate > today and not done
        _upcomingCount = active.Count(t => {
            var d = t.DueDate ?? t.ScheduledDate;
            return d.HasValue && d.Value.Date > today && !t.IsDone;
        });
        _noDateCount = active.Count(t => (t.DueDate==null && t.ScheduledDate==null) && !t.IsDone);
        _completedCount = active.Count(t => t.IsDone);
        _archivedCount = tasks.Count(t => t.ArchivedAt!=null);

        var dayTasks = active.Where(t => (t.DueDate?.Date==_currentDate.Date) || (t.ScheduledDate?.Date==_currentDate.Date)).ToList();
        _dayTotal = dayTasks.Count;
        _dayCompleted = dayTasks.Count(t=>t.IsDone);
        _dayPercent = _dayTotal==0?0:(int)Math.Round((double)_dayCompleted/_dayTotal*100);
    }

    private void ToggleSidebar(){ TaskState.ToggleSidebar(); }
    private void SetView(string v){
        TaskState.SetView(v);
        // close details when switching views maybe
        if(v!="today" && _selectedTask!=null) {}
    }
    private void PrevDay(){ TaskState.PrevDay(); }
    private void NextDay(){ TaskState.NextDay(); }
    private void GoToday(){ TaskState.GoToday(); }
    private void OnDatePicked(ChangeEventArgs e){
        if(DateTime.TryParse(e.Value?.ToString(), out var d)) TaskState.SetCurrentDate(d);
    }

    private List<AppTask> ActiveTasks() => TaskState.Tasks.Where(t=>t.ArchivedAt==null).ToList();

    private List<AppTask> TasksForDate(DateTime date)
    {
        var d = date.Date;
        return ActiveTasks().Where(t => (t.DueDate?.Date==d) || (t.ScheduledDate?.Date==d)).OrderBy(t=>t.IsDone).ThenBy(t=> PriorityOrder(t.Priority)).ThenBy(t=> t.ScheduledTime ?? TimeSpan.MaxValue).ThenBy(t=>t.CreatedAt).ToList();
    }
    private int PriorityOrder(string p) => p switch { "urgent"=>0, "high"=>1, "medium"=>2, _=>3 };

    private async Task QuickAdd()
    {
        var title = _quickTitle.Trim();
        if(string.IsNullOrWhiteSpace(title)) return;
        var task = new AppTask{
            Id = Guid.NewGuid().ToString(),
            Title = title,
            Priority = "medium",
            IsDone = false,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            DueDate = _view=="today" ? _currentDate.Date : null,
            ScheduledDate = _view=="today" ? _currentDate.Date : null,
            RecurrenceDays = "none",
            EisenhowerQuadrant = 2,
            Notes = ""
        };
        await TaskState.AddTaskAsync(task);
        _quickTitle="";
        UpdateCounts();
    }

    private async Task OnQuickKeyDown(KeyboardEventArgs e){
        if(e.Key=="Enter") await QuickAdd();
    }

    private void OpenCreateModal(){
        _newTitle="";
        _newDate = _currentDate.ToString("yyyy-MM-dd");
        _newTime=null;
        _newPriority="medium";
        _newRepeat="none";
        _newNotes="";
        _showSchedule=false;
        _showCreateModal=true;
    }
    private void CloseCreateModal()=> _showCreateModal=false;

    private async Task CreateTask(){
        var title=_newTitle.Trim();
        if(string.IsNullOrWhiteSpace(title)) return;
        TimeSpan? ts = null;
        DateTime? due = null;
        if(_showSchedule){
            if(!string.IsNullOrWhiteSpace(_newTime) && TimeSpan.TryParse(_newTime, out var parsed)) ts=parsed;
            if(!string.IsNullOrWhiteSpace(_newDate) && DateTime.TryParse(_newDate, out var d)) due = d.Date;
            else due = DateTime.Today;
        } else {
            due = DateTime.Today;
            ts = null;
        }
        var newId = Guid.NewGuid().ToString();
        var isRec = _newRepeat!="none";
        var task=new AppTask{
            Id=newId,
            Title=title,
            Priority=_newPriority,
            IsDone=false,
            CreatedAt=DateTime.UtcNow,
            UpdatedAt=DateTime.UtcNow,
            DueDate=due,
            ScheduledDate=due,
            ScheduledTime=ts,
            RecurrenceDays=_newRepeat,
            IsRecurring=isRec,
            EisenhowerQuadrant=2,
            Notes=_newNotes?.Trim()??"",
            TemplateId = isRec ? newId : null
        };
        await TaskState.AddTaskAsync(task);
        _showCreateModal=false;
        UpdateCounts();
    }

    private void OpenDetails(string id){
        if(_selectedTask?.Id==id){ CloseDetails(); return; }
        var task=TaskState.Tasks.FirstOrDefault(x=>x.Id==id);
        if(task==null) return;
        _selectedTask=task;
        TaskState.SetSelectedTask(id);
        _editTitle=task.Title;
        _editDate=(task.DueDate ?? task.ScheduledDate)?.ToString("yyyy-MM-dd");
        _editTime=task.ScheduledTime?.ToString(@"hh\:mm");
        _editPriority=task.Priority ?? "medium";
        _editRepeat=string.IsNullOrWhiteSpace(task.RecurrenceDays)?"none":task.RecurrenceDays;
        _editQuadrant=task.EisenhowerQuadrant;
        _editNotes=task.Notes ?? "";
    }
    private void CloseDetails(){ _selectedTask=null; TaskState.SetSelectedTask(null); }

    private async Task SaveSelected(){
        if(_selectedTask==null) return;
        if(string.IsNullOrWhiteSpace(_editTitle)) return;
        _selectedTask.Title=_editTitle.Trim();
        DateTime? due = null;
        if(!string.IsNullOrWhiteSpace(_editDate) && DateTime.TryParse(_editDate, out var d)) due = d.Date;
        _selectedTask.DueDate=due;
        _selectedTask.ScheduledDate=due;
        if(!string.IsNullOrWhiteSpace(_editTime) && TimeSpan.TryParse(_editTime, out var ts)) _selectedTask.ScheduledTime=ts; else _selectedTask.ScheduledTime=null;
        _selectedTask.Priority=_editPriority;
        _selectedTask.RecurrenceDays=_editRepeat;
        _selectedTask.IsRecurring=_editRepeat!="none";
        _selectedTask.EisenhowerQuadrant=_editQuadrant;
        _selectedTask.Notes=_editNotes?.Trim()??"";
        await TaskState.UpdateTaskAsync(_selectedTask);
        UpdateCounts();
    }

    private async Task ToggleTask(AppTask task){ await TaskState.ToggleTaskAsync(task); UpdateCounts(); }
    private async Task ArchiveSelected(){ if(_selectedTask==null) return; await TaskState.ArchiveTaskAsync(_selectedTask.Id); CloseDetails(); UpdateCounts(); }
    private async Task DeleteSelected(){ if(_selectedTask==null) return; await TaskState.DeleteTaskAsync(_selectedTask.Id); CloseDetails(); UpdateCounts(); }
    private async Task CompleteAllVisible(){
        var tasks=TasksForDate(_currentDate).Where(t=>!t.IsDone).ToList();
        foreach(var t in tasks) await TaskState.ToggleTaskAsync(t);
        UpdateCounts();
    }

    // Context menu
    private void ShowContext(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, string id){
        _contextTaskId=id;
        _contextX=e.ClientX;
        _contextY=e.ClientY;
    }
    private void CloseContext()=> _contextTaskId=null;
    private async Task ContextComplete(){ if(_contextTaskId==null) return; var id=_contextTaskId; CloseContext(); await TaskState.ToggleTaskByIdAsync(id); UpdateCounts(); }
    private void ContextEdit(){ if(_contextTaskId==null) return; var id=_contextTaskId; CloseContext(); OpenDetails(id); }
    private async Task ContextArchive(){ if(_contextTaskId==null) return; var id=_contextTaskId; CloseContext(); await TaskState.ArchiveTaskAsync(id); UpdateCounts(); }
    private async Task ContextDelete(){ if(_contextTaskId==null) return; var id=_contextTaskId; CloseContext(); await TaskState.DeleteTaskAsync(id); if(_selectedTask?.Id==id) CloseDetails(); UpdateCounts(); }

    private string FormatDate(DateTime d) => d.ToString("dddd، d MMMM", new System.Globalization.CultureInfo("ar-EG"));
    private string FormatShortDate(DateTime? d) => d==null?"": d.Value.ToString("d MMM", new System.Globalization.CultureInfo("ar-EG"));
    private string FormatDateTime(DateTime d) => d.ToString("d MMM hh:mm tt", new System.Globalization.CultureInfo("ar-EG"));
    private string PriorityLabel(string p) => p switch{ "low"=>"منخفضة","medium"=>"متوسطة","high"=>"عالية","urgent"=>"عاجلة", _=>"متوسطة"};
    private string RepeatLabel(string r) => r switch{ "daily"=>"يومي","weekly"=>"أسبوعي","monthly"=>"شهري", _=>""};

    private RenderFragment DayListView => @<text>
        @{
            var tasks = TasksForDate(_currentDate);
            var pending = tasks.Where(t=>!t.IsDone).ToList();
            var completed = tasks.Where(t=>t.IsDone).ToList();
        }
        @if(!tasks.Any()){
            <div class="task-list"><div class="empty"><div class="empty-icon">✓</div><div class="empty-title">لا توجد مهام لهذا اليوم</div><div class="empty-text">ابدأ بإضافة أول مهمة ليومك.</div></div></div>
        } else {
            <section class="task-section">
                <div class="section-header"><div class="section-title"><span class="section-dot"></span><span>المهام</span><span class="section-count">@pending.Count</span></div><div class="section-actions"><button class="section-action" @onclick="CompleteAllVisible">إنهاء الكل</button></div></div>
                <div class="task-list">
                    @if(pending.Any()){
                        @foreach(var task in pending){ @TaskRow(task) }
                    } else {
                        <div class="empty" style="padding:35px"><div class="empty-text">لا توجد مهام هنا</div></div>
                    }
                </div>
            </section>
            @if(completed.Any()){
                <section class="task-section">
                    <div class="section-header"><div class="section-title"><span class="section-dot" style="background:var(--text)"></span><span>تم الإنجاز</span><span class="section-count">@completed.Count</span></div></div>
                    <div class="task-list">@foreach(var task in completed){ @TaskRow(task) }</div>
                </section>
            }
        }
    </text>;

    private RenderFragment TaskRow(AppTask task) => @<text>
        <div class="task-row @(task.IsDone?"completed":"") @(_selectedTask?.Id==task.Id?"selected":"")" @onclick="()=>OpenDetails(task.Id)" @oncontextmenu="(e)=>ShowContext(e, task.Id)" @oncontextmenu:preventDefault="true">
            <button class="task-check" @onclick="async (e)=>{ await ToggleTask(task); }" @onclick:stopPropagation="true" title="تغيير الحالة">
                @if(task.IsDone){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg>}
            </button>
            <span class="priority-dot priority-@(task.Priority ?? "low")"></span>
            <div class="task-main">
                <div class="task-title">@task.Title</div>
                <div class="task-meta">
                    @if(task.ScheduledTime!=null){<span class="task-meta-item">◷ @task.ScheduledTime?.ToString(@"hh\:mm")</span>}
                    @if(task.DueDate!=null && task.DueDate?.Date != _currentDate.Date){<span class="task-meta-item">▣ @FormatShortDate(task.DueDate)</span>}
                    @if(!string.IsNullOrWhiteSpace(task.RecurrenceDays) && task.RecurrenceDays!="none"){<span class="task-meta-item">↻ @RepeatLabel(task.RecurrenceDays)</span>}
                    @if(!string.IsNullOrWhiteSpace(task.Notes)){<span class="task-meta-item">▤ ملاحظات</span>}
                </div>
            </div>
            <button class="task-more" @onclick="(e)=>ShowContext(e, task.Id)" @onclick:stopPropagation="true">⋮</button>
        </div>
    </text>;

    private RenderFragment UpcomingView => @<text>
        @{
            var today=DateTime.Today;
            var tasks=ActiveTasks().Where(t=>{ var d=t.DueDate??t.ScheduledDate; return d.HasValue && d.Value.Date>today && !t.IsDone;}).OrderBy(t=>t.DueDate??t.ScheduledDate).ToList();
            var groups=tasks.GroupBy(t=>(t.DueDate??t.ScheduledDate)!.Value.Date).OrderBy(g=>g.Key).ToList();
        }
        @if(!tasks.Any()){
            <div class="task-list"><div class="empty"><div class="empty-icon">✓</div><div class="empty-title">مفيش مهام قادمة</div><div class="empty-text">أي مهمة تضيف لها تاريخ مستقبلي هتظهر هنا.</div></div></div>
        } else {
            @foreach(var g in groups){
                <section class="date-group">
                    <div class="date-group-header"><div class="date-group-title">@FormatDate(g.Key) <span>@(g.Key==today.AddDays(1)?"غدًا":"")</span></div><div class="date-group-count">@g.Count() مهام</div></div>
                    <div class="task-list">@foreach(var task in g){ @TaskRow(task) }</div>
                </section>
            }
        }
    </text>;

    private RenderFragment NoDateView => @<text>
        @{
            var tasks=ActiveTasks().Where(t=>t.DueDate==null && t.ScheduledDate==null).OrderBy(t=>PriorityOrder(t.Priority)).ThenBy(t=>t.CreatedAt).ToList();
        }
        @if(!tasks.Any()){
            <div class="task-list"><div class="empty"><div class="empty-icon">✓</div><div class="empty-title">كل مهامك لها تاريخ</div><div class="empty-text">ممتاز. مفيش مهام معلقة بدون موعد.</div></div></div>
        } else {
            <section class="task-section">
                <div class="section-header"><div class="section-title"><span class="section-dot"></span>بدون تاريخ<span class="section-count">@tasks.Count</span></div></div>
                <div class="task-list">@foreach(var task in tasks){ @TaskRow(task) }</div>
            </section>
        }
    </text>;

    private RenderFragment CompletedView => @<text>
        @{
            var tasks=ActiveTasks().Where(t=>t.IsDone).OrderByDescending(t=>t.CompletedAt ?? t.UpdatedAt).ToList();
        }
        @if(!tasks.Any()){
            <div class="task-list"><div class="empty"><div class="empty-icon">✓</div><div class="empty-title">لسه مفيش إنجازات</div><div class="empty-text">المهام اللي هتخلصها هتظهر هنا كـ History.</div></div></div>
        } else {
            <section class="task-section">
                <div class="section-header"><div class="section-title"><span class="section-dot" style="background:var(--text)"></span>كل الإنجازات<span class="section-count">@tasks.Count</span></div></div>
                <div class="task-list">@foreach(var task in tasks){ @TaskRow(task) }</div>
            </section>
        }
    </text>;

    private RenderFragment ArchivedView => @<text>
        @{
            var tasks=TaskState.Tasks.Where(t=>t.ArchivedAt!=null).OrderByDescending(t=>t.ArchivedAt).ToList();
        }
        @if(!tasks.Any()){
            <div class="task-list"><div class="empty"><div class="empty-icon">✓</div><div class="empty-title">الأرشيف فاضي</div><div class="empty-text">المهام اللي مش عايزها في الـ workspace الرئيسي تقدر تأرشفها هنا.</div></div></div>
        } else {
            <section class="task-section">
                <div class="section-header"><div class="section-title"><span class="section-dot" style="background:var(--muted)"></span>الأرشيف<span class="section-count">@tasks.Count</span></div><button class="section-action" @onclick="async ()=>{ foreach(var t in tasks) await TaskState.RestoreTaskAsync(t.Id); UpdateCounts(); }">استرجاع الكل</button></div>
                <div class="task-list">@foreach(var task in tasks){ @TaskRow(task) }</div>
            </section>
        }
    </text>;

    private RenderFragment BoardView => @<text>
        @{
            var active=ActiveTasks();
            var todo=active.Where(t=>!t.IsDone && (t.DueDate!=null||t.ScheduledDate!=null)).ToList();
            var noDate=active.Where(t=>!t.IsDone && t.DueDate==null && t.ScheduledDate==null).ToList();
            var done=active.Where(t=>t.IsDone).ToList();
        }
        <div class="board">
            <div class="board-column">
                <div class="board-column-header"><div class="board-column-title">قيد التنفيذ</div><div class="board-column-count">@todo.Count</div></div>
                <div class="board-list">
                    @if(todo.Any()){ @foreach(var task in todo){ <div class="board-card" @onclick="()=>OpenDetails(task.Id)"><div class="board-card-title">@task.Title</div><div class="board-card-footer"><span>@(task.DueDate!=null?FormatShortDate(task.DueDate):"بدون تاريخ")</span><span>@PriorityLabel(task.Priority)</span></div></div> } } else { <div style="padding:30px 10px;text-align:center;color:var(--muted);font-size:10px;">فاضي</div> }
                </div>
            </div>
            <div class="board-column">
                <div class="board-column-header"><div class="board-column-title">بدون تاريخ</div><div class="board-column-count">@noDate.Count</div></div>
                <div class="board-list">
                    @if(noDate.Any()){ @foreach(var task in noDate){ <div class="board-card" @onclick="()=>OpenDetails(task.Id)"><div class="board-card-title">@task.Title</div><div class="board-card-footer"><span>بدون تاريخ</span><span>@PriorityLabel(task.Priority)</span></div></div> } } else { <div style="padding:30px 10px;text-align:center;color:var(--muted);font-size:10px;">فاضي</div> }
                </div>
            </div>
            <div class="board-column">
                <div class="board-column-header"><div class="board-column-title">تم الإنجاز</div><div class="board-column-count">@done.Count</div></div>
                <div class="board-list">
                    @if(done.Any()){ @foreach(var task in done){ <div class="board-card" @onclick="()=>OpenDetails(task.Id)"><div class="board-card-title">@task.Title</div><div class="board-card-footer"><span>@(task.DueDate!=null?FormatShortDate(task.DueDate):"بدون تاريخ")</span><span>@PriorityLabel(task.Priority)</span></div></div> } } else { <div style="padding:30px 10px;text-align:center;color:var(--muted);font-size:10px;">فاضي</div> }
                </div>
            </div>
        </div>
    </text>;

    private RenderFragment MatrixView => @<text>
        @{
            var tasks=ActiveTasks().Where(t=>!t.IsDone).ToList();
            var quadrants = new[] {
                new { id=1, title="مهم وعاجل", sub="اعمله الآن", dot="var(--text)"},
                new { id=2, title="مهم وغير عاجل", sub="خطط له", dot="var(--text-soft)"},
                new { id=3, title="غير مهم وعاجل", sub="فوّضه", dot="var(--muted)"},
                new { id=4, title="غير مهم وغير عاجل", sub="احذفه أو أجّله", dot="var(--border2)"}
            };
        }
        <div class="matrix">
            @foreach(var q in quadrants){
                var qTasks=tasks.Where(t=> (t.EisenhowerQuadrant==q.id)).ToList();
                <div class="matrix-box">
                    <div class="matrix-header"><div class="matrix-title"><span class="matrix-dot" style="background:@q.dot"></span>@q.title</div><div class="matrix-subtitle">@q.sub</div></div>
                    <div class="matrix-tasks">
                        @if(qTasks.Any()){
                            @foreach(var task in qTasks){ <div class="matrix-task" @onclick="()=>OpenDetails(task.Id)">@task.Title</div> }
                        } else {
                            <div style="color:var(--muted);font-size:10px;padding:20px 5px;text-align:center;">لا توجد مهام</div>
                        }
                    </div>
                </div>
            }
        </div>
    </text>;

    public void Dispose()
    {
        TaskState.OnStateChanged -= OnStateChanged;
        _clockTimer?.Dispose();
    }
}
