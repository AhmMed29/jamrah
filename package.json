{
  "name": "jamrah",
  "version": "1.3.3",
  "description": "Jamrah جَــمْــرَه — ember of productivity. Pomodoro timer, habits tracker & more",
  "main": "main.js",
  "author": "AhmMed29",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "build:backend": "dotnet publish backend -c Release -r win-x64 --self-contained true -o backend/publish",
    "build": "npm run build:backend && electron-builder",
    "dist": "npm run build:backend && electron-builder --win"
  },
  "build": {
    "appId": "com.ahmmed.jamrah",
    "productName": "Jamrah",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "Jamrah-Icon.png",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/publish",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/Jamrah-Icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AhmMed29",
      "repo": "jamrah"
    }
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
