{
  "name": "jamrah",
  "version": "3.1.0",
  "description": "Jamrah جَــمْــرَه — ember of productivity. Pomodoro timer, habits tracker & more",
  "main": "main.js",
  "author": "AhmMed29",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "postinstall": "npx @electron/rebuild",
    "start": "electron .",
    "test": "npx jest --config jest.config.js --verbose",
    "test:unit": "npx jest --config jest.config.js --verbose",
    "test:ipc": "npx jest --config tests/ipc/jest.config.ipc.js --verbose",
    "test:backend": "dotnet test backend/Tests/Jamrah.Backend.Tests.csproj --verbosity normal",
    "test:all": "npx jest --config jest.config.js --verbose && npx jest --config tests/ipc/jest.config.ipc.js --verbose && dotnet test backend/Tests/Jamrah.Backend.Tests.csproj --verbosity normal",
    "prebuild": "dotnet publish backend/Jamrah.Backend.csproj -c Release -o backend/publish --self-contained -r win-x64",
    "build": "electron-builder",
    "dist": "electron-builder --win",
    "postdist": "node scripts/prepare-frontend.js"
  },
  "build": {
    "appId": "com.ahmmed.jamrah",
    "productName": "Jamrah",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "database.js",
      "Jamrah-Icon.png",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/publish",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/Jamrah-Icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AhmMed29",
      "repo": "jamrah"
    }
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "nock": "^14.0.16",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.3.9"
  }
}
